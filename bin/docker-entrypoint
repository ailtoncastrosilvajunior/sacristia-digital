#!/bin/bash
# Sacristia Digital - Docker Entrypoint
# Executa migrações e inicia a aplicação

set -e

export RAILS_ENV="${RAILS_ENV:-production}"
export RACK_ENV="${RACK_ENV:-production}"

echo "==> Sacristia Digital - Iniciando (RAILS_ENV=$RAILS_ENV)..."

if [ "$RAILS_ENV" = "production" ] && [ -z "${SECRET_KEY_BASE:-}" ]; then
  echo "ERRO: defina SECRET_KEY_BASE nas variáveis do app (bin/rails secret). Ver README — Deploy."
  exit 1
fi

# libpq: PGSSLMODE tem precedência sobre sslmode na URL/database.yml.
# Padrão disable: contorna "SSL error: dh key too small" (OpenSSL 3 + PostgreSQL antigo na DO).
# Para exigir SSL: defina DATABASE_SSLMODE=require (ou PGSSLMODE) no painel, com cluster atualizado.
export PGSSLMODE="${DATABASE_SSLMODE:-${PGSSLMODE:-disable}}"

# Aguardar PostgreSQL
if [ -n "${DATABASE_URL:-}" ]; then
  echo "==> Aguardando PostgreSQL (DATABASE_URL)..."
  until pg_isready -d "$DATABASE_URL" -q 2>/dev/null; do
    sleep 2
  done
  echo "==> PostgreSQL disponível!"
elif [ -n "${DATABASE_HOST:-}" ]; then
  echo "==> Aguardando PostgreSQL em $DATABASE_HOST..."
  while ! pg_isready -h "$DATABASE_HOST" -U "${DATABASE_USERNAME:-postgres}" -q 2>/dev/null; do
    sleep 2
  done
  echo "==> PostgreSQL disponível!"
fi

echo "==> Executando migrações..."
# Com DATABASE_URL (App Platform / PG gerenciado): só migrate — db:create falha e derruba o container.
if [ "$RAILS_ENV" = "production" ] || [ -n "${DATABASE_URL:-}" ]; then
  bundle exec rails db:migrate
else
  bundle exec rails db:migrate 2>/dev/null || bundle exec rails db:create db:migrate
fi

echo "==> Compilando Tailwind CSS..."
bundle exec rails tailwindcss:build 2>/dev/null || true

if [ "$RAILS_ENV" = "development" ] && [ "${RUN_SEEDS:-false}" = "true" ]; then
  echo "==> Executando seeds..."
  bundle exec rails db:seed
fi

echo "==> Iniciando servidor Rails..."
exec bundle exec rails server -b 0.0.0.0
