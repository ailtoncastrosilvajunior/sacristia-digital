<% campo = "w-full px-4 py-3 rounded-xl border border-stone-200/90 bg-stone-50/40 text-stone-900 placeholder:text-stone-400 text-[15px] shadow-inner shadow-stone-900/5 focus:outline-none focus:ring-2 focus:ring-sky-500/25 focus:border-sky-400/80 focus:bg-white transition-all" %>
<% rotulo = "block text-xs font-semibold uppercase tracking-wider text-stone-500 mb-1" %>
<% content_for :title, "Minha conta — Sacristia Digital" %>
<% nome_exibicao = resource.nome.presence || resource.email %>

<div class="min-h-screen bg-stone-100/80 px-4 py-8 sm:py-12">
  <div class="max-w-md mx-auto space-y-5">
    <header class="flex items-center gap-4">
      <span class="flex h-14 w-14 shrink-0 items-center justify-center rounded-2xl bg-sky-600 text-xl font-bold text-white shadow-md shadow-sky-900/15" aria-hidden="true">
        <%= nome_exibicao.to_s.strip.first.to_s.upcase %>
      </span>
      <div class="min-w-0">
        <h1 class="text-xl font-bold text-stone-900 tracking-tight">Minha conta</h1>
        <p class="truncate text-sm text-stone-600"><%= nome_exibicao %></p>
      </div>
    </header>

    <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { id: "form-conta", method: :put, class: "space-y-5" }) do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>

      <section class="rounded-2xl border border-stone-200 bg-white p-5 shadow-sm space-y-4 sm:p-6">
        <h2 class="text-sm font-semibold text-stone-900">Dados de acesso</h2>
        <div>
          <%= f.label :email, class: rotulo %>
          <%= f.email_field :email, autocomplete: "email", disabled: true, readonly: true,
                class: "#{campo} cursor-not-allowed opacity-70" %>
          <p class="mt-1 text-xs text-stone-500">Para alterar o e-mail, procure a coordenação.</p>
        </div>
        <div>
          <%= f.label :nome, class: rotulo %>
          <%= f.text_field :nome, autocomplete: "name", class: campo %>
        </div>
      </section>

      <section class="rounded-2xl border border-stone-200 bg-white p-5 shadow-sm space-y-4 sm:p-6">
        <div>
          <h2 class="text-sm font-semibold text-stone-900">Senha</h2>
          <p class="text-xs text-stone-500">Para trocar a senha, preencha os três campos. Para alterar só o nome, informe apenas a senha atual.</p>
        </div>
        <div>
          <%= f.label :current_password, "Senha atual", class: rotulo %>
          <p class="mb-2 text-xs text-stone-500">Obrigatória para confirmar qualquer alteração.</p>
          <%= f.password_field :current_password, autocomplete: "current-password", class: campo %>
        </div>
        <div class="border-t border-stone-100 pt-4">
          <%= f.label :password, "Nova senha", class: rotulo %>
          <%= f.password_field :password, autocomplete: "new-password", class: campo %>
        </div>
        <div>
          <%= f.label :password_confirmation, "Confirmar nova senha", class: rotulo %>
          <%= f.password_field :password_confirmation, autocomplete: "new-password", class: campo %>
        </div>
      </section>
    <% end %>

    <div class="grid grid-cols-3 gap-2">
      <%= link_to root_path, class: "inline-flex items-center justify-center gap-1.5 rounded-xl border border-stone-300 bg-white px-3 py-2.5 text-xs font-semibold text-stone-700 shadow-sm hover:bg-stone-50 transition-colors" do %>
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
        Voltar
      <% end %>
      <%# Fora do <form> (o "Sair" é outro formulário); o atributo form= liga o botão ao formulário da conta. %>
      <%= button_tag type: "submit", form: "form-conta",
            class: "inline-flex items-center justify-center gap-1.5 cursor-pointer rounded-xl bg-sky-600 px-3 py-2.5 text-xs font-semibold text-white shadow-md shadow-sky-900/15 hover:bg-sky-700 transition-colors" do %>
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
        Salvar
      <% end %>
      <%= button_to destroy_user_session_path, method: :delete, form: { data: { turbo: false }, class: "contents" },
            class: "w-full inline-flex items-center justify-center gap-1.5 cursor-pointer rounded-xl border border-red-200 bg-white px-3 py-2.5 text-xs font-semibold text-red-700 shadow-sm hover:bg-red-50 transition-colors" do %>
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/></svg>
        Sair
      <% end %>
    </div>
  </div>
</div>
