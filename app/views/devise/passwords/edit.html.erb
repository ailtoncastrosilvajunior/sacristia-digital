<% content_for :title, "Nova senha — Sacristia Digital" %>

<div class="relative min-h-screen flex flex-col items-center justify-center px-4 py-14 overflow-hidden">
  <div class="absolute inset-0 bg-slate-950" aria-hidden="true"></div>
  <div class="absolute inset-0 bg-gradient-to-b from-slate-950 via-blue-950/40 to-slate-950" aria-hidden="true"></div>
  <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[min(100%,42rem)] h-64 bg-sky-500/15 blur-[100px] rounded-full pointer-events-none" aria-hidden="true"></div>
  <div class="relative z-10 w-full max-w-[420px]">
    <div class="text-center mb-8">
      <p class="text-[11px] font-semibold tracking-[0.22em] uppercase text-sky-300/70">Ministros · MESC</p>
      <h1 class="mt-3 text-3xl font-bold text-white tracking-tight">Sacristia Digital</h1>
    </div>
    <div class="rounded-3xl bg-white/[0.97] shadow-[0_25px_50px_-12px_rgba(0,0,0,0.45)] ring-1 ring-white/60 px-6 py-8 sm:px-8 sm:py-9">
      <h2 class="text-lg font-semibold text-stone-900 tracking-tight mb-6">Definir nova senha</h2>

      <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put, class: "space-y-5" }) do |f| %>
        <%= render "devise/shared/error_messages", resource: resource %>
        <%= f.hidden_field :reset_password_token %>
        <div class="space-y-1.5">
          <%= f.label :password, "Nova senha", class: "block text-xs font-semibold uppercase tracking-wider text-stone-500" %>
          <%= f.password_field :password, autofocus: true, autocomplete: "new-password", class: "w-full px-4 py-3 rounded-xl border border-stone-200/90 bg-stone-50/40 text-stone-900 text-[15px] shadow-inner shadow-stone-900/5 focus:outline-none focus:ring-2 focus:ring-sky-500/25 focus:border-sky-400/80 focus:bg-white transition-all" %>
          <% if @minimum_password_length %>
            <p class="text-xs text-stone-400"><%= @minimum_password_length %> caracteres no mínimo</p>
          <% end %>
        </div>
        <div class="space-y-1.5">
          <%= f.label :password_confirmation, "Confirmar nova senha", class: "block text-xs font-semibold uppercase tracking-wider text-stone-500" %>
          <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "w-full px-4 py-3 rounded-xl border border-stone-200/90 bg-stone-50/40 text-stone-900 text-[15px] shadow-inner shadow-stone-900/5 focus:outline-none focus:ring-2 focus:ring-sky-500/25 focus:border-sky-400/80 focus:bg-white transition-all" %>
        </div>
        <%= f.submit "Alterar senha", class: "w-full cursor-pointer rounded-xl bg-gradient-to-r from-sky-600 via-sky-600 to-blue-600 px-4 py-3.5 text-[15px] font-semibold text-white shadow-lg shadow-sky-900/25 ring-1 ring-white/10 transition-all hover:from-sky-500 hover:to-blue-500 active:scale-[0.99]" %>
      <% end %>
    </div>
  </div>
</div>
