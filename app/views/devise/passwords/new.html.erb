<% content_for :title, "Recuperar senha — Sacristia Digital" %>

<div class="relative min-h-screen flex flex-col items-center justify-center px-4 py-14 overflow-hidden">
  <div class="absolute inset-0 bg-slate-950" aria-hidden="true"></div>
  <div class="absolute inset-0 bg-gradient-to-b from-slate-950 via-blue-950/40 to-slate-950" aria-hidden="true"></div>
  <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[min(100%,42rem)] h-64 bg-sky-500/15 blur-[100px] rounded-full pointer-events-none" aria-hidden="true"></div>
  <div class="relative z-10 w-full max-w-[420px]">
    <div class="text-center mb-8">
      <p class="text-[11px] font-semibold tracking-[0.22em] uppercase text-sky-300/70">Ministros · MESC</p>
      <h1 class="mt-3 text-3xl font-bold text-white tracking-tight">Sacristia Digital</h1>
    </div>
    <div class="rounded-3xl bg-white/[0.97] shadow-[0_25px_50px_-12px_rgba(0,0,0,0.45)] ring-1 ring-white/60 px-6 py-8 sm:px-8 sm:py-9">
      <h2 class="text-lg font-semibold text-stone-900 tracking-tight">Esqueceu sua senha?</h2>
      <p class="mt-2 mb-6 text-sm text-stone-500">Informe seu e-mail e enviaremos as instruções para criar uma nova senha.</p>

      <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post, class: "space-y-5" }) do |f| %>
        <%= render "devise/shared/error_messages", resource: resource %>
        <div class="space-y-1.5">
          <%= f.label :email, "E-mail", class: "block text-xs font-semibold uppercase tracking-wider text-stone-500" %>
          <%= f.email_field :email, autofocus: true, autocomplete: "email", placeholder: "nome@exemplo.com",
              class: "w-full px-4 py-3 rounded-xl border border-stone-200/90 bg-stone-50/40 text-stone-900 text-[15px] shadow-inner shadow-stone-900/5 focus:outline-none focus:ring-2 focus:ring-sky-500/25 focus:border-sky-400/80 focus:bg-white transition-all" %>
        </div>
        <%= f.submit "Enviar instruções", class: "w-full cursor-pointer rounded-xl bg-gradient-to-r from-sky-600 via-sky-600 to-blue-600 px-4 py-3.5 text-[15px] font-semibold text-white shadow-lg shadow-sky-900/25 ring-1 ring-white/10 transition-all hover:from-sky-500 hover:to-blue-500 active:scale-[0.99]" %>
      <% end %>

      <div class="mt-8 pt-6 border-t border-stone-100">
        <%= link_to "Voltar para o login", new_session_path(resource_name), class: "text-sm font-medium text-sky-700 hover:text-sky-900 transition-colors" %>
      </div>
    </div>
  </div>
</div>
