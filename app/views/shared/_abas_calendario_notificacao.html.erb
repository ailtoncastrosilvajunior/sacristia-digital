<%# locals: base_path (Proc), aba_ativa (String), badge_count (optional), aria_label (optional) %>
<nav class="flex flex-wrap gap-2" aria-label="<%= local_assigns.fetch(:aria_label, 'Calendário e notificação') %>">
  <% ativo = "inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-slate-900 text-white text-sm font-medium shadow-sm transition-colors" %>
  <% inativo = "inline-flex items-center gap-2 px-4 py-2.5 rounded-xl border border-stone-200 bg-white text-stone-800 text-sm font-medium hover:bg-stone-50 transition-colors" %>
  <%= link_to base_path.call(aba: "calendario"), class: (aba_ativa == "calendario" ? ativo : inativo) do %>
    <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
    Calendário
  <% end %>
  <%= link_to base_path.call(aba: "notificacao"), class: (aba_ativa == "notificacao" ? ativo : inativo) do %>
    <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"/></svg>
    Notificação
    <% if local_assigns[:badge_count].to_i.positive? %>
      <span class="inline-flex min-w-5 h-5 items-center justify-center rounded-full px-1.5 text-[10px] font-bold tabular-nums <%= aba_ativa == 'notificacao' ? 'bg-white/20 text-white' : 'bg-stone-200 text-stone-700' %>"><%= badge_count %></span>
    <% end %>
  <% end %>
</nav>
