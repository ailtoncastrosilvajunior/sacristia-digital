<div class="space-y-4">
  <nav class="flex items-center justify-between text-sm">
    <% if @anterior %>
      <%= link_to "← #{l(@anterior.data, format: '%d/%m')}", ministro_liturgia_path(data: @anterior.data.iso8601), class: "text-sky-800 font-medium" %>
    <% else %><span></span><% end %>
    <%= link_to "Calendário", ministro_liturgia_index_path(mes: @data.strftime("%Y-%m")), class: "text-stone-500" %>
    <% if @proximo %>
      <%= link_to "#{l(@proximo.data, format: '%d/%m')} →", ministro_liturgia_path(data: @proximo.data.iso8601), class: "text-sky-800 font-medium" %>
    <% else %><span></span><% end %>
  </nav>

  <header class="relative rounded-2xl overflow-hidden border border-stone-200/80 bg-white shadow-md">
    <div class="absolute inset-0 pointer-events-none" style="background: radial-gradient(120% 140% at 0% 0%, <%= @liturgia.cor_css %>26 0%, <%= @liturgia.cor_css %>0d 45%, transparent 75%)"></div>
    <div class="relative p-4 sm:p-5 flex gap-4 items-center">
      <% if @liturgia.imagem_santo.attached? %>
        <%= image_tag url_for(@liturgia.imagem_santo), alt: @liturgia.santo_nome.to_s, class: "w-24 h-24 sm:w-32 sm:h-32 rounded-2xl object-cover ring-4 ring-white shadow-lg shrink-0" %>
      <% end %>
      <div class="min-w-0">
        <p class="text-[11px] font-semibold uppercase tracking-widest text-stone-500"><%= l(@data, format: "%A, %d de %B de %Y") %></p>
        <h1 class="text-xl sm:text-2xl font-extrabold tracking-tight text-stone-900 mt-1 leading-tight"><%= @liturgia.titulo %></h1>
        <span class="mt-2 inline-flex items-center gap-2 rounded-full bg-white/80 backdrop-blur px-3 py-1 text-xs font-medium text-stone-700 ring-1 ring-stone-200 shadow-sm">
          <span class="inline-block w-3 h-3 rounded-full ring-2 ring-white shadow" style="background-color: <%= @liturgia.cor_css %>"></span>
          Cor litúrgica · <strong class="text-stone-900"><%= @liturgia.cor.presence || "—" %></strong>
        </span>
        <% if @liturgia.santo_nome.present? %>
          <p class="mt-3 text-sm font-semibold text-amber-800"><%= @liturgia.santo_nome %></p>
          <% if @liturgia.santo_descricao.present? %><p class="text-sm text-stone-600 mt-1 whitespace-pre-line"><%= @liturgia.santo_descricao %></p><% end %>
        <% end %>
      </div>
    </div>
  </header>

  <% if @eventos_do_dia.any? %>
    <section class="rounded-2xl border border-sky-200 bg-sky-50 p-4">
      <h2 class="text-sm font-semibold text-sky-900 mb-2">Seu serviço neste dia</h2>
      <ul class="space-y-1">
        <% @eventos_do_dia.each do |ev| %>
          <li class="text-sm text-sky-900">
            <%= link_to ministro_servico_path(ev), class: "hover:underline" do %>
              <span class="font-semibold tabular-nums"><%= l(ev.horario, format: :time) %></span> · <%= ev.tipo_servico.nome %><%= " · #{ev.sacerdote.nome}" if ev.sacerdote %>
            <% end %>
          </li>
        <% end %>
      </ul>
    </section>
  <% end %>

  <% @liturgia.leituras_ordenadas.each_with_index do |leitura, i| %>
    <details class="group rounded-2xl border border-stone-200 bg-white shadow-sm overflow-hidden" <%= "open" if leitura["tipo"] == "evangelho" %>>
      <summary class="cursor-pointer list-none flex items-center justify-between gap-3 px-4 py-3.5">
        <div class="min-w-0">
          <p class="text-xs uppercase tracking-wider text-stone-500"><%= @liturgia.rotulo_leitura(leitura) %></p>
          <p class="font-semibold text-stone-900"><%= leitura["referencia"] %></p>
        </div>
        <svg class="w-5 h-5 text-stone-400 transition-transform group-open:rotate-180 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
      </summary>
      <div class="px-4 pb-4 border-t border-stone-100 pt-3">
        <p class="text-base leading-relaxed text-stone-800 whitespace-pre-line"><%= leitura["texto"] %></p>
      </div>
    </details>
  <% end %>

  <p class="text-xs text-stone-400 text-center pb-2">
    Texto conferido e validado pela coordenação<%= " · fonte: #{@liturgia.fonte}" if @liturgia.fonte.present? %>
  </p>
</div>
