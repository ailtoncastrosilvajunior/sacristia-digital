<div class="space-y-4">
  <header>
    <h1 class="text-2xl font-bold tracking-tight text-slate-900">Liturgia do dia</h1>
    <p class="mt-0.5 text-sm text-stone-500">Leituras, cor litúrgica e santo do dia, conferidos pela coordenação.</p>
  </header>

  <% if @hoje %>
    <%= link_to ministro_liturgia_path(data: @hoje.data.iso8601), class: "block relative rounded-2xl overflow-hidden border border-stone-200/80 bg-white shadow-md hover:shadow-lg transition-shadow" do %>
      <div class="absolute inset-0 pointer-events-none" style="background: radial-gradient(120% 140% at 0% 0%, <%= @hoje.cor_css %>26 0%, <%= @hoje.cor_css %>0d 45%, transparent 75%)"></div>
      <div class="relative p-4 sm:p-5">
        <div class="flex gap-4 items-start">
          <div class="min-w-0 flex-1">
            <p class="text-[11px] font-semibold uppercase tracking-widest text-stone-500"><%= l(@hoje.data, format: "%A, %d de %B de %Y") %></p>
            <h2 class="text-lg sm:text-xl font-extrabold tracking-tight text-stone-900 mt-1 leading-tight"><%= @hoje.titulo %></h2>
            <span class="mt-2 inline-flex items-center gap-2 rounded-full bg-white/80 backdrop-blur px-3 py-1 text-xs font-medium text-stone-700 ring-1 ring-stone-200 shadow-sm">
              <span class="inline-block w-3 h-3 rounded-full ring-2 ring-white shadow" style="background-color: <%= @hoje.cor_css %>"></span>
              Cor litúrgica · <strong class="text-stone-900"><%= @hoje.cor.presence || "—" %></strong>
            </span>
            <% if @hoje.santo_nome.present? %>
              <p class="mt-3 text-sm font-semibold text-amber-800"><%= @hoje.santo_nome %></p>
            <% end %>
            <p class="text-sm text-stone-500 mt-1"><%= @hoje.leituras_ordenadas.map { |l| l["referencia"] }.join(" · ") %></p>
          </div>
          <% if @hoje.imagem_santo.attached? %>
            <%= image_tag url_for(@hoje.imagem_santo), alt: @hoje.santo_nome.to_s, class: "w-20 h-20 sm:w-24 sm:h-24 rounded-2xl object-cover ring-4 ring-white shadow-lg shrink-0" %>
          <% end %>
        </div>
      </div>
    <% end %>
  <% end %>

  <div class="flex items-center justify-between rounded-xl bg-white border border-stone-200 px-4 py-2.5">
    <%= link_to "←", ministro_liturgia_index_path(mes: @mes.prev_month.strftime("%Y-%m")), class: "px-2 text-stone-600" %>
    <h2 class="font-semibold text-stone-800"><%= l(@mes, format: :month_year) %></h2>
    <%= link_to "→", ministro_liturgia_index_path(mes: @mes.next_month.strftime("%Y-%m")), class: "px-2 text-stone-600" %>
  </div>

  <% if @dias.empty? %>
    <p class="text-sm text-stone-500 text-center py-6">Nenhuma liturgia validada para este mês ainda.</p>
  <% else %>
    <ul class="divide-y divide-stone-100 rounded-2xl border border-stone-200 bg-white overflow-hidden">
      <% @dias.each do |data, reg| %>
        <li>
          <%= link_to ministro_liturgia_path(data: data.iso8601), class: "flex items-center gap-3 px-4 py-3 hover:bg-stone-50 #{'bg-sky-50' if data == Date.current}" do %>
            <span class="w-10 text-center shrink-0">
              <span class="block text-lg font-bold text-stone-900 leading-none tabular-nums"><%= data.day %></span>
              <span class="block text-[10px] uppercase text-stone-500"><%= t("date.abbr_day_names")[data.wday] %></span>
            </span>
            <span class="inline-block w-3 h-3 rounded-full border border-stone-300 shrink-0" style="background-color: <%= reg.cor_css %>"></span>
            <span class="min-w-0">
              <span class="block text-sm font-medium text-stone-800 truncate"><%= reg.titulo %></span>
              <% if reg.santo_nome.present? %><span class="block text-xs text-amber-800 truncate"><%= reg.santo_nome %></span><% end %>
            </span>
          <% end %>
        </li>
      <% end %>
    </ul>
  <% end %>
</div>
