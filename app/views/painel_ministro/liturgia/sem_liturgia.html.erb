<div class="max-w-md mx-auto text-center rounded-2xl border border-stone-200 bg-white p-8 mt-6">
  <h1 class="text-lg font-semibold text-stone-800"><%= l(@data, format: "%A, %d de %B") %></h1>
  <p class="mt-2 text-sm text-stone-500">A liturgia deste dia ainda não foi validada pela coordenação.</p>
  <%= link_to "Ver calendário", ministro_liturgia_index_path(mes: @data.strftime("%Y-%m")), class: "inline-block mt-4 px-4 py-2 rounded-xl bg-sky-100 text-sky-900 text-sm font-medium" %>
</div>
