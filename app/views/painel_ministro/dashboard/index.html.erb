<% content_for :title, "Minha escala — Sacristia Digital" %>
<div class="min-h-full">
  <% primeiro_nome = (current_user.nome.presence || current_user.email.to_s).split(/\s+/).first %>

  <% if @ministro_record.blank? %>
    <div class="rounded-2xl border border-amber-200 bg-amber-50 p-8 text-center text-amber-900">
      <p class="font-medium">Conta sem vínculo de ministro</p>
      <p class="text-sm mt-2 opacity-90">Peça ao administrador para associar seu usuário ao cadastro de ministro.</p>
    </div>
  <% elsif @competencias.empty? %>
    <div class="rounded-2xl bg-white border border-sky-200/90 shadow-sm overflow-hidden mb-4 sm:mb-6">
      <div class="h-1 bg-gradient-to-r from-sky-400 to-blue-600" aria-hidden="true"></div>
      <div class="p-4 sm:p-5 min-w-0">
        <p class="text-[10px] sm:text-xs font-semibold uppercase tracking-wider text-sky-600">Olá, <%= primeiro_nome %></p>
        <h1 class="text-lg sm:text-2xl font-bold tracking-tight text-slate-900 mt-1">Nenhuma competência liberada</h1>
        <p class="mt-2 text-sm text-slate-600 leading-snug">Quando a coordenação marcar a escala como liberada aos ministros, o mês aparecerá aqui para consulta.</p>
      </div>
    </div>
  <% elsif @competencia.nil? %>
    <div class="rounded-2xl border border-amber-200 bg-amber-50 p-8 text-center text-amber-900">
      <p class="font-medium">Competência não encontrada.</p>
      <p class="text-sm mt-1 opacity-90">Escolha outra no menu acima.</p>
    </div>
  <% else %>
    <% comp = @competencia %>
    <% s = @stats %>
    <% mid = @ministro_record.id %>

    <% partes_resumo = []
       partes_resumo << "#{s[:total]} #{s[:total] == 1 ? 'serviço' : 'serviços'}"
       partes_resumo << "#{@plantao_por_dia.size} #{@plantao_por_dia.size == 1 ? 'dia' : 'dias'} de plantão" if @plantao_por_dia.any? %>
    <%= render "painel_ministro/dashboard_hero",
          primeiro_nome: primeiro_nome,
          resumo: "#{comp.label} · #{partes_resumo.join(' · ')}" %>

    <div class="flex flex-col xl:grid xl:grid-cols-12 gap-5 sm:gap-6 lg:gap-8">
      <%# ============ CALENDÁRIO ============ %>
      <section class="xl:col-span-5 order-1">
        <div class="rounded-2xl bg-white shadow-sm ring-1 ring-stone-200 overflow-hidden">
          <%= render "painel_ministro/competencia_picker", comp: comp, competencias: @competencias %>

          <div class="px-3 pt-3 pb-4 sm:px-5 space-y-3">
            <div class="grid grid-cols-7 text-center text-[11px] font-medium uppercase text-stone-500">
              <% I18n.t("date.abbr_day_names").each do |nome| %><span class="truncate"><%= nome.first(3) %></span><% end %>
            </div>
            <% lead = comp.periodo.wday %>
            <div class="grid grid-cols-7 gap-y-1.5">
              <% lead.times do %>
                <div aria-hidden="true"></div>
              <% end %>
              <% @heatmap.each do |cell| %>
                <% d = cell[:data] %>
                <% ap = ministro_calendario_celula(cell) %>
                <% hoje_cel = d == Date.current %>
                <% selected = @lista_desde == d %>
                <% sel_cls = selected ? "outline outline-2 outline-offset-2 outline-slate-900" : "" %>
                <% cel_cls = "relative mx-auto flex h-11 w-11 items-center justify-center rounded-full #{ap[:bg]} #{ap[:text]} #{ap[:shadow]} #{sel_cls} focus:outline-none focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-slate-900" %>
                <% dia_title = ministro_calendario_celula_title(cell, l(d)) %>
                <% num_cls = hoje_cel || ap[:ativo] ? "font-semibold" : "font-normal" %>
                <% if ap[:ativo] %>
                  <%= link_to ministro_root_path(competencia_mensal_id: comp.id, lista_desde: d.strftime("%Y-%m-%d")),
                        class: cel_cls, title: dia_title, aria: { label: dia_title } do %>
                    <span class="text-[15px] tabular-nums leading-none <%= num_cls %>"><%= d.day %></span>
                    <% if hoje_cel %><span class="absolute bottom-1 h-1 w-1 rounded-full bg-current"></span><% end %>
                  <% end %>
                <% else %>
                  <div class="<%= cel_cls %> <%= hoje_cel ? 'bg-stone-100 !text-slate-900' : '' %>" title="<%= dia_title %>">
                    <span class="text-[15px] tabular-nums leading-none <%= num_cls %>"><%= d.day %></span>
                  </div>
                <% end %>
              <% end %>
            </div>

            <div class="flex flex-wrap items-center gap-x-4 gap-y-1.5 border-t border-stone-100 pt-3 text-xs text-stone-600">
              <span class="inline-flex items-center gap-1.5"><span class="h-2.5 w-2.5 rounded-full bg-sky-800"></span> Ordinária</span>
              <span class="inline-flex items-center gap-1.5"><span class="h-2.5 w-2.5 rounded-full bg-amber-600"></span> Extra</span>
              <span class="inline-flex items-center gap-1.5"><span class="h-2.5 w-2.5 rounded-full border-2 border-dashed border-amber-500"></span> Plantão</span>
            </div>
          </div>

          <%# Detalhe do dia selecionado %>
          <% if @lista_desde %>
            <% bloco_dia = @plantao_por_dia[@lista_desde] %>
            <div class="border-t border-stone-200 bg-stone-50 px-4 py-3 sm:px-5 space-y-2">
              <p class="text-sm font-semibold text-slate-900 capitalize"><%= l(@lista_desde, format: "%A, %d/%m") %></p>

              <% @eventos_dia_filtro.each do |ev| %>
                <%= link_to ministro_servico_path(ev), class: "flex items-center gap-3 rounded-lg bg-white px-3 py-2.5 ring-1 ring-stone-200 active:bg-stone-100" do %>
                  <span class="text-sm font-semibold tabular-nums text-slate-900"><%= l(ev.horario, format: :time) %></span>
                  <span class="min-w-0 flex-1 truncate text-sm text-slate-700"><%= ev.tipo_servico.nome %></span>
                  <% if ev.extra? %><span class="text-[10px] font-semibold uppercase text-amber-800">Extra</span><% end %>
                  <svg class="w-4 h-4 shrink-0 text-stone-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
                <% end %>
              <% end %>

              <% if bloco_dia %>
                <div class="rounded-lg bg-white px-3 py-2.5 ring-1 ring-amber-300">
                  <p class="text-sm font-semibold text-amber-900">De plantão · <%= bloco_dia.rotulo %></p>
                  <% colegas_plantao = bloco_dia.plantao_periodo_ministros.reject { |x| x.ministro_id == mid }.map { |x| x.ministro&.nome }.compact %>
                  <% if colegas_plantao.any? %>
                    <p class="mt-0.5 text-xs text-stone-600">Com <%= colegas_plantao.to_sentence(two_words_connector: " e ", last_word_connector: " e ") %></p>
                  <% end %>
                </div>
              <% end %>

              <% if @eventos_dia_filtro.empty? && bloco_dia.nil? %>
                <p class="text-sm text-stone-500">Sem serviço neste dia.</p>
              <% end %>
            </div>
          <% end %>
        </div>
      </section>

      <%# ============ PRÓXIMAS CELEBRAÇÕES ============ %>
      <section class="xl:col-span-7 order-2 space-y-2">
        <div class="flex items-end justify-between gap-3 px-1">
          <h3 class="text-xs font-semibold uppercase tracking-wider text-stone-500">
            <% if @lista_desde %>
              A partir de <%= l(@lista_desde, format: :short) %>
            <% else %>
              Próximas celebrações
            <% end %>
          </h3>
          <% if params[:lista_desde].present? %>
            <%= link_to "Ver a partir de hoje", ministro_root_path(competencia_mensal_id: comp.id),
                  class: "text-xs font-semibold text-sky-800" %>
          <% end %>
        </div>

        <% if @proximos.empty? %>
          <div class="rounded-2xl bg-white p-8 text-center text-sm text-stone-500 ring-1 ring-stone-200">
            <% if @lista_desde %>
              Nada a partir de <%= l(@lista_desde) %> nesta competência.
            <% else %>
              Nenhum serviço pela frente neste mês.
            <% end %>
          </div>
        <% else %>
          <ul class="space-y-2">
            <% @proximos.each do |ev| %>
              <li><%= render "painel_ministro/servicos/card", ev: ev, mid: mid %></li>
            <% end %>
          </ul>
        <% end %>

        <% if @recentes_passados.any? %>
          <details class="group mt-3 rounded-2xl bg-white ring-1 ring-stone-200 overflow-hidden">
            <summary class="cursor-pointer list-none px-4 py-3 flex items-center justify-between text-sm font-medium text-slate-700">
              <span>Últimos serviços realizados</span>
              <svg class="w-4 h-4 text-stone-400 group-open:rotate-180 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
            </summary>
            <ul class="space-y-2 border-t border-stone-100 p-2 bg-stone-50/60">
              <% @recentes_passados.each do |ev| %>
                <li><%= render "painel_ministro/servicos/card", ev: ev, mid: mid, passado: true %></li>
              <% end %>
            </ul>
          </details>
        <% end %>
      </section>
    </div>
  <% end %>
</div>
