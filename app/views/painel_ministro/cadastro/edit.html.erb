<% content_for :title, "Meu cadastro — Sacristia Digital" %>
<% campo = "w-full px-4 py-2.5 rounded-xl border border-stone-300 bg-white focus:ring-2 focus:ring-sky-500/20 focus:border-sky-500" %>
<% bloqueado = "w-full px-4 py-2.5 rounded-xl border border-stone-200 bg-stone-100 text-stone-500 cursor-not-allowed" %>
<div class="mx-auto max-w-2xl space-y-5">
  <header>
    <%= link_to "← Central", ministro_root_path, class: "text-sm font-medium text-sky-800 hover:underline" %>
    <h1 class="mt-2 text-2xl font-bold tracking-tight text-slate-900">Meu cadastro</h1>
    <p class="mt-0.5 text-sm text-stone-500">Mantenha seus dados pessoais atualizados.</p>
  </header>

  <%= form_with model: @ministro, url: ministro_cadastro_path, method: :patch, class: "space-y-5 rounded-2xl bg-white p-5 shadow-sm ring-1 ring-stone-200 sm:p-6" do |f| %>
    <% if @ministro.errors.any? %>
      <div class="rounded-xl bg-red-50 p-4 text-sm text-red-800" role="alert">
        <p class="mb-1 font-medium"><%= pluralize(@ministro.errors.count, "erro") %> impediram de salvar:</p>
        <ul class="list-inside list-disc"><% @ministro.errors.full_messages.each do |msg| %><li><%= msg %></li><% end %></ul>
      </div>
    <% end %>

    <div>
      <%= f.label :nome_completo, "Nome completo", class: "mb-1 block text-sm font-medium text-stone-700" %>
      <%= f.text_field :nome_completo, class: campo, autocomplete: "name" %>
    </div>

    <div class="grid gap-5 sm:grid-cols-2">
      <div>
        <label class="mb-1 block text-sm font-medium text-stone-700">Nome nas escalas</label>
        <input type="text" value="<%= @ministro.nome %>" disabled class="<%= bloqueado %>">
        <p class="mt-1 text-xs text-stone-500">Definido pela coordenação.</p>
      </div>
      <div>
        <label class="mb-1 block text-sm font-medium text-stone-700">E-mail (seu login)</label>
        <input type="email" value="<%= @ministro.email %>" disabled class="<%= bloqueado %>">
        <p class="mt-1 text-xs text-stone-500">Para trocar o e-mail, fale com a coordenação: ele também é o seu acesso ao sistema.</p>
      </div>
    </div>

    <div class="grid gap-5 sm:grid-cols-2">
      <div>
        <%= f.label :telefone, "Telefone", class: "mb-1 block text-sm font-medium text-stone-700" %>
        <%= f.telephone_field :telefone, class: campo, placeholder: "(00) 00000-0000", autocomplete: "tel" %>
      </div>
      <div>
        <%= f.label :sexo, "Sexo", class: "mb-1 block text-sm font-medium text-stone-700" %>
        <%= f.select :sexo, Ministro::SEXOS, { include_blank: "Selecione" }, class: campo %>
      </div>
    </div>

    <%= render "admin/ministros/nascimento_fields", f: f %>

    <div class="flex flex-col-reverse gap-3 border-t border-stone-100 pt-4 sm:flex-row sm:items-center sm:justify-between">
      <%= link_to "Cancelar", ministro_root_path, class: "inline-flex justify-center rounded-xl border border-stone-300 px-5 py-2.5 text-sm font-semibold text-stone-700 hover:bg-stone-50" %>
      <%= f.submit "Salvar alterações", class: "cursor-pointer rounded-xl bg-sky-700 px-6 py-2.5 text-sm font-bold text-white shadow-sm hover:bg-sky-600 active:scale-95" %>
    </div>
  <% end %>
</div>
