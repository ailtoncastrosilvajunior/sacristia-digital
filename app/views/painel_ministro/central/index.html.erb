<% content_for :title, "Central do ministro — Sacristia Digital" %>
<% primeiro_nome = (current_user.nome.presence || current_user.email.to_s).split(/\s+/).first %>
<% icone = {
     escala: "M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z",
     mes: "M4 6h16M4 10h16M4 14h16M4 18h16",
     servicos: "M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4",
     cadastro: "M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z",
     liturgia: "M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253",
     relogio: "M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z",
     imprimir: "M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z"
   } %>
<% svg = ->(nome, cls = "w-5 h-5") { tag.svg(tag.path(d: icone[nome], "stroke-linecap": "round", "stroke-linejoin": "round", "stroke-width": 2), class: cls, fill: "none", stroke: "currentColor", viewBox: "0 0 24 24", "aria-hidden": "true") } %>

<div class="space-y-5 sm:space-y-6" style="<%= tema_css(@tema) %>">
  <%# ================= HERO (compacto, pensado para celular) ================= %>
  <section class="relative overflow-hidden rounded-3xl px-4 pb-12 pt-4 shadow-xl shadow-slate-900/15 sm:px-8 sm:pb-16 sm:pt-6"
           style="background: linear-gradient(135deg, var(--lit-de), var(--lit-ate)); color: var(--lit-texto);">
    <div class="pointer-events-none absolute -right-16 -top-20 h-56 w-56 rounded-full opacity-20" style="background: var(--lit-destaque);" aria-hidden="true"></div>

    <div class="relative">
      <p class="text-[10px] font-semibold uppercase tracking-[0.18em] opacity-80">Olá, <%= primeiro_nome %></p>

      <div class="mt-0.5 flex items-center justify-between gap-3">
        <h1 class="min-w-0 text-xl font-extrabold leading-tight tracking-tight sm:text-3xl">
          <%= l(@hoje, format: "%A").capitalize %>, <%= l(@hoje, format: "%d de %B") %>
        </h1>
        <% if @liturgia_hoje %>
          <%# Paramentos do dia: amostra da cor real %>
          <div class="flex shrink-0 items-center gap-2 rounded-full py-1 pl-1 pr-3 ring-1 ring-white/30" style="background: rgba(255,255,255,.14);" title="Paramentos <%= @tema[:nome] %>">
            <span class="h-7 w-7 rounded-full shadow-md ring-[3px] ring-white/80" style="background: <%= @tema[:cor] %>;" aria-hidden="true"></span>
            <div class="leading-tight">
              <p class="text-[8px] font-semibold uppercase tracking-[0.15em] opacity-80">Paramentos</p>
              <p class="text-xs font-extrabold"><%= @tema[:nome].presence || @liturgia_hoje.cor %></p>
            </div>
          </div>
        <% end %>
      </div>

      <% if @liturgia_hoje %>
        <% if @liturgia_hoje.titulo.present? %><p class="mt-1.5 line-clamp-2 text-xs leading-snug opacity-90 sm:text-sm"><%= @liturgia_hoje.titulo %></p><% end %>
      <% else %>
        <p class="mt-2 text-xs opacity-90">A liturgia de hoje ainda não foi validada.</p>
      <% end %>
    </div>

    <%# Faixa na cor dos paramentos %>
    <% if @liturgia_hoje %><div class="absolute inset-x-0 bottom-0 h-1.5" style="background: <%= @tema[:cor] %>;" aria-hidden="true"></div><% end %>
  </section>

  <%# ================= PRÓXIMO SERVIÇO ================= %>
  <section class="relative -mt-9 mx-2 sm:-mt-12 sm:mx-6 rounded-2xl bg-white p-4 shadow-lg ring-1 ring-stone-200 sm:p-6" style="border-top: 4px solid var(--lit-ate);">
    <% if @proximo %>
      <% ev = @proximo %>
      <% cor = ev.tipo_servico.cor_etiqueta.presence || "#64748b" %>
      <div class="flex flex-wrap items-start justify-between gap-3">
        <div class="min-w-0">
          <p class="flex items-center gap-1.5 text-[11px] font-bold uppercase tracking-[0.18em]" style="color: var(--lit-forte);">
            <%= svg.call(:relogio, "w-3.5 h-3.5") %> Seu próximo serviço
          </p>
          <p class="mt-1 text-2xl font-extrabold tracking-tight text-slate-900 sm:text-3xl"><%= quando_servico(ev, @hoje) %></p>
        </div>
        <% if @meu_papel&.coordenador? || @meu_papel&.adoracao? %>
          <div class="flex gap-1.5">
            <% if @meu_papel.coordenador? %><span class="rounded-full bg-amber-100 px-3 py-1 text-xs font-bold text-amber-900 ring-1 ring-amber-200">★ Você coordena</span><% end %>
            <% if @meu_papel.adoracao? %><span class="rounded-full bg-fuchsia-100 px-3 py-1 text-xs font-bold text-fuchsia-900 ring-1 ring-fuchsia-200">♥ Adoração</span><% end %>
          </div>
        <% end %>
      </div>

      <div class="mt-4 flex flex-wrap items-center gap-2">
        <span class="inline-flex rounded-lg border-2 px-3 py-1 text-sm font-bold text-slate-900" style="background-color: <%= cor %>26; border-color: <%= cor %>;"><%= ev.tipo_servico.nome %></span>
        <% if ev.sacerdote %><span class="text-sm text-stone-600"><span class="text-[10px] font-semibold uppercase tracking-wider text-stone-400">Sacerdote</span> <strong class="text-stone-900"><%= ev.sacerdote.nome %></strong></span><% end %>
      </div>

      <% equipe = escala_ministros_do_evento(ev, @ministro.id) %>
      <% if equipe.any? %>
        <div class="mt-3 flex flex-wrap gap-1.5">
          <% equipe.each do |m| %>
            <%= render "painel_ministro/escala_mensal/ministro_badge", nome: m[:nome], meu: m[:meu], adoracao: m[:adoracao] %>
          <% end %>
        </div>
      <% end %>
      <div class="mt-2"><%= render "admin/evento_escala/proclamacao_palavra", evento: ev %></div>

      <div class="mt-5 flex flex-wrap gap-2">
        <%= link_to ministro_servico_path(ev), class: "inline-flex items-center gap-2 rounded-xl px-4 py-2.5 text-sm font-bold text-white shadow-sm transition active:scale-95", style: "background: var(--lit-forte);" do %>
          Ver serviço e trocas
        <% end %>
      </div>
    <% else %>
      <div class="py-6 text-center">
        <p class="text-lg font-bold text-slate-900">Nenhum serviço à frente</p>
        <p class="mt-1 text-sm text-stone-500">Quando a escala for liberada e você for escalado, o próximo serviço aparece aqui.</p>
      </div>
    <% end %>
  </section>

  <%# ================= ALERTA DE TROCAS ================= %>
  <% if @trocas_pendentes.positive? %>
    <%= link_to ministro_escala_mensal_path, class: "flex items-center gap-3 rounded-2xl border border-amber-300 bg-amber-50 px-4 py-3 text-amber-950 shadow-sm active:scale-[0.99]" do %>
      <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-amber-500 text-sm font-extrabold text-white"><%= @trocas_pendentes %></span>
      <span class="min-w-0 flex-1 text-sm font-semibold">
        <%= @trocas_pendentes == 1 ? "Você recebeu 1 pedido de troca" : "Você recebeu #{@trocas_pendentes} pedidos de troca" %>
        <span class="block text-xs font-normal text-amber-800">Toque para responder na escala do mês</span>
      </span>
      <svg class="h-5 w-5 shrink-0 text-amber-700" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
    <% end %>
  <% end %>

  <%# ================= AGENDA DO MÊS ================= %>
  <% if @competencia %>
    <%= render "painel_ministro/central/agenda", comp: @competencia, mid: @ministro.id %>
  <% else %>
    <div class="rounded-2xl border border-dashed border-stone-300 bg-white/80 px-6 py-8 text-center text-sm text-stone-500">
      Nenhuma escala liberada ainda. Quando a coordenação liberar o mês, o calendário aparece aqui.
    </div>
  <% end %>

  <%# ================= ATALHOS ================= %>
  <section class="grid grid-cols-1 gap-3 sm:grid-cols-3">
    <% atalhos = [
         [:mes, "Escala completa", @competencia&.label || "Todos os horários", escala_do_mes_destino],
         [:liturgia, "Liturgia", (@liturgia_hoje&.titulo.presence || "Leituras e orações do dia"), (@liturgia_hoje ? ministro_liturgia_path(data: @hoje.iso8601) : ministro_liturgia_index_path)],
         [:cadastro, "Meu cadastro", "Telefone, nascimento e dados pessoais", ministro_cadastro_path]
       ] %>
    <% atalhos.each do |ico, titulo, sub, destino| %>
      <%= link_to destino, class: "group flex flex-col gap-3 rounded-2xl bg-white p-4 shadow-sm ring-1 ring-stone-200 transition hover:-translate-y-0.5 hover:shadow-md active:scale-[0.98]" do %>
        <% if ico == :liturgia && @liturgia_hoje&.imagem_santo&.attached? %>
          <%= image_tag url_for(@liturgia_hoje.imagem_santo), alt: @liturgia_hoje.santo_nome.to_s, class: "h-14 w-14 rounded-xl object-cover shadow-sm ring-1 ring-stone-200" %>
        <% else %>
          <span class="flex h-11 w-11 items-center justify-center rounded-xl transition group-hover:scale-105" style="background: var(--lit-claro); color: var(--lit-forte);"><%= svg.call(ico, "w-6 h-6") %></span>
        <% end %>
        <span class="min-w-0">
          <span class="block text-base font-bold text-slate-900"><%= titulo %></span>
          <% if ico == :liturgia && @liturgia_hoje&.santo_nome.present? %>
            <span class="mt-0.5 block text-[10px] font-semibold uppercase tracking-wider text-stone-400">Santo do dia</span>
            <span class="line-clamp-2 block text-xs font-semibold text-stone-700"><%= @liturgia_hoje.santo_nome %></span>
          <% else %>
            <span class="mt-0.5 line-clamp-2 block text-xs text-stone-500"><%= sub %></span>
          <% end %>
        </span>
      <% end %>
    <% end %>
  </section>

  <% if @competencia %>
    <div class="flex justify-center">
      <%= link_to ministro_escala_mensal_imprimir_path(competencia_mensal_id: @competencia.id), target: "_blank", rel: "noopener",
            class: "inline-flex items-center gap-2 rounded-xl border bg-white px-4 py-2.5 text-sm font-semibold shadow-sm transition active:scale-95", style: "border-color: var(--lit-forte); color: var(--lit-forte);" do %>
        <%= svg.call(:imprimir, "w-4 h-4") %> Imprimir / PDF da escala de <%= @competencia.label %>
      <% end %>
    </div>
  <% end %>
  <%= render "painel_ministro/central/instalar_app" %>
</div>
