<%# Convite + passo a passo para instalar o app na tela inicial (iPhone e Android) %>
<% ic_share = '<svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3v12M8 7l4-4 4 4M6 11H5a2 2 0 00-2 2v6a2 2 0 002 2h14a2 2 0 002-2v-6a2 2 0 00-2-2h-1"/></svg>'.html_safe %>
<% ic_add = '<svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="4"/><path d="M12 8v8M8 12h8"/></svg>'.html_safe %>
<% ic_menu = '<svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="5" r="2"/><circle cx="12" cy="12" r="2"/><circle cx="12" cy="19" r="2"/></svg>'.html_safe %>
<% ic_app = '<svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true"><rect x="7" y="2" width="10" height="20" rx="2.5"/><path d="M12 6v8m-3-3l3 3 3-3"/></svg>'.html_safe %>
<% ic_ok = '<svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 13l4 4L19 7"/></svg>'.html_safe %>

<% passos = {
     "ios" => [
       [ ic_share, "Abra no Safari", "Acesse o Sacristia Digital pelo Safari e toque em <b>Compartilhar</b> (o quadrado com a seta para cima, na barra de baixo)." ],
       [ ic_add, "Adicionar à Tela de Início", "Role a lista de opções e toque em <b>Adicionar à Tela de Início</b>." ],
       [ ic_ok, "Confirme", "Toque em <b>Adicionar</b>. O ícone do ostensório aparece na sua tela, como um app." ]
     ],
     "android" => [
       [ ic_menu, "Abra o menu do Chrome", "No Chrome, toque nos <b>três pontinhos</b> no canto superior direito." ],
       [ ic_app, "Instalar aplicativo", "Toque em <b>Instalar aplicativo</b> (ou <b>Adicionar à tela inicial</b>)." ],
       [ ic_ok, "Confirme", "Toque em <b>Instalar</b>. O ícone do ostensório aparece na sua tela, como um app." ]
     ]
   } %>

<div data-controller="instalar-app">
  <section data-instalar-app-target="cartao" class="hidden">
    <button type="button" data-action="instalar-app#abrir"
            class="flex w-full items-center gap-3 rounded-2xl bg-white p-3 text-left shadow-sm ring-1 ring-stone-200 transition active:scale-[.99]">
      <%= image_tag "/icons/icon-192.png", alt: "", class: "h-12 w-12 shrink-0 rounded-xl shadow ring-1 ring-stone-200" %>
      <span class="min-w-0 flex-1">
        <span class="block text-sm font-extrabold text-slate-900">Tenha o app na tela do celular</span>
        <span class="block text-xs text-stone-500">Abra a Sacristia com um toque. Veja como instalar.</span>
      </span>
      <svg class="h-5 w-5 shrink-0 text-stone-400" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg>
    </button>
  </section>

  <dialog data-instalar-app-target="dialog" data-action="click->instalar-app#backdrop"
          class="m-auto w-[calc(100%-1.5rem)] max-w-md rounded-3xl p-0 shadow-2xl backdrop:bg-slate-900/50">
    <div class="p-5">
      <div class="flex items-start gap-3">
        <%= image_tag "/icons/icon-192.png", alt: "", class: "h-14 w-14 shrink-0 rounded-2xl shadow ring-1 ring-stone-200" %>
        <div class="min-w-0 flex-1">
          <h2 class="text-lg font-extrabold leading-tight text-slate-900">Instale a Sacristia Digital</h2>
          <p class="text-xs text-stone-500">3 toques e fica na tela inicial, sem digitar o endereço.</p>
        </div>
        <button type="button" data-action="instalar-app#fechar" class="-mr-1 -mt-1 rounded-full p-2 text-stone-400 active:bg-stone-100" aria-label="Fechar">
          <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
        </button>
      </div>

      <div class="mt-4 grid grid-cols-2 gap-1 rounded-xl bg-stone-100 p-1" role="tablist">
        <button type="button" role="tab" data-instalar-app-target="aba" data-plataforma="ios" data-action="instalar-app#trocar" class="rounded-lg py-2 text-sm font-bold transition">iPhone</button>
        <button type="button" role="tab" data-instalar-app-target="aba" data-plataforma="android" data-action="instalar-app#trocar" class="rounded-lg py-2 text-sm font-bold transition">Android</button>
      </div>

      <% passos.each do |plataforma, lista| %>
        <div data-instalar-app-target="painel" data-plataforma="<%= plataforma %>" class="mt-4">
        <ol class="space-y-3">
          <% lista.each_with_index do |(icone, titulo, texto), i| %>
            <li class="flex items-start gap-3 rounded-2xl bg-stone-50 p-3 ring-1 ring-stone-200/70">
              <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl text-white shadow" style="background: var(--lit-forte, #0369a1);"><%= icone %></span>
              <div class="min-w-0">
                <p class="text-sm font-extrabold text-slate-900"><span class="mr-1 text-stone-400"><%= i + 1 %>.</span><%= titulo %></p>
                <p class="mt-0.5 text-xs leading-snug text-stone-600"><%= texto.html_safe %></p>
              </div>
            </li>
          <% end %>
        </ol>
        <% if plataforma == "ios" %>
          <p class="mt-4 rounded-xl bg-amber-50 px-3 py-2 text-[11px] leading-snug text-amber-900 ring-1 ring-amber-200">
            No iPhone, só funciona pelo <b>Safari</b>. Se já tinha um atalho antigo, remova-o antes de adicionar de novo.
          </p>
        <% end %>
        </div>
      <% end %>


      <button type="button" data-action="instalar-app#fechar" class="mt-4 w-full rounded-xl py-3 text-sm font-bold text-white shadow active:scale-[.99]" style="background: var(--lit-forte, #0369a1);">Entendi</button>
    </div>
  </dialog>
</div>
