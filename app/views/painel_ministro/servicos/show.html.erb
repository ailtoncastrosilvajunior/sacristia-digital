<% content_for :title, "Serviço — Sacristia Digital" %>
<% ev = @servico %>
<% mid = current_user.ministro_id %>
<% em = ev.escala_ministros.find { |x| x.ministro_id == mid } %>
<% cor = ev.tipo_servico.cor_etiqueta.presence || "#64748b" %>
<%
  papel_em_texto = lambda do |row|
    if row.coordenador? && row.adoracao?
      "Coordenar a equipe e conduzir a adoração"
    elsif row.coordenador?
      "Coordenar a equipe de ministros"
    elsif row.adoracao?
      "Conduzir a adoração"
    else
      "Servir na equipe de ministros"
    end
  end
  colegas = ev.escala_ministros
    .reject { |row| row.ministro_id == mid }
    .sort_by do |row|
      [
        row.coordenador? ? 0 : 1,
        row.adoracao? ? 0 : 1,
        row.ministro&.nome.to_s.downcase
      ]
    end
%>

<div class="space-y-4 sm:space-y-5">
  <% unless @modal %>
  <%= link_to ministro_meus_servicos_path, class: "inline-flex items-center gap-1 text-sm font-medium text-sky-700 hover:text-sky-900" do %>
    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
    Voltar à lista
  <% end %>
  <% end %>

  <div class="rounded-3xl border border-stone-200/80 bg-white shadow-lg overflow-hidden">
    <%# Cabeçalho %>
    <div class="relative px-5 py-5 sm:px-6 sm:py-6">
      <div class="absolute inset-0 pointer-events-none" style="background: radial-gradient(120% 150% at 0% 0%, <%= cor %>30 0%, <%= cor %>0d 45%, transparent 75%)"></div>
      <div class="relative flex items-center gap-4">
        <div class="shrink-0 w-16 rounded-2xl bg-white shadow-md ring-1 ring-stone-200/80 overflow-hidden text-center">
          <p class="py-0.5 text-[10px] font-bold uppercase tracking-wider text-white" style="background-color: <%= cor %>"><%= I18n.t("date.abbr_day_names")[ev.data.wday] %></p>
          <p class="text-2xl font-extrabold tabular-nums text-stone-900 leading-none pt-1.5"><%= ev.data.day %></p>
          <p class="pb-1.5 pt-0.5 text-[10px] font-semibold uppercase text-stone-500"><%= I18n.t("date.abbr_month_names")[ev.data.month] %></p>
        </div>
        <div class="min-w-0">
          <span class="inline-flex px-2.5 py-0.5 text-xs font-semibold rounded-full border" style="background-color: <%= cor %>22; border-color: <%= cor %>55; color: #1e293b;"><%= ev.tipo_servico.nome %></span>
          <h1 class="mt-1.5 text-xl sm:text-2xl font-extrabold tracking-tight text-stone-900 leading-tight"><%= l(ev.data, format: "%A, %d de %B") %></h1>
          <p class="mt-1 inline-flex items-center gap-1.5 text-sm font-semibold text-sky-800 tabular-nums">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            <%= l(ev.horario, format: :time) %>
          </p>
        </div>
      </div>
    </div>

    <div class="px-5 pb-5 sm:px-6 sm:pb-6 space-y-5 text-sm">
      <%# Informações %>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
        <div class="flex items-center gap-3 rounded-2xl bg-stone-50 ring-1 ring-stone-200/70 px-3.5 py-3">
          <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-white text-sky-700 ring-1 ring-stone-200">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
          </span>
          <div class="min-w-0">
            <p class="text-[10px] font-semibold uppercase tracking-wider text-stone-500">Sacerdote</p>
            <p class="font-semibold text-stone-900 truncate"><%= ev.sacerdote&.nome || tag.span("A definir", class: "text-stone-400 italic font-normal") %></p>
          </div>
        </div>
        <% if ev.plantao_periodo %>
          <div class="flex items-center gap-3 rounded-2xl bg-stone-50 ring-1 ring-stone-200/70 px-3.5 py-3">
            <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-white text-sky-700 ring-1 ring-stone-200">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
            </span>
            <div class="min-w-0">
              <p class="text-[10px] font-semibold uppercase tracking-wider text-stone-500">Plantão</p>
              <p class="font-semibold text-stone-900 truncate"><%= ev.plantao_periodo.rotulo %></p>
            </div>
          </div>
        <% end %>
      </div>

      <%# Seu papel %>
      <% if em %>
        <div class="relative overflow-hidden rounded-2xl bg-gradient-to-br from-sky-500 to-blue-600 px-4 py-4 text-white shadow-md">
          <svg class="absolute -right-3 -bottom-4 w-24 h-24 text-white/10" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2l2.9 6.9L22 10l-5.5 4.8L18 22l-6-3.6L6 22l1.5-7.2L2 10l7.1-1.1z"/></svg>
          <p class="text-[10px] font-bold uppercase tracking-widest text-sky-100">Sua função</p>
          <p class="mt-1 text-lg font-bold leading-snug"><%= papel_em_texto.call(em) %></p>
          <div class="mt-2 flex flex-wrap gap-1.5">
            <% if em.coordenador? %>
              <span class="inline-flex px-2 py-0.5 text-[10px] font-bold uppercase rounded-full bg-amber-300 text-amber-950">Coordenador</span>
            <% end %>
            <% if em.adoracao? %>
              <span class="inline-flex px-2 py-0.5 text-[10px] font-bold uppercase rounded-full bg-fuchsia-200 text-fuchsia-950">Adoração</span>
            <% end %>
            <% unless em.coordenador? || em.adoracao? %>
              <span class="inline-flex px-2 py-0.5 text-[10px] font-bold uppercase rounded-full bg-white/20 text-white ring-1 ring-white/40">Ministro da equipe</span>
            <% end %>
          </div>
        </div>
      <% end %>

      <%# Equipe %>
      <div>
        <p class="text-[11px] font-semibold uppercase tracking-wider text-stone-500">
          <% if colegas.any? %>
            Ministros com você
            <span class="ml-1 rounded-full bg-stone-100 px-1.5 py-0.5 text-stone-500 normal-case tracking-normal font-medium"><%= colegas.size + (em ? 1 : 0) %> no total</span>
          <% else %>
            Equipe neste serviço
          <% end %>
        </p>

        <% if colegas.empty? %>
          <p class="mt-2 text-stone-600 leading-relaxed">
            <% if em %>
              Nesta celebração você está designado sozinho na escala de ministros.
            <% else %>
              Ainda não há ministros designados para este serviço.
            <% end %>
          </p>
        <% else %>
          <ul class="mt-3 grid grid-cols-1 sm:grid-cols-2 gap-2">
            <% colegas.each do |row| %>
              <% nome_m = row.ministro&.nome.to_s %>
              <% iniciais = nome_m.split(/\s+/).reject(&:blank?).take(2).map { |w| w[0] }.join.upcase.presence || "?" %>
              <li class="flex items-center gap-3 rounded-2xl bg-stone-50 ring-1 ring-stone-200/70 px-3 py-2.5">
                <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-gradient-to-br from-sky-100 to-sky-200 text-xs font-bold text-sky-900 ring-2 ring-white shadow-sm">
                  <%= iniciais %>
                </div>
                <div class="min-w-0 flex-1">
                  <p class="font-semibold text-stone-900 truncate"><%= row.ministro&.nome || "—" %></p>
                  <p class="text-xs text-stone-500 truncate"><%= papel_em_texto.call(row) %></p>
                </div>
                <% if row.coordenador? %><span class="shrink-0 text-amber-500" title="Coordenador">★</span><% end %>
              </li>
            <% end %>
          </ul>
        <% end %>
      </div>
    </div>
  </div>
</div>
