<% content_for :title, "Serviço — Sacristia Digital" %>
<% ev = @servico %>
<% mid = current_user.ministro_id %>
<% em = ev.escala_ministros.find { |x| x.ministro_id == mid } %>
<% cor = ev.tipo_servico.cor_etiqueta.presence || "#64748b" %>
<%
  papel_em_texto = lambda do |row|
    if row.coordenador? && row.adoracao?
      "Coordenar a equipe e conduzir a adoração"
    elsif row.coordenador?
      "Coordenar a equipe de ministros"
    elsif row.adoracao?
      "Conduzir a adoração"
    else
      "Servir na equipe de ministros"
    end
  end
%>

<%
  equipe = escala_ministros_do_evento(ev, mid)
  iniciais = ->(nome) { nome.to_s.split.first(2).map { |w| w[0] }.join.upcase }
  status_txt = I18n.t("activerecord.attributes.evento_escala.status_values.#{ev.status}", default: ev.status.humanize)
%>

<div class="space-y-3 sm:space-y-4">
  <div class="flex items-center justify-between gap-3">
    <% unless @modal %>
      <%= link_to ministro_meus_servicos_path, class: "inline-flex items-center gap-1 text-sm font-medium text-sky-700 hover:text-sky-900" do %>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
        Voltar à lista
      <% end %>
    <% else %>
      <span></span>
    <% end %>
    <% if current_user.admin? %>
      <%= link_to edit_admin_evento_escala_path(ev, return_to: ministro_servico_path(ev)), data: { turbo_frame: "_top" }, title: "Editar evento", aria: { label: "Editar evento" },
          class: "inline-flex items-center gap-1.5 rounded-full border border-stone-300 bg-white px-3 py-1.5 text-xs font-semibold text-stone-600 shadow-sm hover:bg-stone-50 hover:border-stone-400 transition-colors" do %>
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
        Editar
      <% end %>
    <% end %>
  </div>

  <article class="rounded-3xl border border-stone-200/80 bg-white shadow-lg overflow-hidden">
    <%# Cabeçalho estilo "ingresso": data em destaque, hora gigante à direita %>
    <header class="relative overflow-hidden px-5 pt-5 pb-6 sm:px-7" style="background: linear-gradient(120deg, <%= cor %>33 0%, <%= cor %>0f 60%, transparent 100%)">
      <span class="pointer-events-none select-none absolute -right-2 -top-6 text-[9rem] font-black leading-none tabular-nums text-stone-900/[0.04]" aria-hidden="true"><%= ev.data.day %></span>
      <div class="relative flex flex-wrap items-center gap-2">
        <span class="inline-flex px-2.5 py-0.5 text-xs font-bold rounded-full border-2" style="background-color: <%= cor %>33; border-color: <%= cor %>; color: #0f172a;"><%= ev.tipo_servico.nome %></span>
        <span class="inline-flex items-center gap-1 text-[10px] font-bold uppercase tracking-wider text-stone-500"><span class="h-1.5 w-1.5 rounded-full bg-emerald-500"></span><%= status_txt %></span>
      </div>
      <div class="relative mt-3 flex items-end justify-between gap-4">
        <div class="min-w-0">
          <p class="text-xs font-bold uppercase tracking-[0.2em] text-stone-500"><%= l(ev.data, format: "%A") %></p>
          <h1 class="text-3xl sm:text-4xl font-black tracking-tight text-stone-900 leading-none mt-1"><%= l(ev.data, format: "%d de %B") %></h1>
        </div>
        <p class="shrink-0 text-4xl sm:text-5xl font-black tabular-nums leading-none text-sky-700"><%= l(ev.horario, format: :time) %></p>
      </div>
    </header>

    <%# Picote do ingresso %>
    <div class="border-t-2 border-dashed border-stone-200"></div>

    <div class="grid gap-5 p-5 sm:p-7 lg:grid-cols-5 text-sm">
      <%# Coluna esquerda: sacerdote + função %>
      <div class="space-y-4 lg:col-span-2">
        <div class="flex items-center gap-3">
          <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-stone-100 text-stone-600 ring-1 ring-stone-200">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M12 3v18m-5-13h10"/></svg>
          </span>
          <div class="min-w-0">
            <p class="text-[10px] font-semibold uppercase tracking-wider text-stone-500">Celebrante</p>
            <p class="text-base font-bold text-stone-900 truncate"><%= ev.sacerdote&.nome || tag.span("A definir", class: "text-stone-400 italic font-normal") %></p>
          </div>
        </div>

        <% if ev.plantao_periodo %>
          <p class="inline-flex items-center gap-1.5 rounded-full bg-stone-100 px-3 py-1 text-xs font-semibold text-stone-700">
            <svg class="w-3.5 h-3.5 text-sky-700" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
            Plantão · <%= ev.plantao_periodo.rotulo %>
          </p>
        <% end %>

        <% if em %>
          <div class="relative overflow-hidden rounded-2xl bg-gradient-to-br from-sky-500 to-blue-600 px-4 py-4 text-white shadow-md">
            <svg class="absolute -right-3 -bottom-4 w-24 h-24 text-white/10" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2l2.9 6.9L22 10l-5.5 4.8L18 22l-6-3.6L6 22l1.5-7.2L2 10l7.1-1.1z"/></svg>
            <p class="text-[10px] font-bold uppercase tracking-widest text-sky-100">Sua função</p>
            <p class="mt-1 text-lg font-bold leading-snug"><%= papel_em_texto.call(em) %></p>
            <div class="mt-2 flex flex-wrap gap-1.5">
              <% if em.coordenador? %>
                <span class="inline-flex px-2 py-0.5 text-[10px] font-bold uppercase rounded-full bg-amber-300 text-amber-950">Coordenador</span>
              <% end %>
              <% if em.adoracao? %>
                <span class="inline-flex px-2 py-0.5 text-[10px] font-bold uppercase rounded-full bg-fuchsia-200 text-fuchsia-950">Adoração</span>
              <% end %>
              <% unless em.coordenador? || em.adoracao? %>
                <span class="inline-flex px-2 py-0.5 text-[10px] font-bold uppercase rounded-full bg-white/20 text-white ring-1 ring-white/40">Ministro da equipe</span>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>

      <%# Coluna direita: equipe com avatares %>
      <section class="lg:col-span-3">
        <p class="text-[11px] font-semibold uppercase tracking-wider text-stone-500">
          Equipe
          <span class="ml-1 rounded-full bg-stone-100 px-1.5 py-0.5 text-stone-500 normal-case tracking-normal font-medium"><%= equipe.size %> <%= equipe.size == 1 ? "ministro" : "ministros" %></span>
        </p>
        <% if equipe.empty? %>
          <p class="mt-2 text-stone-600">Ainda não há ministros designados para este serviço.</p>
        <% else %>
          <ul class="mt-3 grid gap-2 sm:grid-cols-2">
            <% equipe.each do |m| %>
              <li class="flex items-center gap-2.5 rounded-xl px-2.5 py-2 ring-1 <%= m[:meu] ? "bg-sky-50 ring-sky-200" : "bg-stone-50/70 ring-stone-200/70" %>">
                <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full text-[11px] font-bold <%= m[:meu] ? "bg-sky-600 text-white" : "bg-white text-stone-600 ring-1 ring-stone-200" %>"><%= iniciais.call(m[:nome]) %></span>
                <span class="min-w-0 flex-1">
                  <span class="block truncate font-semibold text-stone-900"><%= m[:nome] %><% if m[:meu] %> <span class="text-sky-700 font-medium">(você)</span><% end %></span>
                  <% if m[:coordenador] || m[:adoracao] %>
                    <span class="block text-[10px] font-bold uppercase tracking-wide <%= m[:coordenador] ? "text-amber-700" : "text-orange-700" %>"><%= [("Coordenador" if m[:coordenador]), ("Adoração" if m[:adoracao])].compact.join(" · ") %></span>
                  <% end %>
                </span>
                <% if m[:adoracao] %><%= image_tag "custodia.png", alt: "Adoração", class: "h-5 w-auto shrink-0" %><% end %>
              </li>
            <% end %>
          </ul>
        <% end %>
      </section>

      <%# Palavra, descrição e observações em largura total %>
      <% if ev.proclamacao_palavra.present? %>
        <blockquote class="lg:col-span-5 relative rounded-2xl border-l-4 border-amber-400 bg-amber-50/60 px-4 py-3">
          <p class="text-[10px] font-bold uppercase tracking-widest text-amber-800/80">Proclamação da Palavra</p>
          <p class="mt-1 text-stone-800 leading-relaxed whitespace-pre-line"><%= ev.proclamacao_palavra %></p>
        </blockquote>
      <% end %>

      <% if ev.descricao.present? || ev.observacoes.present? %>
        <div class="lg:col-span-5 grid gap-4 sm:grid-cols-2">
          <% if ev.descricao.present? %>
            <div>
              <p class="text-[11px] font-semibold uppercase tracking-wider text-stone-500">Descrição</p>
              <p class="mt-1 text-stone-700 leading-relaxed whitespace-pre-line"><%= ev.descricao %></p>
            </div>
          <% end %>
          <% if ev.observacoes.present? %>
            <div>
              <p class="text-[11px] font-semibold uppercase tracking-wider text-stone-500">Observações</p>
              <p class="mt-1 text-stone-700 leading-relaxed whitespace-pre-line"><%= ev.observacoes %></p>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>
  </article>
</div>
