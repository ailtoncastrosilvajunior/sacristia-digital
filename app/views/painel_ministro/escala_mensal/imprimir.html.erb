<% content_for :title, "Escala mensal – #{@competencia.label}" %>
<% mes_nome = I18n.t("date.month_names")[@competencia.mes].to_s.upcase %>
<% mes_params = { competencia_mensal_id: @competencia.id } %>
<script>
  // Rodapé de página (@page margin boxes): Chrome/Edge 131+. Nos demais, fica o rodapé no fim da tabela.
  (function () {
    var m = navigator.userAgent.match(/Chrom(?:e|ium)\/(\d+)/);
    if (m && parseInt(m[1], 10) >= 131) document.documentElement.classList.add("rodape-de-pagina");
  })();
</script>
<style>
  @page {
    size: A4 portrait;
    margin: 8mm 8mm 14mm 8mm;
    @bottom-center { content: "Sacristia Digital - gerado em <%= l(Time.current, format: "%d/%m/%Y %H:%M") %>"; font: 8pt Arial, Helvetica, sans-serif; color: #475569; }
    @bottom-right { content: "Página " counter(page) "/" counter(pages); font: 8pt Arial, Helvetica, sans-serif; color: #475569; }
  }
  * { box-sizing: border-box; }
  html, body { margin: 0; padding: 0; }
  body { font-family: Arial, Helvetica, sans-serif; color: #0f172a; background: #e5e7eb; }
  .toolbar { position: sticky; top: 0; z-index: 10; display: flex; flex-wrap: wrap; gap: 8px; align-items: center; justify-content: center; padding: 10px; background: #0f172a; color: #fff; font-size: 14px; }
  .toolbar a, .toolbar button { font: inherit; color: #fff; background: #1e40af; border: 0; border-radius: 8px; padding: 8px 14px; text-decoration: none; cursor: pointer; }
  .toolbar a.sec { background: #334155; }
  .toolbar .dica { flex-basis: 100%; text-align: center; font-size: 12px; opacity: .8; }
  .folha { width: 194mm; margin: 12px auto; background: #fff; padding: 0; font-size: <%= @fonte_pt %>pt; line-height: 1.25; }
  table { width: 100%; border-collapse: collapse; table-layout: fixed; }
  thead { display: table-header-group; }
  tr { page-break-inside: avoid; break-inside: avoid; }
  .titulo td { background: #0b2545; color: #fff; padding: 5px 8px; }
  .titulo .t1 { font-size: 1.7em; font-weight: 800; letter-spacing: .02em; }
  .titulo .t2 { font-size: .75em; background: #1d4e7a; }
  .titulo .mes { background: #bfdbfe; color: #0b2545; text-align: center; font-weight: 800; font-size: 1.5em; width: 22%; }
  .titulo .ano { background: #e0f2fe; color: #0b2545; text-align: center; font-weight: 800; font-size: 1.3em; }
  th { background: #0b2545; color: #fff; padding: 4px 4px; font-size: .9em; border: 1px solid #0b2545; }
  td.c { border: 1px solid #cbd5e1; padding: 2px 5px; vertical-align: middle; }
  td.dia { text-align: center; font-weight: 800; font-size: 1.5em; background: #fff; }
  td.sem { text-align: center; font-weight: 700; font-size: .85em; }
  td.hora { text-align: center; font-weight: 700; white-space: nowrap; }
  td.cel { font-weight: 600; }
  td.extra { text-align: center; }
  tr.fds td.c { background: #eff6ff; }
  tr.fds td.dia, tr.fds td.sem { color: #1e3a8a; }
  tr.sep-dia td.c { border-top: 2px solid #0b2545; }
  .adoracao { font-weight: 700; }
  .meu { background: #bbf7d0; font-weight: 800; padding: 0 2px; border-radius: 2px; }
  .pagina-cal { page-break-before: always; break-before: page; font-size: 11pt; }
  .pagina-cal .titulo .t1 { font-size: 1.3em; }
  .pagina-cal .titulo .mes { font-size: 1.1em; width: 24%; }
  .cal-titulo { margin-bottom: 10px; }
  .hib { display: flex; gap: 14px; align-items: flex-start; }
  .hib-lista { flex: 1 1 60%; }
  .hib-mini { flex: 0 0 36%; }
  .bloco { display: flex; align-items: center; gap: 10px; padding: 3px 8px; margin-bottom: 4px; border-radius: 4px; border: 1px solid; border-left-width: 5px; }
  .bloco.cor0 { background: #e8f0fb; border-color: #a9c1e6; border-left-color: #6f97d6; color: #1e3a5f; }
  .bloco.cor1 { background: #e6f4ec; border-color: #a5d3b9; border-left-color: #5fae85; color: #1f4d3a; }
  .bc-dias { flex: 0 0 20mm; font-weight: 800; font-size: 1.2em; }
  .bc-sem { flex: 0 0 22mm; font-size: .85em; text-transform: uppercase; letter-spacing: .03em; opacity: .8; border-right: 1px solid rgba(0,0,0,.15); margin-right: 2px; }
  .bc-nome .sep { font-weight: 400; opacity: .35; margin: 0 .6em; }
  .bc-nome { flex: 1 1 0; min-width: 0; font-weight: 700; font-size: 1.1em; }
  .anivs { margin-top: 8px; padding: 5px 8px; background: #fdf5dc; border: 1px solid #e6c886; border-left: 5px solid #e0b050; border-radius: 4px; color: #7a4a14; }
  .anivs-t { font-weight: 800; margin-bottom: 3px; }
  .anivs-i { font-size: .95em; }
  table.mini { width: 100%; table-layout: fixed; }
  table.mini th { background: none; color: #64748b; border: 0; font-size: .85em; padding: 2px; }
  table.mini td { text-align: center; padding: 5px 0; font-weight: 700; font-size: 1.05em; border: 2px solid #fff; border-radius: 4px; color: #94a3b8; }
  table.mini td.sem { color: #94a3b8; font-weight: 500; }
  table.mini td.cor0 { background: #e8f0fb; color: #1e3a5f; box-shadow: inset 0 0 0 1px #a9c1e6; }
  table.mini td.cor1 { background: #e6f4ec; color: #1f4d3a; box-shadow: inset 0 0 0 1px #a5d3b9; }
  table.mini td.aniv { box-shadow: inset 0 0 0 3px #e0b050; }
  .legenda { display: flex; flex-direction: column; gap: 4px; font-size: .85em; margin-top: 10px; color: #334155; }
  .lg { display: inline-block; width: 14px; height: 14px; border-radius: 3px; vertical-align: middle; margin-right: 6px; }
  .lg0 { background: #e8f0fb; border: 1px solid #a9c1e6; } .lg1 { background: #e6f4ec; border: 1px solid #a5d3b9; } .lga { background: #fff; border: 3px solid #e0b050; }
  .rodape { margin-top: 6px; font-size: .8em; color: #475569; text-align: center; }
  @media print {
    body { background: #fff; }
    .toolbar { display: none; }
    .folha { margin: 0; width: auto; }
    /* Navegadores com rodapé de página (Chrome/Edge 131+) já imprimem o rodapé em todas as páginas. */
    html.rodape-de-pagina .rodape { display: none; }
    * { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
  }
</style>

<div class="toolbar">
  <button type="button" onclick="window.print()">🖨 Imprimir / Salvar PDF</button>
  <%= link_to "← Voltar", escala_imprimir_voltar_path(@competencia), class: "sec" %>
  <% if params[:tamanho] == "grande" %>
    <%= link_to "Caber em 1 página", escala_imprimir_path(mes_params), class: "sec" %>
  <% else %>
    <%= link_to "Fonte maior (pode usar 2 páginas)", escala_imprimir_path(mes_params.merge(tamanho: "grande")), class: "sec" %>
  <% end %>
  <span class="dica">Na janela de impressão escolha "Salvar como PDF", papel A4, retrato, e desative "Cabeçalhos e rodapés".</span>
</div>

<div class="folha">
  <table>
    <colgroup>
      <col style="width:6%"><col style="width:11%"><col style="width:8%"><col style="width:23%"><col style="width:36%"><col style="width:16%">
    </colgroup>
    <thead>
      <tr class="titulo">
        <td colspan="5" class="t1">ESCALA MENSAL • MESC</td>
        <td class="mes"><%= mes_nome %></td>
      </tr>
      <tr class="titulo">
        <td colspan="5" class="t2">MINISTÉRIO EXTRAORDINÁRIO DA SAGRADA COMUNHÃO</td>
        <td class="ano"><%= @competencia.ano %></td>
      </tr>
      <tr><th>Dia</th><th>Dia da semana</th><th>Hora</th><th>Celebrante</th><th>MESC</th><th>Proclamação da Palavra</th></tr>
    </thead>
    <tbody>
      <% @dias.each do |dia| %>
        <% fds = dia.data.saturday? || dia.data.sunday? %>
        <% dia.eventos.each_with_index do |ev, i| %>
          <tr class="<%= 'fds' if fds %> <%= 'sep-dia' if i.zero? %>">
            <% if i.zero? %>
              <td class="c dia" rowspan="<%= dia.eventos.size %>"><%= dia.data.day %></td>
              <td class="c sem" rowspan="<%= dia.eventos.size %>"><%= escala_dia_semana(dia.data) %></td>
            <% end %>
            <td class="c hora"><%= ev.horario.strftime("%-H:%M") %></td>
            <td class="c cel"><%= escala_celebrante(ev) %></td>
            <td class="c">
              <% ministros = escala_ministros_do_evento(ev, @meu_id) %>
              <% ministros.each_with_index do |m, k| %><%= " | " if k.positive? %><span class="<%= 'meu' if m[:meu] %>"><%= m[:nome] %></span><% if m[:adoracao] %><span class="adoracao">(Adoração)</span><% end %><% end %>
            </td>
            <td class="c extra"><%= ev.proclamacao_palavra %></td>
          </tr>
        <% end %>
      <% end %>
    </tbody>
  </table>
  <p class="rodape">Sacristia Digital - gerado em <%= l(Time.current, format: "%d/%m/%Y %H:%M") %></p>
</div>

<% blocos = @cal_plantao.values.uniq %>
<% abrev = %w[dom seg ter qua qui sex sáb] %>
<div class="folha pagina-cal">
  <table class="cal-titulo"><tr class="titulo">
    <td class="t1">ESCALA EXTRA • PLANTÕES E ANIVERSARIANTES</td><td class="mes"><%= mes_nome %> <%= @competencia.ano %></td>
  </tr></table>
  <div class="hib">
    <div class="hib-lista">
      <% blocos.each_with_index do |pl, i| %>
        <% d1 = Date.new(@competencia.ano, @competencia.mes, pl.dia_inicio) %>
        <% d2 = Date.new(@competencia.ano, @competencia.mes, pl.dia_fim) %>
        <div class="bloco cor<%= i % 2 %>">
          <div class="bc-dias"><%= pl.dia_inicio == pl.dia_fim ? pl.dia_inicio : "#{pl.dia_inicio} e #{pl.dia_fim}" %></div>
          <div class="bc-sem"><%= pl.dia_inicio == pl.dia_fim ? abrev[d1.wday] : "#{abrev[d1.wday]} – #{abrev[d2.wday]}" %></div>
          <div class="bc-nome"><%= safe_join(pl.ministros.map(&:nome), content_tag(:span, "|", class: "sep")) %></div>
        </div>
      <% end %>
    </div>
    <div class="hib-mini">
      <% inicio = @cal_primeiro.beginning_of_week(:sunday) %>
      <% fim = @cal_primeiro.end_of_month.end_of_week(:sunday) %>
      <table class="mini">
        <thead><tr><% %w[D S T Q Q S S].each do |n| %><th><%= n %></th><% end %></tr></thead>
        <tbody>
          <% (inicio..fim).each_slice(7) do |semana| %>
            <tr>
              <% semana.each do |d| %>
                <% if d.month != @competencia.mes %>
                  <td></td>
                <% else %>
                  <% pl = @cal_plantao[d.day] %>
                  <% cls = [pl ? "cor#{blocos.index(pl) % 2}" : "sem", (@cal_aniversarios[d.day] ? "aniv" : nil)].compact.join(" ") %>
                  <td class="<%= cls %>"><%= d.day %></td>
                <% end %>
              <% end %>
            </tr>
          <% end %>
        </tbody>
      </table>
      <% if @cal_aniversarios.any? %>
        <div class="anivs">
          <div class="anivs-t">🎂 Aniversariantes do mês</div>
          <% @cal_aniversarios.sort.each do |dia, ms| %>
            <% ms.each do |m| %><div class="anivs-i"><strong>Dia <%= dia %></strong> — <%= m.nome %></div><% end %>
          <% end %>
        </div>
      <% end %>
      <div class="legenda">
        <span><i class="lg lg0"></i> Plantão</span>
        <span><i class="lg lg1"></i> Plantão (próximo bloco)</span>
        <span><i class="lg lga"></i> 🎂 Aniversário</span>
      </div>
    </div>
  </div>
</div>
