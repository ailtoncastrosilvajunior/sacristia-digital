<% content_for :title, "Escala de #{@competencia.label}" %>
<% mes_params = { competencia_mensal_id: @competencia.id } %>
<%# Celular: painel entre header e tab bar; só a lista de cards rola. Desktop: altura calculada + calendário lateral. %>
<div class="mx-auto flex w-full max-w-6xl min-h-0 flex-col gap-2 overflow-hidden max-lg:fixed max-lg:inset-x-0 max-lg:top-[calc(3.75rem+env(safe-area-inset-top,0px))] max-lg:bottom-[calc(4.5rem+env(safe-area-inset-bottom,0px))] max-lg:z-0 max-lg:px-3 lg:relative lg:h-[calc(100dvh-11rem)]" <%= 'data-controller=escala-filtro' if @dias.any? %>>
  <header class="flex shrink-0 items-center justify-between gap-3">
    <div class="min-w-0">
      <h1 class="text-xl font-bold tracking-tight text-slate-900 sm:text-2xl">Escala do mês</h1>
      <p class="hidden text-sm text-stone-500 sm:block">Todos os horários e ministros de <%= @competencia.label %>.</p>
    </div>
    <%= link_to ministro_escala_mensal_imprimir_path(mes_params), target: "_blank", rel: "noopener",
          class: "shrink-0 inline-flex items-center gap-1.5 rounded-xl bg-slate-800 px-3 py-2 text-sm font-semibold text-white active:bg-slate-900" do %>
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z"/></svg>
      Imprimir / PDF
    <% end %>
  </header>

  <% if @dias.empty? %>
    <div class="shrink-0 rounded-2xl border border-stone-200 bg-white">
      <%= render "painel_ministro/competencia_picker", comp: @competencia, competencias: @competencias,
            rota: ->(id) { ministro_escala_mensal_path(competencia_mensal_id: id) } %>
    </div>
    <p class="py-8 text-center text-base text-stone-500">Nenhum serviço escalado neste mês.</p>
  <% else %>
    <% por_data = @dias.index_by(&:data) %>
    <div class="flex min-h-0 flex-1 flex-col gap-2 overflow-hidden lg:flex-row lg:gap-4">
      <aside class="flex shrink-0 flex-col gap-2 lg:w-[19rem] xl:w-[21rem] lg:min-h-0 lg:shrink-0 lg:overflow-y-auto lg:overscroll-contain">
        <div class="space-y-2 lg:contents">
          <div class="shrink-0 overflow-hidden rounded-2xl border border-stone-200 bg-white">
            <%= render "painel_ministro/competencia_picker", comp: @competencia, competencias: @competencias, compacto: true,
                  rota: ->(id) { ministro_escala_mensal_path(competencia_mensal_id: id) } %>
          </div>
          <%= render "painel_ministro/escala_mensal/faixa_dias_mobile",
                competencia: @competencia, por_data: por_data,
                dias_meus_celebracao: @dias_meus_celebracao, dias_meus_plantao: @dias_meus_plantao, hoje: @hoje %>
          <div class="flex shrink-0 flex-wrap gap-1.5">
            <% [["todos", "Todos os dias", @dias.size], ["meus", "Minha escala", @dias_meus.size]].each do |chave, rotulo, qtd| %>
              <button type="button" data-escala-filtro-target="botao" data-filtro="<%= chave %>" data-action="escala-filtro#filtrar"
                      class="flex-1 min-w-[calc(50%-0.25rem)] rounded-full px-2.5 py-1.5 text-xs font-semibold ring-1 ring-slate-200 sm:flex-none sm:min-w-0 sm:px-3.5 sm:text-sm <%= chave == 'todos' ? 'bg-sky-600 text-white' : 'bg-white text-slate-700' %>">
                <%= rotulo %> (<%= qtd %>)
              </button>
            <% end %>
          </div>
        </div>
        <div class="hidden lg:block">
          <%= render "painel_ministro/escala_mensal/calendario_mes",
                competencia: @competencia, por_data: por_data,
                dias_meus_celebracao: @dias_meus_celebracao, dias_meus_plantao: @dias_meus_plantao, hoje: @hoje %>
        </div>
      </aside>

      <div data-escala-filtro-target="lista" class="relative min-h-0 flex-1 basis-0 space-y-2 overflow-y-auto overscroll-contain px-0.5 pb-2 pt-0.5 touch-pan-y [-webkit-overflow-scrolling:touch]">
        <% if @trocas_recebidas.any? %>
          <section class="space-y-2 rounded-xl bg-sky-100 p-2.5 ring-1 ring-sky-200 sm:p-3">
            <p class="text-[11px] font-bold uppercase tracking-wider text-sky-800">Pedidos de troca para você (<%= @trocas_recebidas.size %>)</p>
            <% @trocas_recebidas.each do |t| %>
              <% ev = t.evento_escala %>
              <div class="space-y-2 rounded-lg bg-white p-2.5 text-slate-900 sm:p-3">
                <p class="text-sm"><strong><%= t.solicitante.nome %></strong> pede que você assuma:</p>
                <p class="text-sm font-bold sm:text-base"><%= l(ev.data, format: "%A, %d/%m") %> · <span class="tabular-nums text-sky-600"><%= ev.horario.strftime("%-H:%M") %></span>
                  <span class="text-xs font-semibold text-slate-500 sm:text-sm"><%= ev.tipo_servico&.nome %><%= " · #{ev.sacerdote.nome}" if ev.sacerdote %></span></p>
                <% if t.motivo.present? %><p class="text-sm italic text-slate-600">“<%= t.motivo %>”</p><% end %>
                <div class="grid grid-cols-2 gap-2">
                  <%= button_to "Aceitar", aceitar_ministro_solicitacao_troca_path(t), method: :patch, class: "w-full rounded-lg bg-sky-600 px-3 py-2 text-sm font-bold text-white active:bg-sky-700" %>
                  <%= button_to "Recusar", recusar_ministro_solicitacao_troca_path(t), method: :patch, class: "w-full rounded-lg bg-white px-3 py-2 text-sm font-semibold text-slate-800 ring-1 ring-slate-300 active:bg-slate-50" %>
                </div>
              </div>
            <% end %>
          </section>
        <% end %>

        <% @dias.each do |dia| %>
          <% eh_hoje = dia.data == @hoje %>
          <% passado = dia.data < @hoje %>
          <% fds = dia.data.saturday? || dia.data.sunday? %>
          <% meu_miss = @dias_meus_celebracao.include?(dia.data) %>
          <% meu_plant = @dias_meus_plantao.include?(dia.data) %>
          <% meu_dia = meu_miss || meu_plant %>
          <section id="dia-<%= dia.data.day %>" data-escala-filtro-target="dia" data-dia="<%= dia.data.day %>" data-meu="<%= meu_dia %>"
                   class="scroll-mt-1 overflow-hidden rounded-xl bg-white <%= eh_hoje ? 'border-2 border-sky-500 shadow-sm shadow-sky-500/15' : 'border border-slate-200' %> <%= 'opacity-70' if passado %>">
            <div class="flex flex-wrap items-center gap-2 border-b border-slate-100 bg-white px-2.5 py-1 sm:px-3">
              <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg text-base font-extrabold tabular-nums <%= eh_hoje ? 'bg-sky-500 text-white' : (fds ? 'bg-sky-700 text-white' : 'bg-slate-200 text-slate-900') %>"><%= dia.data.day %></span>
              <p class="min-w-0 flex-1 text-sm font-bold capitalize text-slate-900 sm:text-base"><%= escala_dia_semana(dia.data) %></p>
              <div class="flex flex-wrap items-center justify-end gap-1">
                <% if eh_hoje %>
                  <span class="rounded-full bg-sky-500 px-2 py-0.5 text-[10px] font-bold text-white sm:text-xs">Hoje</span>
                <% end %>
                <% if meu_miss %>
                  <span class="rounded-full bg-sky-600 px-2 py-0.5 text-[10px] font-bold text-white sm:text-xs">Você serve</span>
                <% end %>
                <% if meu_plant %>
                  <span class="rounded-full bg-amber-100 px-2 py-0.5 text-[10px] font-bold text-amber-900 ring-1 ring-amber-400 sm:text-xs">Plantão</span>
                <% end %>
              </div>
            </div>

            <ul class="divide-y divide-slate-100">
              <% dia.eventos.each do |ev| %>
                <%= render "painel_ministro/escala_mensal/celebracao", ev: ev, dia: dia %>
              <% end %>

              <% if dia.plantao || dia.extras.any? %>
                <%= render "painel_ministro/escala_mensal/plantao", dia: dia %>
              <% end %>
            </ul>
          </section>
        <% end %>

        <p class="flex flex-wrap items-center justify-center gap-x-3 gap-y-1 pb-1 text-xs text-slate-500 sm:text-sm">
          <span class="inline-flex items-center gap-1.5"><%= image_tag "custodia.png", alt: "", class: "h-4 w-auto" %> adoração</span>
          <span>o 1º da lista coordena</span>
        </p>
      </div>
    </div>
  <% end %>
</div>

<div data-controller="modal">
  <div data-modal-target="backdrop" class="fixed inset-0 z-50 hidden items-end justify-center bg-stone-900/50 p-3 sm:items-center" data-action="click->modal#closeBackground">
    <div data-action="click->modal#stopPropagation" class="w-full max-w-lg">
      <turbo-frame id="servico_modal" data-modal-target="frame" data-action="turbo:frame-load->modal#show turbo:frame-render->modal#show"></turbo-frame>
    </div>
  </div>
</div>
