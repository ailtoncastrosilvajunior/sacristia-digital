<%# locals: competencia, por_data, dias_meus_celebracao, dias_meus_plantao, hoje %>
<% lead = competencia.periodo.wday %>
<div class="rounded-2xl border border-stone-200/90 bg-stone-50/80 p-3 shadow-sm sm:p-3.5">
  <p class="mb-2 text-xs font-semibold text-stone-800">Calendário</p>

  <div class="grid grid-cols-7 gap-1 text-center text-[10px] font-medium text-stone-500">
    <% I18n.t("date.abbr_day_names").each do |nome| %>
      <span class="truncate py-0.5"><%= nome.first(3) %></span>
    <% end %>
  </div>

  <div class="mt-1 grid grid-cols-7 gap-1">
    <% lead.times do %><div aria-hidden="true"></div><% end %>
    <% (competencia.periodo..competencia.periodo_fim).each do |d| %>
      <% dia = por_data[d] %>
      <% eh_hoje = d == hoje %>
      <% meu_miss = dias_meus_celebracao.include?(d) %>
      <% meu_plant = dias_meus_plantao.include?(d) %>
      <% meu = meu_miss || meu_plant %>
      <% tem_escala = dia.present? %>
      <% titulo_partes = [l(d, format: :long)] %>
      <% titulo_partes << "você serve na missa" if meu_miss %>
      <% titulo_partes << "seu extra" if meu_plant %>
      <% titulo_partes << "escala geral" if tem_escala && !meu %>
      <% titulo = titulo_partes.join(" · ") %>
      <% num_cls = "text-[13px] tabular-nums leading-none sm:text-sm" %>
      <% num_cls += meu ? " font-bold text-stone-900" : (tem_escala ? " font-medium text-stone-700" : (eh_hoje ? " font-semibold text-sky-700" : " font-normal text-stone-300")) %>
      <% cell = "flex min-h-[2.6rem] flex-col items-center justify-center gap-1 rounded-xl px-0.5 py-1 transition-colors lg:min-h-[2.85rem]" %>
      <% cell += eh_hoje ? " bg-white ring-2 ring-sky-500/80 shadow-sm" : " bg-white/90" %>
      <% cell += (tem_escala || meu_plant) ? " hover:bg-white active:bg-stone-100 ring-1 ring-stone-200/90" : "" %>
      <% dot_par = !meu && tem_escala %>
      <% dot_miss = meu_miss %>
      <% dot_plant = meu_plant %>
      <% tem_marcador = dot_par || dot_miss || dot_plant %>

      <% if tem_escala || meu_plant %>
        <%= link_to "#dia-#{d.day}",
              data: { escala_filtro_target: "celula", action: "click->escala-filtro#irParaDia", dia: d.day, hoje: eh_hoje.to_s, meu: meu.to_s },
              class: cell,
              title: titulo,
              aria: { label: titulo } do %>
          <span class="<%= num_cls %>"><%= d.day %></span>
          <% if tem_marcador %>
            <span class="flex h-2 items-center justify-center gap-1" aria-hidden="true">
              <% if dot_par %><span class="h-1.5 w-1.5 shrink-0 rounded-full bg-stone-400"></span><% end %>
              <% if dot_miss %><span class="h-2 w-2 shrink-0 rounded-full bg-sky-600" title="Missa"></span><% end %>
              <% if dot_plant %><span class="h-2 w-2 shrink-0 rounded-full bg-orange-500" title="Extra"></span><% end %>
            </span>
          <% else %>
            <span class="h-2" aria-hidden="true"></span>
          <% end %>
        <% end %>
      <% else %>
        <div class="<%= cell %>" title="<%= titulo %>">
          <span class="<%= num_cls %>"><%= d.day %></span>
          <span class="h-2" aria-hidden="true"></span>
        </div>
      <% end %>
    <% end %>
  </div>

  <div class="mt-3 flex flex-wrap gap-x-3 gap-y-1.5 border-t border-stone-200/80 pt-2.5 text-[10px] text-stone-600">
    <span class="inline-flex items-center gap-1.5"><span class="h-1.5 w-1.5 rounded-full bg-stone-400"></span> Geral</span>
    <span class="inline-flex items-center gap-1.5"><span class="h-2 w-2 rounded-full bg-sky-600"></span> Sua missa</span>
    <span class="inline-flex items-center gap-1.5"><span class="h-2 w-2 rounded-full bg-orange-500"></span> Extra</span>
    <span class="inline-flex items-center gap-1.5">
      <span class="inline-flex gap-0.5"><span class="h-2 w-2 rounded-full bg-sky-600"></span><span class="h-2 w-2 rounded-full bg-orange-500"></span></span>
      Missa/Extra
    </span>
  </div>
</div>
