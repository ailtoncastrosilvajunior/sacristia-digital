<% content_for :title, "Lançamento ##{@lancamento.id}" %>
<% lc = @lancamento %>
<% entrada = lc.entrada? %>
<% cor = entrada ? "#059669" : "#dc2626" %>
<% volta = admin_lancamentos_caixa_index_path(mes: lc.data.month, ano: lc.data.year) %>
<% campo = "rounded-xl border border-stone-200/90 bg-gradient-to-b from-white to-stone-50/90 px-4 py-3 shadow-sm" %>
<% rotulo = "text-[10px] font-bold uppercase tracking-wider text-stone-400" %>
<% valor_txt = "mt-1 text-sm font-semibold text-stone-900" %>
<% btn_sec = "inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-xl border border-stone-300 bg-white text-stone-700 hover:bg-stone-50 text-sm font-semibold transition-colors shadow-sm" %>

<div class="space-y-5 max-w-4xl">
  <div class="relative overflow-hidden rounded-2xl border border-stone-200/90 bg-white shadow-md shadow-stone-900/5 ring-1 ring-stone-100">
    <div class="absolute inset-x-0 top-0 h-1" style="background-color: <%= cor %>;" aria-hidden="true"></div>
    <div class="absolute inset-0 opacity-[0.07]" style="background: linear-gradient(135deg, <%= cor %> 0%, transparent 50%);" aria-hidden="true"></div>

    <div class="relative px-5 py-5 sm:px-6 sm:py-6">
      <div class="flex flex-col sm:flex-row sm:items-start gap-5">
        <div class="flex flex-col items-center justify-center shrink-0 w-[4.75rem] rounded-2xl border border-stone-200/90 bg-white shadow-sm py-3 tabular-nums">
          <span class="text-[10px] font-bold uppercase tracking-widest text-stone-400"><%= I18n.t("date.abbr_day_names")[lc.data.wday] %></span>
          <span class="text-3xl font-extrabold leading-none text-stone-800"><%= lc.data.day.to_s.rjust(2, "0") %></span>
          <span class="text-[10px] font-semibold uppercase text-stone-500 mt-1"><%= I18n.l(lc.data, format: "%b %Y") %></span>
        </div>

        <div class="min-w-0 flex-1">
          <p class="text-[10px] font-semibold tracking-[0.18em] uppercase text-stone-400">Lançamento de caixa</p>
          <h1 class="mt-1 text-xl sm:text-2xl font-bold text-stone-900 tracking-tight">Lançamento #<%= lc.id %></h1>
          <div class="mt-2 flex flex-wrap items-center gap-2">
            <%= badge_natureza_lancamento(lc.natureza) %>
            <% if lc.status == "confirmado" %>
              <span class="inline-flex px-2.5 py-0.5 text-[10px] font-bold uppercase tracking-wide rounded-full border border-emerald-200 bg-emerald-50 text-emerald-800">Confirmado</span>
            <% else %>
              <span class="inline-flex px-2.5 py-0.5 text-[10px] font-bold uppercase tracking-wide rounded-full border border-stone-200 bg-stone-100 text-stone-600">Estornado</span>
            <% end %>
            <% if lc.tem_documento_fiscal? %>
              <span class="inline-flex px-2 py-0.5 text-[10px] font-semibold rounded-md border border-stone-200 bg-white text-stone-600">NFe</span>
            <% end %>
            <% if lc.tem_recibo? %>
              <span class="inline-flex px-2 py-0.5 text-[10px] font-semibold rounded-md border border-stone-200 bg-white text-stone-600">Recibo</span>
            <% end %>
          </div>
          <p class="mt-3 text-2xl sm:text-3xl font-bold tabular-nums <%= entrada ? "text-emerald-700" : "text-red-700" %>">
            <%= formatar_moeda(lc.valor_com_sinal) %>
          </p>
          <p class="mt-1 text-sm text-stone-500 capitalize"><%= l(lc.data, format: "%A, %d de %B de %Y") %></p>
        </div>

        <div class="flex flex-wrap sm:flex-col gap-2 shrink-0 sm:items-stretch sm:min-w-[9rem]">
          <% if lc.status == "confirmado" %>
            <%= link_to "Editar", edit_admin_lancamentos_caixa_path(lc), class: "inline-flex items-center justify-center px-4 py-2.5 rounded-xl bg-sky-600 hover:bg-sky-700 text-white text-sm font-semibold transition-colors shadow-sm" %>
            <%= button_to "Estornar", estornar_admin_lancamentos_caixa_path(lc), method: :post, class: "inline-flex items-center justify-center px-4 py-2.5 rounded-xl border border-red-200 bg-red-50 text-red-700 hover:bg-red-100 text-sm font-semibold transition-colors", data: { turbo_confirm: "Estornar este lançamento?" } %>
          <% end %>
          <%= link_to volta, class: btn_sec do %>
            <svg class="w-4 h-4 text-stone-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/></svg>
            Voltar
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <section class="rounded-2xl border border-stone-200/90 bg-white shadow-md shadow-stone-900/5 overflow-hidden ring-1 ring-stone-100">
    <div class="px-5 py-3.5 border-b border-stone-100 bg-gradient-to-b from-white to-stone-50/90">
      <h2 class="text-sm font-semibold text-stone-900">Dados do movimento</h2>
      <p class="text-[11px] text-stone-500 mt-0.5">Conta, contraparte e observações</p>
    </div>
    <div class="p-5 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
      <div class="<%= campo %>">
        <p class="<%= rotulo %>">Conta corrente</p>
        <p class="<%= valor_txt %>"><%= lc.conta_corrente.nome %></p>
      </div>
      <div class="<%= campo %>">
        <p class="<%= rotulo %>">Valor total</p>
        <p class="<%= valor_txt %> tabular-nums"><%= formatar_moeda(lc.valor_total) %></p>
      </div>
      <div class="<%= campo %>">
        <p class="<%= rotulo %>">Natureza</p>
        <p class="<%= valor_txt %>"><%= entrada ? "Entrada" : "Saída" %></p>
      </div>
      <% if lc.contado_por.present? %>
        <div class="<%= campo %>">
          <p class="<%= rotulo %>">Contado por</p>
          <p class="<%= valor_txt %>"><%= lc.contado_por %></p>
        </div>
      <% end %>
      <% if lc.fornecedor.present? %>
        <div class="<%= campo %> sm:col-span-2">
          <p class="<%= rotulo %>">Fornecedor</p>
          <p class="<%= valor_txt %>"><%= lc.fornecedor %></p>
        </div>
      <% end %>
      <% if lc.evento_escala.present? %>
        <div class="<%= campo %> sm:col-span-2 lg:col-span-3">
          <p class="<%= rotulo %>">Evento da escala</p>
          <p class="<%= valor_txt %>">
            <%= l(lc.evento_escala.data) %> <%= lc.evento_escala.horario.strftime("%H:%M") %>
            — <%= lc.evento_escala.tipo_servico.nome %>
          </p>
        </div>
      <% end %>
      <% if lc.observacoes.present? %>
        <div class="<%= campo %> sm:col-span-2 lg:col-span-3">
          <p class="<%= rotulo %>">Observações</p>
          <p class="mt-1 text-sm text-stone-700 whitespace-pre-wrap leading-relaxed"><%= lc.observacoes %></p>
        </div>
      <% end %>
    </div>
  </section>

  <section class="rounded-2xl border border-stone-200/90 bg-white shadow-md shadow-stone-900/5 overflow-hidden ring-1 ring-stone-100">
    <div class="px-5 py-3.5 border-b border-stone-100 bg-gradient-to-b from-white to-stone-50/90">
      <h2 class="text-sm font-semibold text-stone-900">Itens</h2>
      <p class="text-[11px] text-stone-500 mt-0.5"><%= lc.itens_lancamento.size %> <%= lc.itens_lancamento.size == 1 ? "linha" : "linhas" %> no plano de contas</p>
    </div>

    <div class="overflow-x-auto">
      <table class="min-w-full text-sm">
        <thead class="bg-stone-50/90 text-[10px] font-bold uppercase tracking-wider text-stone-500 border-b border-stone-100">
          <tr>
            <th class="px-5 py-3 text-left font-bold">Conta</th>
            <th class="px-4 py-3 text-left font-bold">Descrição</th>
            <th class="px-4 py-3 text-right font-bold whitespace-nowrap">Desconto</th>
            <th class="px-5 py-3 text-right font-bold whitespace-nowrap">Valor</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-stone-100">
          <% lc.itens_lancamento.each do |item| %>
            <tr class="hover:bg-stone-50/60 transition-colors">
              <td class="px-5 py-3 text-stone-800 font-medium"><%= item.plano_conta.label_completo %></td>
              <td class="px-4 py-3 text-stone-600"><%= item.descricao.presence || "—" %></td>
              <td class="px-4 py-3 text-right tabular-nums text-stone-500 whitespace-nowrap">
                <%= item.valor_desconto.to_d.positive? ? formatar_moeda(item.valor_desconto) : "—" %>
              </td>
              <td class="px-5 py-3 text-right tabular-nums font-semibold text-stone-900 whitespace-nowrap"><%= formatar_moeda(item.valor) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <div class="px-5 py-3.5 border-t border-stone-200 bg-stone-50/90 flex flex-wrap items-center justify-end gap-x-3 gap-y-2">
      <span class="text-[10px] font-bold uppercase tracking-wider text-stone-500">Valor total do lançamento</span>
      <span class="text-lg font-bold tabular-nums <%= entrada ? "text-emerald-800" : "text-red-800" %>"><%= formatar_moeda(lc.valor_total) %></span>
    </div>
  </section>
</div>
