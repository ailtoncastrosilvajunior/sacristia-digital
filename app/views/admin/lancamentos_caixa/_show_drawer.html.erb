<%# Detalhes do lançamento no drawer lateral (turbo-frame lancamento_drawer). %>
<turbo-frame id="lancamento_drawer" data-action="turbo:frame-load->drawer#open" class="flex flex-col h-full min-h-0 bg-white">
  <% lc = @lancamento %>
  <% volta = @return_to.presence %>
  <% lote_esportula = lc.lote_pagamento_esportula %>
  <% cor = lc.entrada? ? "#059669" : "#dc2626" %>
  <% campo = "rounded-xl border border-stone-200/90 bg-gradient-to-b from-white to-stone-50/90 px-3 py-2.5 shadow-sm" %>
  <% rotulo = "text-[10px] font-bold uppercase tracking-wider text-stone-400" %>
  <% valor = "mt-1 text-sm font-semibold text-stone-900" %>

  <header class="relative shrink-0 overflow-hidden border-b border-stone-200">
    <div class="absolute inset-0 opacity-[0.1]" style="background: linear-gradient(135deg, <%= cor %> 0%, transparent 55%);" aria-hidden="true"></div>
    <div class="absolute top-0 left-0 right-0 h-1" style="background-color: <%= cor %>;" aria-hidden="true"></div>
    <div class="relative flex gap-3 px-4 py-4 sm:px-5">
      <div class="flex flex-col items-center justify-center shrink-0 w-[4.25rem] rounded-2xl border border-stone-200/90 bg-white/90 shadow-sm py-2.5 tabular-nums">
        <span class="text-[10px] font-bold uppercase tracking-widest text-stone-400"><%= I18n.t("date.abbr_day_names")[lc.data.wday] %></span>
        <span class="text-2xl font-extrabold leading-none text-stone-800"><%= lc.data.day %></span>
        <span class="text-[10px] font-semibold uppercase text-stone-500 mt-0.5"><%= I18n.t("date.abbr_month_names")[lc.data.month] %></span>
      </div>
      <div class="min-w-0 flex-1 pt-0.5">
        <div class="flex items-start justify-between gap-2">
          <p class="text-[10px] font-semibold tracking-[0.18em] uppercase text-stone-400">Lançamento #<%= lc.id %></p>
          <button type="button" data-action="click->drawer#close" class="shrink-0 -mt-1 p-1.5 rounded-lg text-stone-400 hover:text-stone-600 hover:bg-white/80 transition-colors" aria-label="Fechar">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
          </button>
        </div>
        <div class="mt-1 flex flex-wrap items-center gap-2">
          <%= badge_natureza_lancamento(lc.natureza) %>
          <% if lc.status == "confirmado" %>
            <span class="inline-flex px-2 py-0.5 text-[10px] font-bold uppercase tracking-wide rounded-full border border-emerald-200 bg-emerald-50 text-emerald-800">Confirmado</span>
          <% else %>
            <span class="inline-flex px-2 py-0.5 text-[10px] font-bold uppercase tracking-wide rounded-full border border-stone-200 bg-stone-100 text-stone-600">Estornado</span>
          <% end %>
        </div>
        <p class="mt-2 text-lg font-bold tabular-nums <%= lc.entrada? ? "text-emerald-700" : "text-red-700" %>">
          <%= formatar_moeda(lc.valor_com_sinal) %>
        </p>
        <p class="mt-0.5 text-xs text-stone-500 capitalize"><%= l(lc.data, format: "%A, %d de %B de %Y") %></p>
      </div>
    </div>
  </header>

  <div class="flex-1 min-h-0 overflow-y-auto overscroll-contain px-4 py-4 sm:px-5 space-y-4">
    <div class="grid grid-cols-2 gap-2.5">
      <div class="<%= campo %>">
        <p class="<%= rotulo %>">Conta corrente</p>
        <p class="<%= valor %>"><%= lc.conta_corrente.nome %></p>
      </div>
      <div class="<%= campo %>">
        <p class="<%= rotulo %>">Valor total</p>
        <p class="<%= valor %> tabular-nums"><%= formatar_moeda(lc.valor_total) %></p>
      </div>
      <% if lc.contado_por.present? %>
        <div class="<%= campo %> col-span-2">
          <p class="<%= rotulo %>">Contado por</p>
          <p class="<%= valor %>"><%= lc.contado_por %></p>
        </div>
      <% end %>
      <% if lc.fornecedor.present? %>
        <div class="<%= campo %> col-span-2">
          <p class="<%= rotulo %>">Fornecedor</p>
          <p class="<%= valor %>"><%= lc.fornecedor %></p>
        </div>
      <% end %>
      <% if lc.observacoes.present? %>
        <div class="<%= campo %> col-span-2">
          <p class="<%= rotulo %>">Observações</p>
          <p class="mt-1 text-sm text-stone-700 whitespace-pre-wrap"><%= lc.observacoes %></p>
        </div>
      <% end %>
    </div>

    <div>
      <h2 class="text-xs font-bold uppercase tracking-wider text-stone-500 mb-2">Itens do plano de contas</h2>
      <div class="rounded-xl border border-stone-200 overflow-hidden">
        <table class="w-full text-sm">
          <thead class="bg-stone-50 text-[10px] font-bold uppercase tracking-wider text-stone-500">
            <tr>
              <th class="px-3 py-2 text-left">Conta</th>
              <th class="px-3 py-2 text-left">Descrição</th>
              <th class="px-3 py-2 text-right">Desconto</th>
              <th class="px-3 py-2 text-right">Valor</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-stone-100">
            <% lc.itens_lancamento.each do |item| %>
              <tr>
                <td class="px-3 py-2 text-stone-800"><%= item.plano_conta.label_completo %></td>
                <td class="px-3 py-2 text-stone-600"><%= item.descricao.presence || "—" %></td>
                <td class="px-3 py-2 text-right tabular-nums text-stone-500"><%= item.valor_desconto.to_d.positive? ? formatar_moeda(item.valor_desconto) : "—" %></td>
                <td class="px-3 py-2 text-right tabular-nums font-medium"><%= formatar_moeda(item.valor) %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <footer class="shrink-0 border-t border-stone-200 px-4 py-3 sm:px-5 space-y-2 bg-stone-50/80">
    <% if lote_esportula.present? && lc.status == "confirmado" %>
      <p class="text-[10px] text-amber-900 leading-snug bg-amber-50 border border-amber-200/80 rounded-lg px-2.5 py-1.5">
        Lançamento de <strong>lote acumulado</strong>. Estornar aqui só marca o caixa; para desfazer o pagamento na escala, use <strong>Estornar lote</strong> em Espórtulas.
      </p>
    <% end %>
    <div class="flex flex-wrap gap-2">
      <%= link_to "Abrir página completa",
            admin_lancamentos_caixa_path(lc, **(volta ? { return_to: volta } : {})),
            class: "inline-flex flex-1 min-w-[8rem] items-center justify-center px-3 py-2.5 rounded-xl border border-stone-300 bg-white text-stone-700 hover:bg-stone-50 text-sm font-semibold transition-colors",
            data: { turbo_frame: "_top" } %>
      <% if lc.status == "confirmado" %>
        <% edit_opts = volta ? { return_to: volta } : {} %>
        <%= link_to "Editar",
              edit_admin_lancamentos_caixa_path(lc, **edit_opts),
              class: "inline-flex flex-1 min-w-[6rem] items-center justify-center px-3 py-2.5 rounded-xl bg-sky-600 hover:bg-sky-700 text-white text-sm font-semibold transition-colors",
              data: { turbo_frame: "_top" } %>
        <% estorno_confirm = lote_esportula.present? ? "Estornar este lançamento no caixa? O lote de espórtulas continuará marcado como pago até você estornar o lote." : "Estornar este lançamento? Ele deixa de entrar no extrato e nos totais." %>
        <%= button_to "Estornar",
              estornar_admin_lancamentos_caixa_path(lc, **(volta ? { return_to: volta } : {})),
              method: :post,
              class: "inline-flex flex-1 min-w-[6rem] items-center justify-center px-3 py-2.5 rounded-xl border border-red-200 bg-red-50 text-red-700 hover:bg-red-100 text-sm font-semibold transition-colors",
              data: { turbo_confirm: estorno_confirm, turbo_frame: "_top" } %>
      <% end %>
    </div>
  </footer>
</turbo-frame>
