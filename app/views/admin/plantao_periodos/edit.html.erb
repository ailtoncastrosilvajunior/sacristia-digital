<div class="space-y-6">
  <div class="flex flex-wrap items-start justify-between gap-3">
    <div>
      <%= link_to "← Plantão extra", admin_competencia_mensal_plantao_periodos_path(@competencia), class: "text-sm text-stone-500 hover:text-stone-700 mb-2 block" %>
      <h1 class="text-2xl font-semibold text-stone-800">Editar bloco de plantão</h1>
      <p class="text-stone-500 mt-1"><%= @competencia.label %> · <%= @plantao.rotulo %></p>
    </div>
    <%= link_to plantao_extra_cartaz_path(@plantao), target: "_blank", rel: "noopener",
          class: "inline-flex items-center gap-2 px-4 py-2 text-sm font-semibold rounded-lg bg-sky-600 hover:bg-sky-700 text-white transition-colors" do %>
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
      Notificação
    <% end %>
    <%= button_to admin_competencia_mensal_plantao_periodo_path(@competencia, @plantao), method: :delete,
          data: { turbo_confirm: "Remover o bloco #{@plantao.rotulo}? Os eventos extras ligados a ele ficam sem plantão." },
          class: "inline-flex items-center gap-2 px-3 py-2 text-sm font-medium rounded-lg border border-red-200 text-red-700 hover:bg-red-50 transition-colors cursor-pointer bg-white" do %>
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
      Excluir bloco
    <% end %>
  </div>
  <div class="bg-white rounded-xl border border-stone-200 shadow-sm p-6 max-w-5xl">
    <%= render "form", plantao: @plantao, url: admin_competencia_mensal_plantao_periodo_path(@competencia, @plantao), method: :patch %>
  </div>
</div>
