<% disponiveis = Ministro.ativos.ordenados_por_nome.to_a %>
<% escalados = Ministro.where(id: plantao.ministro_ids).to_a.sort_by { |m| plantao.ministro_ids.index(m.id) } %>
<% recarregar_url = plantao.persisted? ? edit_admin_competencia_mensal_plantao_periodo_path(@competencia, plantao) : new_admin_competencia_mensal_plantao_periodo_path(@competencia) %>
<% ministros_json = (disponiveis + escalados).uniq.map { |m| { id: m.id, nome: m.nome } }.to_json %>
<div data-controller="escalar-ministros"
     data-escalar-ministros-roles-value="false"
     data-escalar-ministros-url-value="<%= recarregar_url %>"
     data-escalar-ministros-field-name-value="plantao_periodo[ministro_ids][]"
     data-escalar-ministros-ministros-data-value="<%= h ministros_json %>">
  <%= form_with model: plantao, url: url, method: method, data: { escalar_ministros_target: "form" }, html: { class: "space-y-6" } do |f| %>
    <% if plantao.errors.any? %>
      <div class="rounded-lg bg-red-50 p-4 text-red-800 text-sm">
        <ul class="list-disc list-inside">
          <% plantao.errors.full_messages.each do |msg| %><li><%= msg %></li><% end %>
        </ul>
      </div>
    <% end %>

    <div class="grid grid-cols-2 gap-4 max-w-md">
      <div>
        <%= f.label :dia_inicio, "Do dia", class: "block text-sm font-medium text-stone-700 mb-1" %>
        <%= f.number_field :dia_inicio, min: 1, max: @competencia.periodo_fim.day, class: "w-full px-4 py-2.5 rounded-lg border border-stone-300 focus:ring-2 focus:ring-slate-500/20 focus:border-slate-500" %>
      </div>
      <div>
        <%= f.label :dia_fim, "Até o dia", class: "block text-sm font-medium text-stone-700 mb-1" %>
        <%= f.number_field :dia_fim, min: 1, max: @competencia.periodo_fim.day, class: "w-full px-4 py-2.5 rounded-lg border border-stone-300 focus:ring-2 focus:ring-slate-500/20 focus:border-slate-500" %>
      </div>
    </div>

    <%# Garante o envio da lista vazia quando todos os ministros forem removidos %>
    <%= hidden_field_tag "plantao_periodo[ministro_ids][]", "", id: nil %>
    <div data-ministro-ids-container></div>

    <%= render "admin/shared/ministros_picker",
          disponiveis: disponiveis,
          escalados: escalados,
          roles: false,
          recarregar: true,
          titulo: "Ministros de plantão",
          titulo_escalados: "No plantão",
          vazio_titulo: "Arraste ministros para cá",
          vazio_texto: "Solte aqui os ministros de plantão deste bloco de dias." %>

    <div class="flex gap-3 pt-2 border-t border-stone-200/80">
      <%= f.submit "Salvar", class: "px-4 py-2.5 bg-slate-600 hover:bg-slate-700 text-white font-medium rounded-lg transition-colors cursor-pointer" %>
      <%= link_to "Cancelar", admin_competencia_mensal_plantao_periodos_path(@competencia), class: "px-4 py-2.5 border border-stone-300 text-stone-700 hover:bg-stone-50 font-medium rounded-lg transition-colors" %>
    </div>
  <% end %>
</div>
