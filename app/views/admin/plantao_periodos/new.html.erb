<div class="space-y-6">
  <div>
    <%= link_to "← Plantão extra", admin_competencia_mensal_plantao_periodos_path(@competencia), class: "text-sm text-stone-500 hover:text-stone-700 mb-2 block" %>
    <h1 class="text-2xl font-semibold text-stone-800">Novo bloco de plantão</h1>
    <p class="text-stone-500 mt-1"><%= @competencia.label %></p>
  </div>
  <div class="bg-white rounded-xl border border-stone-200 shadow-sm p-6 max-w-5xl">
    <%= render "form", plantao: @plantao, url: admin_competencia_mensal_plantao_periodos_path(@competencia), method: :post %>
  </div>
</div>
