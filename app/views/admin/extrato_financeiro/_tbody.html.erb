<%# locals: grupos, return_to (optional) %>
<% icon_btn = "inline-flex items-center justify-center w-6 h-6 rounded text-slate-400 hover:text-sky-700 hover:bg-sky-50 transition-colors" %>
<% grupos.each_with_index do |grupo, group_idx| %>
  <% if group_idx.positive? %>
    <tr aria-hidden="true" class="pointer-events-none">
      <td colspan="4" class="h-0 p-0 border-0">
        <div class="h-px bg-slate-200/90"></div>
      </td>
    </tr>
  <% end %>

  <% rowspan = grupo.linhas.size + 1 %>
  <% grupo.linhas.each_with_index do |linha, idx| %>
    <% lc = linha.lancamento %>
    <% detalhe = extrato_detalhe_conferencia(lc, titulo: linha.descricao) %>
    <tr class="hover:bg-slate-50/80 group/row">
      <% if idx.zero? %>
        <td rowspan="<%= rowspan %>" class="align-top border-r border-slate-100 bg-slate-50/50 px-1.5 py-1.5 text-center w-[6.5rem] sm:w-[7.5rem]">
          <div class="flex flex-col items-center gap-0.5 rounded-lg py-1 ring-1 ring-slate-200/70 bg-white">
            <span class="text-sm sm:text-base font-bold tabular-nums leading-tight text-slate-900">
              <%= format("%02d", grupo.data.day) %><span class="text-[10px] font-semibold text-slate-500">/<%= grupo.data.year %></span>
            </span>
            <span class="text-[9px] font-semibold uppercase tracking-wide text-slate-500"><%= l(grupo.data, format: "%a") %></span>
            <span class="mt-0.5 block w-full border-t border-dashed border-slate-200 pt-1 px-0.5 text-[9px] leading-tight space-y-0.5">
              <% if grupo.total_entradas.positive? %>
                <span class="block tabular-nums text-emerald-700 font-medium">+ <%= formatar_moeda(grupo.total_entradas) %></span>
              <% end %>
              <% if grupo.total_saidas.positive? %>
                <span class="block tabular-nums text-red-700 font-medium">− <%= formatar_moeda(grupo.total_saidas) %></span>
              <% end %>
              <span class="block tabular-nums font-bold text-slate-800 pt-0.5 border-t border-slate-200/80"><%= formatar_moeda(grupo.total_liquido) %></span>
            </span>
          </div>
        </td>
      <% end %>
      <td class="px-3 py-1.5 align-middle min-w-0">
        <div class="min-w-0 leading-tight">
          <p class="text-[13px] font-medium text-slate-800 truncate" title="<%= linha.descricao %>"><%= linha.descricao %></p>
          <% evento = lc.natureza == "entrada" ? lc.evento_escala : nil %>
          <% if evento %>
            <% horario = evento.horario.respond_to?(:strftime) ? evento.horario.strftime("%H:%M") : evento.horario.to_s.first(5) %>
            <% info_evento = [horario.presence && "Missa às #{horario}", evento.sacerdote && "Sacerdote: #{evento.sacerdote.nome}"].compact.join(" · ") %>
            <% if info_evento.present? %>
              <p class="text-[10px] text-sky-700 mt-0.5 truncate" title="<%= info_evento %>"><%= info_evento %></p>
            <% end %>
          <% end %>
          <% if detalhe.present? %>
            <p class="text-[10px] text-slate-500 mt-0.5 line-clamp-2 whitespace-pre-wrap break-words" title="<%= detalhe %>"><%= detalhe %></p>
          <% end %>
        </div>
      </td>
      <td class="px-2 py-1.5 text-right tabular-nums whitespace-nowrap align-middle text-[13px] font-medium <%= linha.valor_com_sinal.positive? ? "text-emerald-700" : "text-red-700" %>">
        <div class="inline-flex items-center justify-end gap-0.5 max-w-full">
          <span class="opacity-0 group-hover/row:opacity-100 focus-within:opacity-100 transition-opacity flex items-center shrink-0">
            <%= link_to admin_lancamentos_caixa_path(lc),
                  data: { turbo_frame: "lancamento_drawer" },
                  title: "Detalhes",
                  aria: { label: "Detalhes do lançamento ##{lc.id}" },
                  class: icon_btn do %>
              <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
              </svg>
            <% end %>
            <% if lc.status == "confirmado" %>
              <% edit_opts = return_to.present? ? { return_to: return_to } : {} %>
              <%= link_to edit_admin_lancamentos_caixa_path(lc, **edit_opts),
                    data: { turbo_frame: "_top" },
                    title: "Editar",
                    aria: { label: "Editar lançamento ##{lc.id}" },
                    class: icon_btn do %>
                <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
                </svg>
              <% end %>
            <% end %>
          </span>
          <span class="shrink-0"><%= formatar_moeda(linha.valor_com_sinal) %></span>
        </div>
      </td>
      <td class="px-3 py-1.5 text-right tabular-nums text-[13px] font-medium whitespace-nowrap align-middle text-slate-800"><%= formatar_moeda(linha.saldo_apos) %></td>
    </tr>
  <% end %>

  <tr class="bg-stone-50/90 text-[11px] font-semibold text-stone-600 border-t border-stone-200">
    <td class="px-3 py-1.5 text-right uppercase tracking-wide">Total do dia</td>
    <td class="px-2 py-1.5 text-right tabular-nums <%= grupo.total_liquido.positive? ? "text-emerald-800" : grupo.total_liquido.negative? ? "text-red-800" : "text-stone-700" %>">
      <%= formatar_moeda(grupo.total_liquido) %>
    </td>
    <td class="px-3 py-1.5 text-right tabular-nums text-stone-900"><%= formatar_moeda(grupo.saldo_final) %></td>
  </tr>
<% end %>
