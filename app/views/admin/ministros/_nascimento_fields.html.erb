<% campo = "w-full px-3 py-2.5 rounded-lg border border-stone-300 focus:ring-2 focus:ring-slate-500/20 focus:border-slate-500" %>
<fieldset class="rounded-lg border border-stone-200 p-4 space-y-3">
  <legend class="px-1 text-sm font-medium text-stone-700">Data de nascimento</legend>
  <div class="grid grid-cols-3 gap-3">
    <div>
      <%= f.label :nascimento_dia, "Dia *", class: "block text-xs text-stone-500 mb-1" %>
      <%= f.number_field :nascimento_dia, in: 1..31, class: campo, placeholder: "DD" %>
    </div>
    <div>
      <%= f.label :nascimento_mes, "Mês *", class: "block text-xs text-stone-500 mb-1" %>
      <%= f.select :nascimento_mes, (1..12).map { |m| [I18n.l(Date.new(2000, m, 1), format: "%B").capitalize, m] },
                   { include_blank: "—" }, class: campo %>
    </div>
    <div>
      <%= f.label :nascimento_ano, "Ano (opcional)", class: "block text-xs text-stone-500 mb-1" %>
      <%= f.number_field :nascimento_ano, in: NascimentoParcial::ANO_MINIMO..Date.current.year, class: campo, placeholder: "AAAA" %>
    </div>
  </div>
  <div class="flex items-start">
    <%= f.check_box :exibir_ano_nascimento, class: "mt-0.5 rounded border-stone-300 text-slate-600 focus:ring-slate-500" %>
    <%= f.label :exibir_ano_nascimento, "Autorizo divulgar o ano de nascimento", class: "ml-2 text-sm text-stone-700" %>
  </div>
  <p class="text-xs text-stone-500">
    Dia e mês aparecem na lista de aniversariantes. O ano é opcional e só será divulgado se autorizado;
    caso contrário, fica visível apenas para a coordenação.
  </p>
</fieldset>
