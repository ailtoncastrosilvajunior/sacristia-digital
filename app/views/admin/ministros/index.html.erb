<div class="space-y-6">
  <div class="flex items-center justify-between">
    <div>
      <h1 class="text-2xl font-semibold text-stone-800">Ministros</h1>
      <p class="text-stone-500 mt-1">Gerencie os ministros MESC</p>
    </div>
    <%= link_to "Novo ministro", new_admin_ministro_path,
        class: "px-4 py-2 bg-slate-600 hover:bg-slate-700 text-white font-medium rounded-lg transition-colors" %>
  </div>

  <%= render layout: "admin/shared/list_toolbar", locals: { placeholder: "Buscar por nome, email ou telefone..." } do %>
    <%= filtro_select :status, "Status", [["Ativo", "ativo"], ["Inativo", "inativo"]] %>
    <%= filtro_select :sexo, "Sexo", Ministro::SEXOS.map { |s| [s, s] } %>
  <% end %>

  <%= render layout: "admin/shared/list_frame", locals: { collection: @ministros } do %>
    <% if @ministros.any? %>
      <div class="flex flex-col gap-2 p-3 bg-stone-50">
        <% @ministros.each do |ministro| %>
          <div class="bg-white rounded-lg border border-stone-200 shadow-sm hover:border-slate-300 transition px-3 py-2 flex flex-wrap sm:flex-nowrap items-center gap-x-4 gap-y-1 <%= 'opacity-70' unless ministro.ativo? %>">
            <div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-slate-100 text-slate-600 text-sm font-semibold">
              <%= ministro.nome.to_s.strip.first.to_s.upcase %>
            </div>
            <div class="min-w-0 flex-1 sm:flex-none sm:w-56">
              <%= link_to ministro.nome, admin_ministro_path(ministro), class: "block truncate text-sm text-slate-700 hover:text-slate-900 font-semibold" %>
              <p class="text-xs text-stone-500 leading-tight"><%= ministro.sexo %></p>
            </div>
            <div class="order-last sm:order-none basis-full sm:basis-auto sm:flex-1 min-w-0 flex flex-col sm:flex-row sm:gap-6 text-xs text-stone-600">
              <span class="truncate sm:w-56"><%= ministro.email.presence || "—" %></span>
              <span class="truncate"><%= ministro.telefone.presence || "—" %></span>
            </div>
            <span class="inline-flex px-2 py-0.5 text-xs font-medium rounded-full <%= ministro.ativo? ? 'bg-emerald-100 text-emerald-800' : 'bg-stone-100 text-stone-600' %>">
              <%= ministro.ativo? ? "Ativo" : "Inativo" %>
            </span>
            <div class="flex items-center gap-0.5">
          <%= link_to admin_ministro_path(ministro), title: "Ver detalhes", class: "p-1.5 rounded-lg text-stone-400 hover:text-slate-600 hover:bg-stone-100 transition-colors" do %>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>
          <% end %>
          <%= link_to edit_admin_ministro_path(ministro), title: "Editar", class: "p-1.5 rounded-lg text-stone-400 hover:text-sky-600 hover:bg-sky-50 transition-colors" do %>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
          <% end %>
          <%= button_to admin_ministro_path(ministro), method: :delete, data: { turbo_confirm: "Tem certeza que deseja excluir este ministro?" }, form: { class: "inline" }, title: "Excluir", class: "p-1.5 rounded-lg text-stone-400 hover:text-red-600 hover:bg-red-50 transition-colors border-0 bg-transparent cursor-pointer" do %>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
          <% end %>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="px-6 py-12 text-center text-stone-500">
        <% if lista_filtrada?(:status, :sexo) %>
          Nenhum resultado encontrado para a busca/filtros informados.
        <% else %>
          Nenhum ministro cadastrado. <%= link_to "Cadastrar o primeiro", new_admin_ministro_path, class: "text-slate-600 hover:text-slate-800" %>
        <% end %>
      </div>
    <% end %>
  <% end %>
</div>
