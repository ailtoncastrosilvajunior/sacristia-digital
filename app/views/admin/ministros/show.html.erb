<% content_for :title, "#{@ministro.nome} — Ministros" %>
<% servicos_ct = @ministro.evento_escalas.count %>
<% confirmados_ct = @ministro.escala_ministros.where(confirmado: true).count %>
<% plantoes_ct = @ministro.plantao_periodos.count %>

<div class="space-y-3">
  <div class="flex flex-wrap items-start justify-between gap-2">
    <div class="min-w-0">
      <%= link_to "← Ministros", admin_ministros_path, class: "text-xs text-stone-500 hover:text-stone-700" %>
      <div class="flex flex-wrap items-center gap-2">
        <h1 class="text-xl font-semibold text-stone-900 tracking-tight"><%= @ministro.nome %></h1>
        <% if @ministro.sexo.present? %><span class="text-sm text-stone-500"><%= @ministro.sexo %></span><% end %>
        <span class="inline-flex px-2 py-0.5 text-xs font-semibold rounded-full border <%= @ministro.ativo? ? "bg-emerald-100 text-emerald-800 border-emerald-300" : "bg-stone-100 text-stone-600 border-stone-200" %>">
          <%= @ministro.ativo? ? "Ativo" : "Inativo" %>
        </span>
      </div>
      <% if @ministro.nome_completo.present? %>
        <p class="text-sm text-stone-500"><%= @ministro.nome_completo %></p>
      <% end %>
      <p class="text-sm text-stone-600 break-all">
        <%= @ministro.email %><% if @ministro.telefone.present? %> · <span class="tabular-nums"><%= @ministro.telefone %></span><% end %>
      </p>
    </div>
    <div class="flex items-center gap-1.5 shrink-0">
      <%= link_to "Novo", new_admin_ministro_path, class: "px-2.5 py-1.5 bg-emerald-600 hover:bg-emerald-700 text-white text-sm font-medium rounded-lg transition-colors" %>
      <%= link_to "Editar", edit_admin_ministro_path(@ministro), class: "px-2.5 py-1.5 bg-slate-600 hover:bg-slate-700 text-white text-sm font-medium rounded-lg transition-colors" %>
      <%= button_to "Excluir", admin_ministro_path(@ministro), method: :delete, data: { turbo_confirm: "Tem certeza que deseja excluir este ministro?" },
          class: "px-2.5 py-1.5 border border-red-200 text-red-700 hover:bg-red-50 text-sm font-medium rounded-lg bg-white cursor-pointer" %>
    </div>
  </div>

  <div class="grid grid-cols-3 gap-2">
    <div class="rounded-lg bg-white px-3 py-2 ring-1 ring-stone-200/80" title="Celebrações em que entrou na escala">
      <p class="text-[10px] font-semibold uppercase tracking-wider text-stone-500">Serviços</p>
      <p class="text-xl font-bold tabular-nums text-sky-800"><%= servicos_ct %></p>
    </div>
    <div class="rounded-lg bg-white px-3 py-2 ring-1 ring-stone-200/80" title="Presença confirmada na escala">
      <p class="text-[10px] font-semibold uppercase tracking-wider text-stone-500">Confirmados</p>
      <p class="text-xl font-bold tabular-nums text-emerald-700"><%= confirmados_ct %></p>
    </div>
    <div class="rounded-lg bg-white px-3 py-2 ring-1 ring-stone-200/80" title="Blocos de plantão extra (todas as competências)">
      <p class="text-[10px] font-semibold uppercase tracking-wider text-stone-500">Plantões</p>
      <p class="text-xl font-bold tabular-nums text-sky-700"><%= plantoes_ct %></p>
    </div>
  </div>

  <% if @ministro.observacoes.present? %>
    <div class="bg-white rounded-lg border border-stone-200 px-4 py-3">
      <h2 class="text-xs font-semibold text-stone-900 mb-1">Observações</h2>
      <div class="text-stone-800 text-sm leading-relaxed"><%= simple_format(@ministro.observacoes) %></div>
    </div>
  <% end %>

  <div class="bg-white rounded-lg border border-stone-200 px-4 py-3">
    <h2 class="text-xs font-semibold text-stone-900 mb-2">Últimos serviços</h2>
    <% if @ministro.evento_escalas.any? %>
      <table class="min-w-full text-sm">
        <tbody class="divide-y divide-stone-100">
          <% @ministro.evento_escalas.includes(:tipo_servico, :escala_ministros).order(data: :desc).limit(10).each do |evento| %>
            <tr>
              <td class="py-1.5 text-stone-900 font-medium"><%= evento.tipo_servico.nome %></td>
              <td class="py-1.5 text-stone-600 tabular-nums text-center"><%= l(evento.data, format: :short) %></td>
              <td class="py-1.5 text-right">
                <% em = evento.escala_ministros.find { |x| x.ministro_id == @ministro.id } %>
                <% if em&.confirmado? %>
                  <span class="inline-flex px-2 py-0.5 text-xs font-semibold rounded-full bg-emerald-100 text-emerald-800 border border-emerald-200">Confirmado</span>
                <% elsif em %>
                  <span class="inline-flex px-2 py-0.5 text-xs font-semibold rounded-full bg-amber-100 text-amber-800 border border-amber-200">Pendente</span>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <p class="text-sm text-stone-500 text-center py-3">Nenhum serviço registrado</p>
    <% end %>
  </div>
</div>
