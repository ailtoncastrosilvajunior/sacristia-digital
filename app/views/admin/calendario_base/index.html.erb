<div class="space-y-6">
  <div class="flex items-center justify-between">
    <div>
      <h1 class="text-2xl font-semibold text-stone-800">Calendário Base</h1>
      <p class="text-stone-500 mt-1">Horários fixos das missas e celebrações</p>
    </div>
    <%= link_to "Nova entrada", new_admin_calendario_base_path,
        class: "px-4 py-2 bg-slate-600 hover:bg-slate-700 text-white font-medium rounded-lg transition-colors" %>
  </div>

  <%= render layout: "admin/shared/list_toolbar", locals: { placeholder: "Buscar por sacerdote..." } do %>
    <%= filtro_select :status, "Status", [["Inativos", "inativo"], ["Todos", "todos"]], todos: "Somente ativos" %>
    <%= filtro_select :dia_da_semana, "Dia da semana", (0..6).map { |d| [I18n.l(Date.new(2024, 1, 7) + d, format: "%A").capitalize, d] } %>
    <%= filtro_select :tipo, "Tipo", CalendarioBase.tipos.keys.map { |t| [I18n.t("activerecord.attributes.calendario_base.tipo.#{t}"), t] } %>
  <% end %>

  <%= render layout: "admin/shared/list_frame", locals: { collection: @calendario_base } do %>
    <% hoje = Date.current.wday %>
    <div data-controller="agenda-nav" data-agenda-nav-initial-date-value="<%= hoje %>"
         style="height: calc(100vh - 12rem); min-height: 480px;"
         class="flex gap-3 w-full bg-gradient-to-b from-slate-50/90 to-white overflow-hidden">
      <%# Coluna 1: dias da semana %>
      <nav class="w-20 sm:w-24 shrink-0 overflow-y-auto border-r border-slate-200/80 bg-slate-50/80 p-2 space-y-1.5" aria-label="Dias da semana">
        <% (0..6).each do |dia| %>
          <% qtd = (@por_dia[dia] || []).size %>
          <button type="button" data-agenda-nav-target="data" data-data="<%= dia %>" data-action="agenda-nav#ir"
                  class="w-full flex flex-col items-center rounded-xl border border-slate-200 bg-white text-slate-700 px-1 py-2.5 shadow-sm hover:border-sky-300 transition-colors cursor-pointer">
            <span class="text-sm font-extrabold uppercase tracking-wider"><%= I18n.t("date.abbr_day_names")[dia] %></span>
            <span class="mt-1 text-[10px] font-semibold px-1.5 rounded-full bg-slate-200/70 text-slate-600"><%= qtd %></span>
            <% if dia == hoje %><span class="mt-1 text-[9px] font-bold uppercase text-sky-600">hoje</span><% end %>
          </button>
        <% end %>
      </nav>

      <%# Coluna 2: cards extensos, um por celebração %>
      <div data-agenda-nav-target="lista" data-action="scroll->agenda-nav#marcar" class="flex-1 min-w-0 overflow-y-auto pr-3 py-3 space-y-5">
        <% (0..6).each do |dia| %>
          <% itens = @por_dia[dia] || [] %>
          <% nome = I18n.l(Date.new(2024, 1, 7) + dia, format: "%A").capitalize %>
          <section data-agenda-nav-target="secao" data-data="<%= dia %>">
            <div class="sticky top-0 z-10 py-1.5 mb-2 flex items-center gap-3 bg-slate-50">
              <span class="text-base font-extrabold <%= dia == hoje ? 'text-sky-700' : 'text-sky-900' %>"><%= nome %></span>
              <% if dia == hoje %><span class="px-2 py-0.5 rounded-full text-[10px] font-bold uppercase bg-sky-600 text-white">Hoje</span><% end %>
              <span class="h-px flex-1 bg-sky-200"></span>
              <span class="text-xs font-semibold text-sky-700"><%= pluralize(itens.size, "celebração", "celebrações") %></span>
              <%= link_to new_admin_calendario_base_path(dia_da_semana: dia), title: "Adicionar em #{nome}", class: "p-1 rounded-lg text-stone-400 hover:text-sky-600 hover:bg-sky-50 transition-colors" do %>
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
              <% end %>
            </div>

            <% if itens.empty? %>
              <%= link_to "Nenhuma celebração · adicionar", new_admin_calendario_base_path(dia_da_semana: dia), class: "flex items-center justify-center h-12 rounded-xl border-2 border-dashed border-stone-300 text-sm text-stone-400 hover:text-sky-600 hover:border-sky-300 transition-colors" %>
            <% else %>
              <ul class="space-y-2">
                <% itens.each do |cb| %>
                  <% missa = cb.tipo_missa? %>
                  <% proclamadores = cb.proclamacao_palavra.to_s.split(/[\n;,]+/).map(&:strip).reject(&:blank?) %>
                  <li class="group relative rounded-xl bg-white shadow-sm hover:shadow-md transition-shadow ring-1 ring-stone-200 overflow-hidden px-4 py-2.5 <%= cb.ativo? ? '' : 'opacity-60' %>">
                    <%# Linha 1: horário · tipo · sacerdote · pagamento · ministros · valor · ações %>
                    <div class="flex flex-wrap items-center gap-x-3 gap-y-1 pl-1">
                      <span class="text-lg font-bold text-stone-800 tabular-nums w-14 shrink-0"><%= l(cb.horario, format: :time) %></span>
                      <span class="inline-flex px-2 py-0.5 text-[11px] font-semibold rounded-full shrink-0 <%= missa ? 'bg-amber-100 text-amber-800' : 'bg-sky-100 text-sky-700' %>"><%= I18n.t("activerecord.attributes.calendario_base.tipo.#{cb.tipo}") %></span>

                      <span class="flex items-center justify-center w-7 h-7 shrink-0 rounded-full bg-slate-100 text-slate-600 text-xs font-bold ring-1 ring-slate-200"><%= (cb.sacerdote&.nome || "?")[0].upcase %></span>
                      <p class="flex-1 min-w-0 text-sm font-medium text-stone-800 truncate" title="<%= cb.sacerdote&.nome %>"><%= cb.sacerdote&.nome || "Sem sacerdote" %><%= " · Inativo" unless cb.ativo? %></p>

                      <% if cb.esportula_acumulado? %>
                        <span class="inline-flex max-w-48 truncate text-[10px] font-semibold px-1.5 py-0.5 rounded bg-slate-200/80 text-slate-800 ring-1 ring-slate-300/80 shrink-0" title="Pagamento acumulado">Acum.<%= " #{cb.destinatario_esportula.nome}" if cb.destinatario_esportula.present? %></span>
                      <% else %>
                        <span class="inline-flex text-[10px] font-medium px-1.5 py-0.5 rounded bg-stone-100 text-stone-600 ring-1 ring-stone-200/80 shrink-0">Imediato</span>
                      <% end %>

                      <span class="inline-flex items-center gap-1 text-xs text-stone-600 shrink-0" title="<%= pluralize(cb.quantidade_ministros, 'ministro') %>">
                        <svg class="w-3.5 h-3.5 text-stone-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/></svg><span class="font-semibold"><%= cb.quantidade_ministros %></span>
                      </span>
                      <% if cb.valor_esportula_override.present? %>
                        <span class="inline-flex px-1.5 py-0.5 rounded-md bg-emerald-50 text-emerald-700 text-xs font-semibold shrink-0"><%= number_to_currency(cb.valor_esportula_override, unit: "R$ ", separator: ",", delimiter: ".") %></span>
                      <% else %>
                        <span class="text-xs text-stone-400 shrink-0">—</span>
                      <% end %>

                      <div class="flex items-center gap-0.5 shrink-0">
                        <%= link_to admin_calendario_base_path(cb), title: "Ver detalhes", class: "p-1.5 text-stone-400 hover:text-slate-600" do %><svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg><% end %>
                      <%= link_to edit_admin_calendario_base_path(cb), title: "Editar", class: "p-1.5 text-stone-400 hover:text-sky-600" do %><svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg><% end %>
                      <%= button_to admin_calendario_base_path(cb), method: :delete, data: { turbo_confirm: "Tem certeza que deseja excluir esta entrada?" }, form: { class: "inline" }, title: "Excluir", class: "p-1.5 text-stone-400 hover:text-red-600 border-0 bg-transparent cursor-pointer" do %><svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg><% end %>
                      </div>
                    </div>

                    <%# Linha 2: proclamação da palavra %>
                    <div class="mt-1.5 pl-1 flex items-center gap-1.5 flex-wrap min-w-0">
                      <svg class="w-3.5 h-3.5 text-amber-600/80 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/></svg>
                      <span class="text-[10px] font-bold uppercase tracking-widest text-stone-400 mr-1">Palavra</span>
                      <% if proclamadores.any? %>
                        <% proclamadores.each do |p| %>
                          <span class="inline-flex px-2 py-0.5 rounded-full bg-amber-50 text-xs font-medium text-stone-700 ring-1 ring-amber-200"><%= p %></span>
                        <% end %>
                      <% else %>
                        <span class="text-xs text-stone-400">não definida</span>
                      <% end %>
                    </div>
                  </li>
                <% end %>
              </ul>
            <% end %>
          </section>
        <% end %>
      </div>
    </div>

    <% if @calendario_base.empty? && lista_filtrada?(:status, :dia_da_semana, :tipo) %>
      <div class="px-6 py-6 text-center text-stone-500 border-t border-stone-200">Nenhum resultado encontrado para a busca/filtros informados.</div>
    <% end %>
  <% end %>
</div>
