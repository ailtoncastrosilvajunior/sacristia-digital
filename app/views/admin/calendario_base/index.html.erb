<div class="space-y-6">
  <div class="flex items-center justify-between">
    <div>
      <h1 class="text-2xl font-semibold text-stone-800">Calendário Base</h1>
      <p class="text-stone-500 mt-1">Horários fixos das missas e celebrações</p>
    </div>
    <%= link_to "Nova entrada", new_admin_calendario_base_path,
        class: "px-4 py-2 bg-slate-600 hover:bg-slate-700 text-white font-medium rounded-lg transition-colors" %>
  </div>

  <%= render layout: "admin/shared/list_toolbar", locals: { placeholder: "Buscar por sacerdote..." } do %>
    <%= filtro_select :status, "Status", [["Inativos", "inativo"], ["Todos", "todos"]], todos: "Somente ativos" %>
    <%= filtro_select :dia_da_semana, "Dia da semana", (0..6).map { |d| [I18n.l(Date.new(2024, 1, 7) + d, format: "%A").capitalize, d] } %>
    <%= filtro_select :tipo, "Tipo", CalendarioBase.tipos.keys.map { |t| [I18n.t("activerecord.attributes.calendario_base.tipo.#{t}"), t] } %>
  <% end %>

  <%= render layout: "admin/shared/list_frame", locals: { collection: @calendario_base } do %>
    <% hoje = Date.current.wday %>
    <div class="grid grid-cols-1 md:grid-cols-4 xl:grid-cols-7 divide-y md:divide-y-0 md:divide-x divide-stone-200 min-w-0">
      <% (0..6).each do |dia| %>
        <% itens = @por_dia[dia] || [] %>
        <% nome = I18n.l(Date.new(2024, 1, 7) + dia, format: "%A").capitalize %>
        <div class="flex flex-col min-h-48 <%= dia == hoje ? 'bg-sky-50/40' : '' %>">
          <div class="flex items-center justify-between px-3 py-2.5 border-b border-stone-200 bg-stone-50 sticky top-0">
            <div>
              <p class="text-sm font-semibold <%= dia == hoje ? 'text-sky-700' : 'text-stone-800' %>"><%= nome %></p>
              <p class="text-xs text-stone-500"><%= pluralize(itens.size, "evento") %><%= " · hoje" if dia == hoje %></p>
            </div>
            <%= link_to new_admin_calendario_base_path(dia_da_semana: dia), title: "Adicionar em #{nome}", class: "p-1.5 rounded-lg text-stone-400 hover:text-sky-600 hover:bg-sky-50 transition-colors" do %>
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
            <% end %>
          </div>

          <div class="p-2 space-y-2 flex-1">
            <% itens.each do |cb| %>
              <% missa = cb.tipo_missa? %>
              <div class="group relative rounded-lg border bg-white p-2.5 shadow-sm hover:shadow transition-shadow <%= missa ? 'border-amber-300' : 'border-sky-300' %> <%= cb.ativo? ? '' : 'opacity-60' %>">
                <div class="flex items-start justify-between gap-2">
                  <span class="text-base font-semibold text-stone-800"><%= l(cb.horario, format: :time) %></span>
                  <span class="inline-flex px-2 py-0.5 text-[11px] font-medium rounded-full <%= missa ? 'bg-amber-100 text-amber-800' : 'bg-sky-50 text-sky-700' %>">
                    <%= I18n.t("activerecord.attributes.calendario_base.tipo.#{cb.tipo}") %>
                  </span>
                </div>
                <p class="mt-1 text-xs text-stone-600 truncate" title="<%= cb.sacerdote&.nome %>"><%= cb.sacerdote&.nome || "Sem sacerdote" %></p>
                <% if cb.esportula_acumulado? %>
                  <p class="mt-0.5 text-[10px] font-semibold text-violet-800 truncate" title="<%= cb.destinatario_esportula&.nome %>">
                    Acum.<%= " · #{cb.destinatario_esportula.nome}" if cb.destinatario_esportula %>
                  </p>
                <% end %>
                <div class="mt-2 pt-2 border-t border-stone-100 flex items-center justify-between gap-2 whitespace-nowrap">
                  <span class="inline-flex items-center gap-1 text-xs text-stone-600" title="<%= pluralize(cb.quantidade_ministros, 'ministro') %>">
                    <svg class="w-3.5 h-3.5 text-stone-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
                    <span class="font-semibold"><%= cb.quantidade_ministros %></span>
                  </span>
                  <% if cb.valor_esportula_override.present? %>
                    <span class="inline-flex items-center px-1.5 py-0.5 rounded-md bg-emerald-50 text-emerald-700 text-xs font-semibold" title="Espórtula padrão">
                      <%= number_to_currency(cb.valor_esportula_override, unit: "R$ ", separator: ",", delimiter: ".") %>
                    </span>
                  <% else %>
                    <span class="text-xs text-stone-400">—</span>
                  <% end %>
                </div>
                <% unless cb.ativo? %><p class="mt-1 text-[11px] font-medium text-stone-500">Inativo</p><% end %>
                <div class="absolute top-1.5 right-1.5 hidden group-hover:flex items-center gap-0.5 bg-white/95 rounded-lg border border-stone-200 shadow-sm">
                  <%= link_to admin_calendario_base_path(cb), title: "Ver detalhes", class: "p-1.5 text-stone-400 hover:text-slate-600" do %>
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>
                  <% end %>
                  <%= link_to edit_admin_calendario_base_path(cb), title: "Editar", class: "p-1.5 text-stone-400 hover:text-sky-600" do %>
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
                  <% end %>
                  <%= button_to admin_calendario_base_path(cb), method: :delete, data: { turbo_confirm: "Tem certeza que deseja excluir esta entrada?" }, form: { class: "inline" }, title: "Excluir", class: "p-1.5 text-stone-400 hover:text-red-600 border-0 bg-transparent cursor-pointer" do %>
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
                  <% end %>
                </div>
              </div>
            <% end %>

            <% if itens.empty? %>
              <%= link_to new_admin_calendario_base_path(dia_da_semana: dia), class: "flex items-center justify-center h-20 rounded-lg border border-dashed border-stone-300 text-xs text-stone-400 hover:text-sky-600 hover:border-sky-300 transition-colors" do %>
                + Adicionar
              <% end %>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>

    <% if @calendario_base.empty? && lista_filtrada?(:status, :dia_da_semana, :tipo) %>
      <div class="px-6 py-6 text-center text-stone-500 border-t border-stone-200">Nenhum resultado encontrado para a busca/filtros informados.</div>
    <% end %>
  <% end %>
</div>
