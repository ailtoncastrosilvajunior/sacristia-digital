<turbo-frame id="plano_conta_drawer" data-action="turbo:frame-load->drawer#open" class="flex flex-col h-full min-h-0 bg-white">
  <div class="flex items-start justify-between gap-3 px-4 py-4 border-b border-stone-200 shrink-0">
    <div class="min-w-0">
      <h2 class="text-base font-semibold text-stone-800">
        <%= @plano_conta.persisted? ? "Alterar conta" : "Nova conta" %>
      </h2>
      <% if @plano_conta.conta_pai.present? %>
        <p class="text-xs text-stone-500 mt-1 truncate" title="<%= @plano_conta.conta_pai.label_completo %>">
          Subconta de <%= @plano_conta.conta_pai.label_completo %>
        </p>
      <% elsif @plano_conta.persisted? && @plano_conta.conta_pai_id.blank? %>
        <p class="text-xs text-stone-500 mt-1">Conta de primeiro nível</p>
      <% end %>
    </div>
    <button type="button" data-action="drawer#close" class="shrink-0 p-1.5 rounded-lg text-stone-400 hover:text-stone-600 hover:bg-stone-100 transition-colors" aria-label="Fechar">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
    </button>
  </div>
  <div class="flex-1 overflow-y-auto p-4">
    <%= render "form", drawer: true, index_params: @index_params %>
  </div>
</turbo-frame>
