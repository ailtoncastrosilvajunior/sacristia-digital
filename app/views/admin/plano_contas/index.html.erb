<% content_for :title, "Plano de contas" %>
<% filtro_ativo = params[:q].present? || params[:natureza].present? %>
<% btn_toolbar = "inline-flex items-center gap-1.5 px-3 py-2 text-xs font-semibold rounded-lg border border-slate-200 bg-white text-slate-700 hover:bg-slate-50 transition-colors" %>
<% index_params = @index_params %>

<div class="space-y-6" data-controller="plano-contas-tree drawer">
  <div data-drawer-target="overlay" class="fixed inset-0 z-40 bg-stone-900/30 transition-opacity duration-300 invisible opacity-0 pointer-events-none" data-action="click->drawer#closeOverlay"></div>
  <div data-drawer-target="panel" class="fixed top-0 right-0 z-50 h-full w-full sm:w-[min(100%,32rem)] lg:w-[28rem] bg-white shadow-2xl shadow-stone-900/10 transform transition-transform duration-300 ease-out translate-x-full border-l border-stone-200 flex flex-col">
    <turbo-frame id="plano_conta_drawer" data-action="turbo:frame-load->drawer#open" class="flex flex-col h-full min-h-0"></turbo-frame>
  </div>

  <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
    <div>
      <h1 class="text-2xl font-semibold text-stone-800">Plano de contas</h1>
      <p class="text-stone-500 mt-1"><%= pluralize(@total_contas, "conta") %> · estrutura hierárquica</p>
    </div>
    <%= link_to new_admin_plano_conta_path(**index_params),
          data: { turbo_frame: "plano_conta_drawer" },
          class: "inline-flex shrink-0 items-center justify-center px-4 py-2 bg-slate-600 hover:bg-slate-700 text-white font-medium rounded-lg transition-colors" do %>
      Nova conta
    <% end %>
  </div>

  <div class="rounded-2xl border border-slate-200/90 bg-white shadow-md shadow-slate-900/5 ring-1 ring-slate-100 px-3 py-3 sm:px-4">
    <div class="flex flex-col lg:flex-row lg:items-end gap-3">
      <%= form_with url: admin_plano_contas_path, method: :get, local: true, class: "flex flex-wrap gap-2 flex-1 items-end" do %>
        <div class="flex-1 min-w-[12rem]">
          <label for="plano_q" class="block text-[10px] font-bold uppercase tracking-wider text-slate-500 mb-1">Buscar</label>
          <%= text_field_tag :q, params[:q], id: "plano_q", placeholder: "Código ou nome…", class: "w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm font-medium text-slate-800 shadow-sm focus:outline-none focus:ring-2 focus:ring-sky-500/30 focus:border-sky-500" %>
        </div>
        <div class="min-w-[10rem]">
          <label for="plano_natureza" class="block text-[10px] font-bold uppercase tracking-wider text-slate-500 mb-1">Natureza</label>
          <%= select_tag :natureza, options_for_select([["Todas", ""], ["Receitas", "receita"], ["Despesas", "despesa"]], params[:natureza]), id: "plano_natureza", class: "w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm font-medium text-slate-800 shadow-sm focus:outline-none focus:ring-2 focus:ring-sky-500/30 focus:border-sky-500" %>
        </div>
        <button type="submit" class="inline-flex items-center gap-1.5 px-3 py-2 text-sm font-semibold rounded-lg bg-slate-800 text-white hover:bg-slate-900 transition-colors shadow-sm">
          <svg class="w-4 h-4 opacity-90" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
          Filtrar
        </button>
        <% if filtro_ativo %>
          <%= link_to "Limpar", admin_plano_contas_path, class: "inline-flex items-center px-3 py-2 text-sm font-medium rounded-lg border border-slate-300 text-slate-700 hover:bg-slate-50" %>
        <% end %>
      <% end %>

      <div class="flex flex-wrap gap-2 shrink-0">
        <button type="button" data-action="plano-contas-tree#expandAll" class="<%= btn_toolbar %>">
          Expandir tudo
        </button>
        <button type="button" data-action="plano-contas-tree#collapseAll" class="<%= btn_toolbar %>">
          Recolher
        </button>
      </div>
    </div>
  </div>

  <%= render "arvore", raizes: @raizes, contas_por_pai: @contas_por_pai, total_contas: @total_contas, filtro_ativo: filtro_ativo, index_params: index_params %>
</div>
