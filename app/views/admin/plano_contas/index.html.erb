<% content_for :title, "Plano de contas" %>
<% filtro_ativo = params[:q].present? || params[:natureza].present? %>
<% btn_hero = "inline-flex h-8 items-center gap-1.5 rounded-lg border border-white/20 bg-white/10 px-2.5 text-xs font-semibold text-white hover:bg-white/15 transition-colors" %>

<div class="space-y-4 sm:space-y-5" data-controller="plano-contas-tree">
  <% actions = capture do %>
    <%= link_to new_admin_plano_conta_path, class: btn_hero do %>
      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
      Nova conta
    <% end %>
    <%= link_to admin_extrato_financeiro_path, class: btn_hero do %>
      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"/></svg>
      Extrato
    <% end %>
  <% end %>
  <%= render "admin/shared/financeiro/hero",
        eyebrow: "Financeiro",
        title: "Plano de contas",
        subtitle: "#{@total_contas} contas · estrutura hierárquica",
        actions: actions %>

  <div class="rounded-2xl border border-slate-200/90 bg-white shadow-md shadow-slate-900/5 ring-1 ring-slate-100 px-3 py-3 sm:px-4">
    <div class="flex flex-col lg:flex-row lg:items-end gap-3">
      <%= form_with url: admin_plano_contas_path, method: :get, local: true, class: "flex flex-wrap gap-2 flex-1 items-end" do %>
        <div class="flex-1 min-w-[12rem]">
          <label for="plano_q" class="block text-[10px] font-bold uppercase tracking-wider text-slate-500 mb-1">Buscar</label>
          <%= text_field_tag :q, params[:q], id: "plano_q", placeholder: "Código ou nome…", class: "w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm font-medium text-slate-800 shadow-sm focus:outline-none focus:ring-2 focus:ring-sky-500/30 focus:border-sky-500" %>
        </div>
        <div class="min-w-[10rem]">
          <label for="plano_natureza" class="block text-[10px] font-bold uppercase tracking-wider text-slate-500 mb-1">Natureza</label>
          <%= select_tag :natureza, options_for_select([["Todas", ""], ["Receitas", "receita"], ["Despesas", "despesa"]], params[:natureza]), id: "plano_natureza", class: "w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm font-medium text-slate-800 shadow-sm focus:outline-none focus:ring-2 focus:ring-sky-500/30 focus:border-sky-500" %>
        </div>
        <button type="submit" class="inline-flex items-center gap-1.5 px-3 py-2 text-sm font-semibold rounded-lg bg-slate-800 text-white hover:bg-slate-900 transition-colors shadow-sm">
          <svg class="w-4 h-4 opacity-90" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
          Filtrar
        </button>
        <% if filtro_ativo %>
          <%= link_to "Limpar", admin_plano_contas_path, class: "inline-flex items-center px-3 py-2 text-sm font-medium rounded-lg border border-slate-300 text-slate-700 hover:bg-slate-50" %>
        <% end %>
      <% end %>

      <div class="flex gap-2 shrink-0">
        <button type="button" data-action="plano-contas-tree#expandAll" class="px-3 py-2 text-xs font-semibold rounded-lg border border-slate-200 bg-white text-slate-700 hover:bg-slate-50">
          Expandir tudo
        </button>
        <button type="button" data-action="plano-contas-tree#collapseAll" class="px-3 py-2 text-xs font-semibold rounded-lg border border-slate-200 bg-white text-slate-700 hover:bg-slate-50">
          Recolher
        </button>
      </div>
    </div>
  </div>

  <div class="rounded-2xl border border-slate-200/90 bg-white shadow-md shadow-slate-900/5 overflow-hidden ring-1 ring-slate-100">
    <% if @raizes.empty? %>
      <p class="px-6 py-12 text-center text-slate-500 text-sm">Nenhuma conta encontrada.</p>
    <% else %>
      <div class="px-2 py-2 sm:px-3 border-b border-slate-100 bg-gradient-to-b from-white to-slate-50/90">
        <div class="hidden sm:grid grid-cols-[1fr_auto] gap-4 px-10 py-1 text-[10px] font-bold uppercase tracking-wider text-slate-500">
          <span>Conta</span>
          <span class="w-16 text-right">Ações</span>
        </div>
      </div>
      <div class="px-1 py-2 sm:px-2 max-h-[calc(100dvh-18rem)] overflow-y-auto overscroll-contain">
        <% @raizes.each do |raiz| %>
          <%= render "no_arvore", conta: raiz, contas_por_pai: @contas_por_pai, depth: 0, filtro_ativo: filtro_ativo %>
        <% end %>
      </div>
    <% end %>
  </div>
</div>
