<%# locals: conta, contas_por_pai, depth: 0, filtro_ativo: false %>
<% depth = local_assigns[:depth] || 0 %>
<% filhos = (contas_por_pai[conta.id] || []).sort_by(&:codigo) %>
<% tem_filhos = filhos.any? %>
<% filtro_ativo = local_assigns[:filtro_ativo] %>

<div
  data-plano-contas-tree-target="branch"
  data-depth="<%= depth %>"
  data-expanded="<%= filtro_ativo || depth < 1 ? 'true' : 'false' %>"
  class="select-none"
>
  <div class="group flex items-center gap-2 py-2.5 pr-3 rounded-lg hover:bg-stone-50 transition-colors border-b border-stone-100/80 last:border-0"
       style="padding-left: <%= 0.75 + depth * 1.25 %>rem">
    <% if tem_filhos %>
      <button type="button"
              data-action="plano-contas-tree#toggle"
              class="shrink-0 flex items-center justify-center w-7 h-7 rounded-md text-stone-500 hover:bg-stone-200/80 hover:text-stone-800 transition-colors"
              aria-label="Expandir ou recolher">
        <svg data-plano-contas-tree-target="chevron" class="w-4 h-4 transition-transform duration-200 <%= 'rotate-90' if filtro_ativo || depth < 1 %>" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
        </svg>
      </button>
    <% else %>
      <span class="w-7 h-7 shrink-0 flex items-center justify-center">
        <span class="w-1.5 h-1.5 rounded-full <%= conta.sintetica? ? 'bg-stone-300' : 'bg-sky-400' %>"></span>
      </span>
    <% end %>

    <div class="min-w-0 flex-1 flex flex-col sm:flex-row sm:items-center gap-1 sm:gap-3">
      <div class="flex items-center gap-2 min-w-0">
        <span class="font-mono text-xs sm:text-sm font-semibold text-stone-500 tabular-nums shrink-0"><%= conta.codigo %></span>
        <span class="font-medium text-stone-900 truncate <%= 'text-base' if depth.zero? %>"><%= conta.nome %></span>
      </div>
      <div class="flex flex-wrap items-center gap-1.5 shrink-0">
        <%= badge_natureza_plano(conta) if depth.zero? %>
        <%= badge_tipo_plano(conta) %>
        <% unless conta.ativo? %>
          <span class="text-[10px] font-medium text-stone-400 uppercase">Inativa</span>
        <% end %>
      </div>
    </div>

    <%= link_to "Editar", edit_admin_plano_conta_path(conta),
          class: "shrink-0 text-xs font-semibold text-sky-700 opacity-0 group-hover:opacity-100 focus:opacity-100 hover:text-sky-900 transition-opacity px-2 py-1 rounded-md hover:bg-sky-50" %>
  </div>

  <% if tem_filhos %>
    <div data-plano-contas-tree-target="children"
         class="<%= 'hidden' unless filtro_ativo || depth < 1 %> ml-2 border-l border-stone-200/90">
      <% filhos.each do |filho| %>
        <%= render "no_arvore", conta: filho, contas_por_pai: contas_por_pai, depth: depth + 1, filtro_ativo: filtro_ativo %>
      <% end %>
    </div>
  <% end %>
</div>
