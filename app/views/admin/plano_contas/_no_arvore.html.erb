<%# locals: conta, contas_por_pai, depth: 0, filtro_ativo: false, index_params: {} %>
<% depth = local_assigns[:depth] || 0 %>
<% filhos = (contas_por_pai[conta.id] || []).sort_by(&:codigo) %>
<% tem_filhos = filhos.any? %>
<% filtro_ativo = local_assigns[:filtro_ativo] %>
<% index_params = local_assigns[:index_params] || {} %>
<% btn_icone = "shrink-0 p-1.5 rounded-lg text-stone-400 transition-colors" %>

<div
  data-plano-contas-tree-target="branch"
  data-depth="<%= depth %>"
  data-expanded="<%= filtro_ativo || depth < 1 ? 'true' : 'false' %>"
  class="select-none"
>
  <div class="group flex items-center gap-2 py-2.5 pr-3 rounded-lg hover:bg-stone-50 transition-colors border-b border-stone-100/80 last:border-0"
       style="padding-left: <%= 0.75 + depth * 1.25 %>rem">
    <% if tem_filhos %>
      <button type="button"
              data-action="plano-contas-tree#toggle"
              class="shrink-0 flex items-center justify-center w-7 h-7 rounded-md text-stone-500 hover:bg-stone-200/80 hover:text-stone-800 transition-colors"
              aria-label="Expandir ou recolher">
        <svg data-plano-contas-tree-target="chevron" class="w-4 h-4 transition-transform duration-200 <%= 'rotate-90' if filtro_ativo || depth < 1 %>" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
        </svg>
      </button>
    <% else %>
      <span class="w-7 h-7 shrink-0 flex items-center justify-center">
        <span class="w-1.5 h-1.5 rounded-full <%= conta.sintetica? ? 'bg-stone-300' : 'bg-sky-400' %>"></span>
      </span>
    <% end %>

    <div class="min-w-0 flex-1 flex flex-col sm:flex-row sm:items-center gap-1 sm:gap-3">
      <div class="flex items-center gap-2 min-w-0">
        <span class="font-mono text-xs sm:text-sm font-semibold text-stone-500 tabular-nums shrink-0"><%= conta.codigo %></span>
        <span class="font-medium text-stone-900 truncate <%= 'text-base' if depth.zero? %>"><%= conta.nome %></span>
      </div>
      <div class="flex flex-wrap items-center gap-1.5 shrink-0">
        <%= badge_natureza_plano(conta) if depth.zero? %>
        <%= badge_tipo_plano(conta) %>
        <% unless conta.ativo? %>
          <span class="text-[10px] font-medium text-stone-400 uppercase">Inativa</span>
        <% end %>
      </div>
    </div>

    <div class="flex items-center gap-0.5 shrink-0">
      <% if conta.sintetica? %>
        <%= link_to new_admin_plano_conta_path(**index_params, conta_pai_id: conta.id),
              data: { turbo_frame: "plano_conta_drawer" },
              class: "#{btn_icone} hover:text-emerald-600 hover:bg-emerald-50",
              title: "Nova subconta",
              aria: { label: "Nova subconta" } do %>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
        <% end %>
      <% end %>
      <%= link_to edit_admin_plano_conta_path(conta, **index_params),
            data: { turbo_frame: "plano_conta_drawer" },
            class: "#{btn_icone} hover:text-sky-600 hover:bg-sky-50",
            title: "Alterar conta",
            aria: { label: "Alterar conta" } do %>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
      <% end %>
      <% if plano_conta_excluivel?(conta) %>
        <%= button_to admin_plano_conta_path(conta, **index_params),
              method: :delete,
              form: { data: { turbo_frame: "_top", turbo_confirm: "Excluir a conta #{conta.codigo} — #{conta.nome}?" }, class: "inline" },
              class: "#{btn_icone} hover:text-red-600 hover:bg-red-50 border-0 bg-transparent cursor-pointer",
              title: "Excluir conta",
              aria: { label: "Excluir conta" } do %>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
        <% end %>
      <% end %>
    </div>
  </div>

  <% if tem_filhos %>
    <div data-plano-contas-tree-target="children"
         class="<%= 'hidden' unless filtro_ativo || depth < 1 %> ml-2 border-l border-stone-200/90">
      <% filhos.each do |filho| %>
        <%= render "no_arvore", conta: filho, contas_por_pai: contas_por_pai, depth: depth + 1, filtro_ativo: filtro_ativo, index_params: index_params %>
      <% end %>
    </div>
  <% end %>
</div>
