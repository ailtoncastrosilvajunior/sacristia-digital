<% drawer = local_assigns[:drawer] %>
<% index_params = local_assigns[:index_params] || {} %>
<% pai_opcoes = plano_conta_pai_opcoes(excluir: (@plano_conta.persisted? ? @plano_conta : nil)) %>

<%= simple_form_for @plano_conta,
      url: (@plano_conta.persisted? ? admin_plano_conta_path(@plano_conta) : admin_plano_contas_path),
      html: { data: (drawer ? { turbo_frame: "_top" } : {}) } do |f| %>
  <%= f.error_notification %>
  <% index_params.each do |key, value| %>
    <%= hidden_field_tag key, value %>
  <% end %>
  <div class="grid grid-cols-1 gap-4">
    <%= f.input :codigo, input_html: { class: "font-mono" } %>
    <%= f.input :nome %>
    <%= f.input :natureza, collection: PlanoConta::NATUREZAS.map { |n| [n.capitalize, n] }, include_blank: false,
          disabled: @plano_conta.conta_pai_id.present?,
          hint: (@plano_conta.conta_pai_id.present? ? "Herda a natureza da conta mãe." : nil) %>
    <% if @plano_conta.conta_pai_id.present? %>
      <%= f.hidden_field :natureza %>
    <% end %>
    <%= f.input :conta_pai_id,
          collection: pai_opcoes,
          include_blank: "— (conta raiz)",
          label: "Conta mãe",
          hint: "Deixe vazio para conta de primeiro nível (receita ou despesa)." %>
    <%= f.input :ordem %>
    <%= f.input :sintetica, hint: "Contas sintéticas agrupam subcontas; analíticas recebem lançamentos." %>
    <%= f.input :ativo %>
  </div>
  <div class="mt-6 flex flex-wrap gap-2">
    <%= f.button :submit, (@plano_conta.persisted? ? "Salvar" : "Criar conta"), class: "px-4 py-2.5 bg-slate-600 hover:bg-slate-700 text-white font-medium rounded-lg transition-colors" %>
    <% if drawer %>
      <button type="button" data-action="drawer#close" class="px-4 py-2.5 border border-stone-300 text-stone-700 hover:bg-stone-50 font-medium rounded-lg transition-colors">Cancelar</button>
    <% else %>
      <%= link_to "Cancelar", admin_plano_contas_path(**index_params), class: "px-4 py-2.5 text-stone-600" %>
    <% end %>
    <% if drawer && @plano_conta.persisted? && plano_conta_excluivel?(@plano_conta) %>
      <%= button_to "Excluir",
            admin_plano_conta_path(@plano_conta, **index_params),
            method: :delete,
            form: { data: { turbo_frame: "_top", turbo_confirm: "Excluir a conta #{@plano_conta.codigo}? Esta ação não pode ser desfeita." }, class: "inline" },
            class: "px-4 py-2.5 border border-red-200 text-red-700 hover:bg-red-50 font-medium rounded-lg transition-colors" %>
    <% end %>
  </div>
<% end %>
