<%# locals: ev, filtros %>
<% ts = ev.tipo_servico %>
<% cor = ts.cor_etiqueta.presence || "#64748b" %>
<% status_estilos = {
     "confirmado" => ["bg-emerald-100 text-emerald-800 border-emerald-200", "bg-emerald-500", "Confirmado"],
     "concluido"  => ["bg-sky-100 text-sky-800 border-sky-200", "bg-sky-500", "Concluído"],
     "cancelado"  => ["bg-red-100 text-red-800 border-red-200", "bg-red-500", "Cancelado"]
   } %>
<% st_classe, st_ponto, st_padrao = status_estilos.fetch(ev.status, ["bg-amber-50 text-amber-800 border-amber-200", "bg-amber-400", ev.status.humanize]) %>
<% st_texto = I18n.t("activerecord.attributes.evento_escala.status_values.#{ev.status}", default: st_padrao) %>
<% sem_escala = !ev.requer_ministros? %>
<% btn_icone = "inline-flex items-center justify-center w-7 h-7 rounded-md border bg-transparent transition-colors cursor-pointer" %>
<li id="<%= dom_id(ev, :lista_card) %>">
  <div class="group relative flex flex-col sm:flex-row sm:items-stretch gap-0 rounded-xl border border-slate-200/90 bg-white overflow-hidden shadow-sm transition-all duration-200 hover:-translate-y-px hover:border-slate-300 hover:shadow-md hover:shadow-slate-900/10 hover:bg-slate-50/40">
    <%# Etiqueta de status anexada ao canto superior direito %>
    <span class="absolute top-0 right-0 z-10 inline-flex items-center gap-1 px-2 py-0.5 rounded-bl-lg border-b border-l text-[9px] font-bold uppercase tracking-wide <%= st_classe %>">
      <span class="h-1 w-1 rounded-full <%= st_ponto %> shrink-0"></span>
      <%= st_texto %>
    </span>

    <div class="relative sm:w-[3.75rem] shrink-0 flex flex-row flex-wrap sm:flex-nowrap sm:flex-col items-center justify-center gap-x-2 gap-y-0 sm:gap-0.5 px-3 py-2 bg-stone-50 text-slate-700 sm:border-r border-stone-200 border-b sm:border-b-0">
      <span class="relative text-sm font-medium text-stone-500 tabular-nums leading-none sm:text-center"><%= l(ev.horario, format: :time) %></span>
    </div>

    <div class="flex-1 min-w-0 px-3 py-2 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2">
      <div class="min-w-0 space-y-1.5">
        <div class="flex flex-wrap items-center gap-2">
          <span class="inline-flex px-2.5 py-0.5 text-xs font-bold rounded-lg border-2" style="background-color: <%= cor %>33; border-color: <%= cor %>; color: #0f172a;"><%= ts.nome %></span>
          <span class="text-sm text-stone-600 min-w-0 truncate">
            <span class="text-stone-400 font-medium text-[10px] uppercase tracking-wider">Sacerdote</span>
            <%= ev.sacerdote&.nome || tag.span("—", class: "text-stone-400") %>
          </span>
        </div>
        <% if sem_escala %>
        <p class="inline-flex items-center gap-1.5 text-xs text-stone-500" title="Este tipo de evento não requer ministros (quantidade = 0)">
          <svg class="w-3.5 h-3.5 text-stone-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636"/></svg>
          Não requer ministros
        </p>
        <% else %>
        <div class="flex flex-wrap items-center gap-x-2 gap-y-1">
          <p class="text-[10px] font-bold uppercase tracking-widest text-stone-500 flex items-center gap-1.5">
            <svg class="w-3 h-3 text-sky-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
            Ministros
          </p>
          <%= render "admin/evento_escala/ministros_com_coordenador", evento: ev, variant: :chips, compacto: true %>
        </div>
        <% end %>
      </div>

      <div class="flex items-center gap-1 shrink-0 sm:mt-4">
        <%= link_to admin_evento_escala_path(ev, filtros), data: { turbo_frame: "evento_drawer" }, title: "Ver", aria: { label: "Ver" }, class: "#{btn_icone} border-stone-300 text-stone-500 hover:bg-stone-50 hover:border-stone-400" do %>
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
          </svg>
        <% end %>
        <%= link_to escalar_ministros_admin_evento_escala_path(ev, filtros), data: { turbo_frame: "evento_modal" }, title: (sem_escala ? "Escalar sacerdote" : "Escalar ministros"), aria: { label: (sem_escala ? "Escalar sacerdote" : "Escalar ministros") }, class: "#{btn_icone} border-sky-400 text-sky-600 hover:bg-sky-50" do %>
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
          </svg>
        <% end %>
        <%= link_to (local_assigns[:extra] ? edit_admin_eventos_extra_path(ev) : edit_admin_evento_escala_path(ev, filtros)), data: (local_assigns[:extra] ? { turbo_frame: "_top" } : { turbo_frame: "evento_modal" }), title: "Editar", aria: { label: "Editar" }, class: "#{btn_icone} border-stone-300 text-stone-500 hover:bg-stone-50 hover:border-stone-400" do %>
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
          </svg>
        <% end %>
        <%= button_to (local_assigns[:extra] ? admin_eventos_extra_path(ev) : admin_evento_escala_path(ev, filtros)), method: :delete, data: { turbo_confirm: "Excluir este evento?" }, form: { class: "contents" }, title: "Excluir", aria: { label: "Excluir" }, class: "#{btn_icone} border-red-300 text-red-500 hover:bg-red-50" do %>
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
          </svg>
        <% end %>
      </div>
    </div>
  </div>
</li>
