<div class="space-y-4 sm:space-y-6" data-controller="modal drawer">
  <% filtros = params.permit(:tipo_servico_id, :sacerdote_id, :ministro_id, :dia_semana, :vista, :aba, :vista_calendario, :data_ref).to_unsafe_h.compact_blank %>
  <div id="evento-modal-backdrop" data-modal-target="backdrop" class="fixed inset-0 z-50 hidden items-center justify-center bg-stone-900/50 p-4" data-action="click->modal#closeBackground">
    <div data-action="click->modal#stopPropagation" class="w-full max-w-4xl">
      <turbo-frame id="evento_modal" data-modal-target="frame" data-action="turbo:frame-load->modal#show turbo:frame-render->modal#show"></turbo-frame>
    </div>
  </div>

  <%# Drawer lateral com os dados do evento (carregado via turbo-frame) %>
  <div data-controller="drawer" class="contents">
    <div data-drawer-target="overlay" class="fixed inset-0 z-40 bg-stone-900/30 transition-opacity duration-300 invisible opacity-0 pointer-events-none" data-action="click->drawer#closeOverlay"></div>
    <div data-drawer-target="panel" class="fixed top-0 right-0 z-50 h-full w-full sm:w-[26rem] max-w-md bg-white shadow-xl transform transition-transform duration-300 ease-out translate-x-full border-l border-stone-200 flex flex-col">
      <turbo-frame id="evento_drawer" data-action="turbo:frame-load->drawer#open" class="flex flex-col h-full min-h-0"></turbo-frame>
    </div>
  </div>

  <div class="relative overflow-hidden rounded-3xl border border-sky-200/25 bg-gradient-to-br from-slate-900 via-slate-900 to-sky-950 text-white shadow-xl shadow-slate-900/20">
    <div class="absolute inset-0 opacity-[0.06]" style="background-image: url('data:image/svg+xml,%3Csvg width=\'60\' height=\'60\' viewBox=\'0 0 60 60\' xmlns=\'http://www.w3.org/2000/svg\'%3E%3Cg fill=\'none\' fill-rule=\'evenodd\'%3E%3Cg fill=\'%23ffffff\' fill-opacity=\'1\'%3E%3Cpath d=\'M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z\'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E');" aria-hidden="true"></div>
    <div class="absolute -right-16 -top-16 h-48 w-48 rounded-full bg-sky-500/20 blur-3xl pointer-events-none" aria-hidden="true"></div>
    <div class="relative px-4 py-3 sm:px-6 flex flex-col lg:flex-row lg:items-center lg:justify-between gap-3">
      <div class="min-w-0 flex items-center gap-3">
        <%= link_to admin_competencia_mensal_index_path, title: "Competências", aria: { label: "Voltar para competências" }, class: "inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-white/5 ring-1 ring-white/10 text-sky-200/90 hover:bg-white/10 hover:text-white transition-colors" do %>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
          </svg>
        <% end %>
        <div class="min-w-0">
          <p class="text-sky-300/80 text-[10px] font-semibold tracking-[0.2em] uppercase leading-none">Competência mensal</p>
          <h1 class="text-xl sm:text-2xl font-bold tracking-tight leading-tight"><%= @competencia.label %></h1>
        </div>
        <div class="hidden md:flex flex-wrap items-center gap-1.5 ml-1">
          <span class="inline-flex px-2.5 py-0.5 text-[11px] font-semibold rounded-full border <%= @competencia.escala_gerada? ? "bg-emerald-500/20 text-emerald-100 border-emerald-400/40" : "bg-amber-500/20 text-amber-100 border-amber-400/40" %>">
            Escala <%= @competencia.escala_gerada? ? "gerada" : "pendente" %>
          </span>
          <span class="inline-flex px-2.5 py-0.5 text-[11px] font-semibold rounded-full border <%= @competencia.escala_liberada? ? "bg-sky-500/25 text-sky-100 border-sky-400/40" : "bg-white/10 text-slate-200 border-white/15" %>" title="<%= @competencia.escala_liberada? ? "Ministros podem visualizar a escala" : "Apenas admin e coordenadores podem visualizar" %>">
            <%= @competencia.escala_liberada? ? "Liberada aos ministros" : "Visão restrita" %>
          </span>
        </div>
      </div>
      <div class="flex flex-wrap items-center gap-1.5 shrink-0">
        <% if pode_gerar_escala_competencia? %>
        <% total_existentes = @competencia.evento_escalas.count %>
        <div data-controller="drawer" class="contents">
          <button type="button" data-action="click->drawer#open" class="px-3 py-1.5 text-xs font-semibold rounded-lg transition-all bg-gradient-to-r from-sky-500 to-blue-600 hover:from-sky-400 hover:to-blue-500 text-white ring-1 ring-white/15 cursor-pointer">Gerar escala</button>

          <div data-drawer-target="overlay" class="fixed inset-0 z-40 bg-stone-900/30 transition-opacity duration-300 invisible opacity-0 pointer-events-none" data-action="click->drawer#closeOverlay"></div>
          <div data-drawer-target="panel" class="fixed top-0 right-0 z-50 h-full w-full sm:w-96 max-w-sm bg-white text-stone-800 shadow-xl transform transition-transform duration-300 ease-out translate-x-full border-l border-stone-200 flex flex-col">
            <div class="flex items-center justify-between px-4 py-4 border-b border-stone-200">
              <h4 class="text-base font-semibold text-stone-800">Gerar escala de <%= @competencia.label %></h4>
              <button type="button" data-action="click->drawer#close" class="p-1.5 rounded-lg text-stone-400 hover:text-stone-600 hover:bg-stone-100 transition-colors" aria-label="Fechar">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
              </button>
            </div>
            <%= form_with url: gerar_escala_admin_competencia_mensal_path(@competencia), method: :post, local: true, class: "flex-1 flex flex-col min-h-0" do %>
            <div class="flex-1 overflow-y-auto p-4 space-y-4">
              <p class="text-sm text-stone-600">Os eventos serão criados a partir do <span class="font-semibold">Calendário Base</span> ativo, para todos os dias do mês.</p>
              <% if total_existentes.positive? %>
              <div class="rounded-lg border border-amber-200 bg-amber-50 px-3 py-2 text-sm text-amber-900">
                Esta competência já tem <span class="font-semibold"><%= total_existentes %> <%= total_existentes == 1 ? "evento" : "eventos" %></span>. Como deseja prosseguir?
              </div>
              <fieldset class="space-y-2">
                <legend class="sr-only">Eventos existentes</legend>
                <label class="flex items-start gap-3 rounded-xl border border-stone-200 p-3 cursor-pointer hover:bg-stone-50 has-[:checked]:border-sky-500 has-[:checked]:bg-sky-50/60">
                  <input type="radio" name="modo" value="manter" checked class="mt-1 text-sky-600 focus:ring-sky-500">
                  <span>
                    <span class="block text-sm font-semibold text-stone-800">Manter os eventos existentes</span>
                    <span class="block text-xs text-stone-500 mt-0.5">Nada é apagado. Só são criados os eventos que ainda não existem (mesmo dia, horário e tipo). Escalas já montadas são preservadas.</span>
                  </span>
                </label>
                <label class="flex items-start gap-3 rounded-xl border border-stone-200 p-3 cursor-pointer hover:bg-stone-50 has-[:checked]:border-red-400 has-[:checked]:bg-red-50/60">
                  <input type="radio" name="modo" value="substituir" class="mt-1 text-red-600 focus:ring-red-500">
                  <span>
                    <span class="block text-sm font-semibold text-stone-800">Substituir os eventos existentes</span>
                    <span class="block text-xs text-stone-500 mt-0.5">Apaga os eventos ordinários atuais, <span class="font-semibold text-red-700">com ministros e sacerdotes já escalados</span>, e gera tudo novamente. Eventos extras são mantidos.</span>
                  </span>
                </label>
              </fieldset>
              <% else %>
              <%= hidden_field_tag :modo, "substituir" %>
              <p class="text-sm text-stone-500">Esta competência ainda não tem eventos.</p>
              <% end %>
            </div>
            <div class="flex gap-2 p-4 border-t border-stone-200">
              <button type="button" data-action="click->drawer#close" class="px-4 py-2 bg-stone-200 hover:bg-stone-300 text-stone-700 text-sm font-medium rounded-lg transition-colors cursor-pointer">Cancelar</button>
              <%= submit_tag "Confirmar e gerar", class: "flex-1 px-4 py-2 bg-slate-700 hover:bg-slate-800 text-white text-sm font-semibold rounded-lg transition-colors cursor-pointer" %>
            </div>
            <% end %>
          </div>
        </div>
        <% end %>
        <%= link_to admin_competencia_mensal_plantao_periodos_path(@competencia), title: "Plantão extra da competência", aria: { label: "Plantão extra da competência" }, class: "inline-flex h-8 items-center gap-1.5 rounded-lg border border-white/20 bg-white/10 px-2.5 text-xs font-semibold text-white hover:bg-white/15 transition-colors" do %>
          <svg class="w-4 h-4 shrink-0 opacity-90" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
          Plantão
        <% end %>
        <%= link_to edit_admin_competencia_mensal_path(@competencia), title: "Editar competência", aria: { label: "Editar competência" }, class: "inline-flex h-8 w-8 items-center justify-center rounded-lg border border-white/20 bg-white/10 text-white hover:bg-white/15 transition-colors" do %>
          <svg class="w-4 h-4 shrink-0 opacity-90" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
          </svg>
        <% end %>
        <%= button_to admin_competencia_mensal_path(@competencia), method: :delete, data: { turbo_confirm: "Tem certeza? Isso excluirá todos os eventos." }, form: { class: "contents" }, title: "Excluir competência", aria: { label: "Excluir competência" },
            class: "inline-flex h-8 w-8 items-center justify-center rounded-lg border border-red-400/50 text-red-100 hover:bg-red-500/20 transition-colors cursor-pointer bg-transparent" do %>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" /></svg>
        <% end %>
        <span class="hidden sm:block h-6 w-px bg-white/15 mx-1" aria-hidden="true"></span>
        <button type="button" data-action="click->drawer#toggle" class="inline-flex items-center gap-1.5 px-3 h-8 text-xs font-semibold rounded-lg border border-white/20 bg-white/10 text-white hover:bg-white/15 transition-colors cursor-pointer">
          <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z" />
          </svg>
          Filtros
          <% if filtros.except(:aba, :vista, :vista_calendario, :data_ref).any? %>
          <span class="inline-flex items-center justify-center min-w-[18px] h-[18px] px-1 text-[11px] font-medium rounded-full bg-sky-500 text-white"><%= filtros.except(:aba, :vista, :vista_calendario, :data_ref).size %></span>
          <% end %>
        </button>
        <%= link_to "Novo evento", new_admin_evento_escala_path(competencia_mensal_id: @competencia.id, **filtros), data: { turbo_frame: "evento_modal" }, class: "inline-flex items-center justify-center px-3 h-8 bg-emerald-600 hover:bg-emerald-500 text-white text-xs font-semibold rounded-lg transition-colors" %>
      </div>
    </div>
  </div>

  <div class="rounded-2xl border border-stone-200/90 bg-white shadow-lg shadow-stone-900/5 ring-1 ring-stone-100 overflow-hidden">
    <div class="p-4 sm:p-6 lg:p-8">
      <div class="flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between mb-4 pb-4 border-b border-stone-100">
        <div class="flex flex-wrap items-center gap-2">
          <span class="inline-flex items-center gap-2 text-sm font-semibold text-stone-800">
            <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-sky-100 text-sky-700 ring-1 ring-sky-200/70">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
              </svg>
            </span>
            <%= @eventos_contagem %> <%= @eventos_contagem == 1 ? "evento" : "eventos" %>
          </span>
          <div class="flex rounded-xl border border-stone-200/90 overflow-hidden shadow-sm">
            <%= link_to admin_competencia_mensal_path(@competencia, filtros.merge(aba: "calendario")), class: "inline-flex items-center gap-1.5 px-3 py-2 text-xs font-semibold transition-colors #{@aba == 'calendario' ? 'bg-gradient-to-r from-sky-600 to-blue-600 text-white' : 'bg-white text-stone-600 hover:bg-stone-50'}" do %>
            <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
            </svg>
            Calendário
            <% end %>
            <%= link_to admin_competencia_mensal_path(@competencia, filtros.merge(aba: "lista")), class: "inline-flex items-center gap-1.5 px-3 py-2 text-xs font-semibold transition-colors #{@aba == 'lista' ? 'bg-gradient-to-r from-sky-600 to-blue-600 text-white' : 'bg-white text-stone-600 hover:bg-stone-50'}" do %>
            <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 10h16M4 14h16M4 18h16" />
            </svg>
            Lista
            <% end %>
          </div>
        </div>
        <% if @tem_eventos_na_competencia && (@aba == "calendario" || @aba == "lista") %>
        <%= render "admin/competencia_mensal/nav_periodo_escala", filtros: filtros %>
        <% end %>
      </div>

      <% if @tem_eventos_na_competencia %>

      <%# Drawer de filtros - lateral direito %>
      <div data-drawer-target="overlay" class="fixed inset-0 z-40 bg-stone-900/30 transition-opacity duration-300 invisible opacity-0 pointer-events-none" data-action="click->drawer#closeOverlay"></div>
      <div data-drawer-target="panel" class="fixed top-0 right-0 z-50 h-full w-full sm:w-96 max-w-sm bg-white shadow-xl transform transition-transform duration-300 ease-out translate-x-full border-l border-stone-200 flex flex-col">
        <div class="flex items-center justify-between px-4 py-4 border-b border-stone-200">
          <h4 class="text-base font-semibold text-stone-800">Filtros</h4>
          <button type="button" data-action="click->drawer#close" class="p-1.5 rounded-lg text-stone-400 hover:text-stone-600 hover:bg-stone-100 transition-colors" aria-label="Fechar">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        </div>
        <div class="flex-1 overflow-y-auto p-4">
          <%= form_with url: admin_competencia_mensal_path(@competencia), method: :get, local: true, html: { class: "space-y-4" } do |f| %>
          <%= hidden_field_tag :vista, params[:vista] %>
          <%= hidden_field_tag :aba, params[:aba] %>
          <%= hidden_field_tag :vista_calendario, params[:vista_calendario] %>
          <%= hidden_field_tag :data_ref, params[:data_ref] %>
          <div>
            <label for="filtro_dia_semana" class="block text-sm font-medium text-stone-700 mb-1">Dia da semana</label>
            <%= select_tag :dia_semana, options_for_select(I18n.t("date.abbr_day_names").each_with_index.map { |nome, i| [nome, i] }, params[:dia_semana]), { include_blank: "Todos", id: "filtro_dia_semana", class: "block w-full rounded-lg border-stone-300 text-sm shadow-sm focus:border-slate-500 focus:ring-slate-500" } %>
          </div>
          <div>
            <label for="filtro_tipo_servico" class="block text-sm font-medium text-stone-700 mb-1">Tipo de serviço</label>
            <%= select_tag :tipo_servico_id, options_from_collection_for_select(TipoServico.ativos, :id, :nome, params[:tipo_servico_id]), { include_blank: "Todos", id: "filtro_tipo_servico", class: "block w-full rounded-lg border-stone-300 text-sm shadow-sm focus:border-slate-500 focus:ring-slate-500" } %>
          </div>
          <div>
            <label for="filtro_sacerdote" class="block text-sm font-medium text-stone-700 mb-1">Sacerdote</label>
            <%= select_tag :sacerdote_id, options_from_collection_for_select(Sacerdote.ativos.ordenados_por_nome, :id, :nome, params[:sacerdote_id]), { include_blank: "Todos", id: "filtro_sacerdote", class: "block w-full rounded-lg border-stone-300 text-sm shadow-sm focus:border-slate-500 focus:ring-slate-500" } %>
          </div>
          <div>
            <label for="filtro_ministro" class="block text-sm font-medium text-stone-700 mb-1">Ministro</label>
            <%= select_tag :ministro_id, options_from_collection_for_select(Ministro.ativos.ordenados_por_nome, :id, :nome, params[:ministro_id]), { include_blank: "Todos", id: "filtro_ministro", class: "block w-full rounded-lg border-stone-300 text-sm shadow-sm focus:border-slate-500 focus:ring-slate-500" } %>
          </div>
          <div class="flex gap-2 pt-2">
            <%= submit_tag "Filtrar", class: "flex-1 px-4 py-2 bg-slate-600 hover:bg-slate-700 text-white text-sm font-medium rounded-lg transition-colors cursor-pointer" %>
            <%= link_to "Limpar", admin_competencia_mensal_path(@competencia, aba: params[:aba]), class: "px-4 py-2 bg-stone-200 hover:bg-stone-300 text-stone-700 text-sm font-medium rounded-lg transition-colors rounded-lg" %>
          </div>
          <% end %>
        </div>
      </div>

      <% if @aba == "calendario" %>
      <% eventos_por_dia = @eventos_calendario_loaded.group_by(&:data) %>
      <div class="flex flex-wrap items-center gap-x-4 gap-y-2 mb-3 sm:mb-4 text-xs text-stone-600">
        <% @eventos_calendario_loaded.map(&:tipo_servico).uniq(&:id).sort_by(&:nome).each do |ts| %>
        <span class="inline-flex items-center gap-1.5">
          <span class="w-1 h-4 rounded-full shrink-0" style="background-color: <%= ts.cor_etiqueta %>;"></span>
          <%= ts.nome %>
        </span>
        <% end %>
        <span class="inline-flex items-center gap-3 border-l border-stone-200 pl-4">
          <span class="text-stone-400 font-medium">Equipe:</span>
          <span class="inline-flex items-center gap-1"><span class="px-1 rounded text-[9px] font-bold ring-1 bg-emerald-100 text-emerald-800 ring-emerald-200">2/2</span> completa</span>
          <span class="inline-flex items-center gap-1"><span class="px-1 rounded text-[9px] font-bold ring-1 bg-amber-100 text-amber-800 ring-amber-200">1/2</span> incompleta</span>
          <span class="inline-flex items-center gap-1"><span class="px-1 rounded text-[9px] font-bold ring-1 bg-red-100 text-red-700 ring-red-200">0/2</span> vazia</span>
        </span>
      </div>

      <div class="mb-6 sm:mb-8 overflow-x-auto -mx-4 sm:mx-0 px-4 sm:px-0">
        <% inicio = @competencia.periodo %>
        <% fim = @competencia.periodo_fim %>
        <% if @vista_calendario == "mes" %>
        <% domingo_primeira_semana = inicio - inicio.wday %>
        <div class="min-w-[640px] lg:min-w-[760px] rounded-xl border border-stone-200 overflow-hidden bg-white shadow-sm">
          <div class="grid grid-cols-7 bg-slate-800 text-white">
            <% %w[Domingo Segunda Terça Quarta Quinta Sexta Sábado].each do |dia| %>
            <div class="px-2 py-2 text-center text-[10px] sm:text-xs font-semibold uppercase tracking-wider"><%= dia %></div>
            <% end %>
          </div>
          <div class="grid grid-cols-7">
            <% 42.times do |i| %>
            <% data = domingo_primeira_semana + i %>
            <% next if i >= 35 && (domingo_primeira_semana + 35) > fim %>
            <% no_mes = (inicio..fim).cover?(data) %>
            <% hoje = data == Date.current %>
            <% fim_semana = data.sunday? || data.saturday? %>
            <% evs = no_mes ? (eventos_por_dia[data] || []).sort_by(&:horario) : [] %>
            <div class="min-h-[110px] sm:min-h-[130px] p-1.5 border-b border-r border-stone-200 <%= no_mes ? (fim_semana ? 'bg-stone-50/70' : 'bg-white') : 'bg-stone-100/60' %>">
              <div class="flex items-center justify-between mb-1">
                <span class="inline-flex h-6 min-w-6 items-center justify-center rounded-full px-1 text-xs font-bold tabular-nums <%= hoje ? 'bg-sky-600 text-white' : (no_mes ? 'text-stone-700' : 'text-stone-300') %>"><%= data.day %></span>
                <% if evs.any? %>
                <%= link_to admin_competencia_mensal_path(@competencia, filtros.merge(vista_calendario: "dia", data_ref: data, aba: "calendario")), title: "Ver o dia", class: "text-[10px] font-medium text-stone-400 hover:text-sky-600" do %><%= evs.size %> <%= evs.size == 1 ? "evento" : "eventos" %><% end %>
                <% end %>
              </div>
              <% evs.each do |ev| %>
              <%= render "admin/competencia_mensal/evento_calendario_link", ev: ev, filtros: filtros %>
              <% end %>
            </div>
            <% end %>
          </div>
        </div>
        <% elsif @vista_calendario == "semana" %>
        <div class="min-w-[320px] sm:min-w-[500px] lg:min-w-[700px] rounded-lg border border-stone-200 overflow-hidden">
          <div class="grid grid-cols-7 bg-stone-100 border-b border-stone-200">
            <% 7.times do |i| %>
            <% d = @domingo_semana + i %>
            <div class="px-1 sm:px-2 py-1.5 sm:py-2 text-center">
              <div class="text-[10px] sm:text-xs font-semibold text-stone-600"><%= I18n.t("date.abbr_day_names")[d.wday] %></div>
              <div class="text-xs font-medium text-stone-700"><%= d.day %></div>
            </div>
            <% end %>
          </div>
          <div class="grid grid-cols-7 bg-white">
            <% 7.times do |i| %>
            <% data = @domingo_semana + i %>
            <% no_mes = (inicio..fim).cover?(data) %>
            <div class="min-h-[120px] sm:min-h-[160px] p-1.5 sm:p-2 border-b border-r border-stone-100 <%= data == Date.current ? 'bg-sky-50/50 ring-1 ring-sky-300' : '' %> <%= no_mes ? '' : 'bg-stone-50/50' %>">
              <% if no_mes %>
              <% (eventos_por_dia[data] || []).sort_by(&:horario).each do |ev| %>
              <%= render "admin/competencia_mensal/evento_calendario_link", ev: ev, filtros: filtros %>
              <% end %>
              <% end %>
            </div>
            <% end %>
          </div>
        </div>
        <% else %>
        <% eventos_do_dia = (eventos_por_dia[@data_ref] || []).sort_by(&:horario) %>
        <div class="max-w-2xl rounded-lg border border-stone-200 overflow-hidden">
          <div class="bg-stone-100 px-4 py-3 border-b border-stone-200">
            <h3 class="text-base font-semibold text-stone-800"><%= l(@data_ref, format: :long) %></h3>
            <p class="text-sm text-stone-500"><%= I18n.t("date.day_names")[@data_ref.wday] %></p>
          </div>
          <div class="bg-white divide-y divide-stone-100">
            <% if eventos_do_dia.any? %>
            <% eventos_do_dia.each do |ev| %>
            <%= render "admin/competencia_mensal/evento_calendario_dia_row", ev: ev, filtros: filtros %>
            <% end %>
            <% else %>
            <div class="px-4 py-8 text-center text-stone-500 text-sm">Nenhum evento neste dia</div>
            <% end %>
          </div>
        </div>
        <% end %>
      </div>
      <% end %>

      <% if @aba == "lista" %>
      <% grupos = @eventos_lista.group_by(&:data) %>
      <div data-controller="agenda-nav" class="flex gap-3 h-[60vh] sm:h-[min(70vh,520px)] lg:h-[560px] rounded-2xl border border-slate-200/80 bg-gradient-to-b from-slate-50/90 to-white shadow-xl shadow-slate-900/10 ring-1 ring-slate-200/50 overflow-hidden">
        <nav class="w-20 sm:w-24 shrink-0 overflow-y-auto border-r border-slate-200/80 bg-slate-50/80 p-2 space-y-1.5" aria-label="Datas">
          <% grupos.each do |data, eventos_do_dia| %>
          <button type="button" data-agenda-nav-target="data" data-data="<%= data.iso8601 %>" data-action="agenda-nav#ir"
                  class="w-full flex flex-col items-center rounded-xl border border-slate-200 bg-white text-slate-700 px-1 py-2 shadow-sm hover:border-sky-300 transition-colors cursor-pointer">
            <span class="text-[10px] font-bold uppercase tracking-widest opacity-80"><%= I18n.t("date.abbr_day_names")[data.wday] %></span>
            <span class="text-xl font-extrabold tabular-nums leading-tight"><%= l(data, format: "%d") %></span>
            <span class="text-[10px] uppercase opacity-70"><%= I18n.t("date.abbr_month_names")[data.month] %></span>
            <span class="mt-1 text-[10px] font-semibold px-1.5 rounded-full bg-slate-200/70 text-slate-600"><%= eventos_do_dia.size %></span>
          </button>
          <% end %>
        </nav>
        <div data-agenda-nav-target="lista" data-action="scroll->agenda-nav#marcar" class="flex-1 min-w-0 overflow-y-auto p-3 sm:p-4 space-y-5">
          <% grupos.each do |data, eventos_do_dia| %>
          <section data-agenda-nav-target="secao" data-data="<%= data.iso8601 %>">
            <div class="sticky top-0 z-10 py-1.5 mb-2 flex items-center gap-3 bg-slate-50">
              <div class="flex items-baseline gap-2">
                <span class="text-base font-extrabold text-sky-900 capitalize"><%= l(data, format: "%A") %></span>
                <span class="text-sm font-semibold text-sky-700 tabular-nums"><%= l(data, format: "%d/%m") %></span>
                <% if data == Date.current %><span class="px-2 py-0.5 rounded-full text-[10px] font-bold uppercase bg-sky-600 text-white">Hoje</span><% end %>
              </div>
              <span class="h-px flex-1 bg-sky-200"></span>
              <span class="text-xs font-semibold text-sky-700"><%= eventos_do_dia.size %> <%= eventos_do_dia.size == 1 ? "evento" : "eventos" %></span>
            </div>
            <ul class="space-y-2.5">
              <% eventos_do_dia.each do |ev| %>
              <%= render "admin/competencia_mensal/evento_lista_card_item", ev: ev, filtros: filtros %>
              <% end %>
            </ul>
          </section>
          <% end %>
        </div>
      </div>
      <% end %>
      <% else %>
      <p class="text-stone-500 text-sm py-4">Nenhum evento na escala. Clique em "Novo evento" para adicionar ou "Gerar escala" para criar a partir do calendário base.</p>
      <% end %>
    </div>
  </div>
</div>