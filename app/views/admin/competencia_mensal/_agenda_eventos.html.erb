<%# locals: grupos (Hash Date => eventos), filtros, extra: false, data_inicial: nil %>
<% data_inicial = local_assigns[:data_inicial]&.iso8601 %>
<div data-controller="agenda-nav"<% if data_inicial.present? %> data-agenda-nav-initial-date-value="<%= data_inicial %>"<% end %> class="flex gap-3 w-full h-[60vh] sm:h-[min(70vh,520px)] lg:h-[560px] rounded-2xl border border-slate-200/80 bg-gradient-to-b from-slate-50/90 to-white shadow-xl shadow-slate-900/10 ring-1 ring-slate-200/50 overflow-hidden">
  <nav class="w-20 sm:w-24 shrink-0 overflow-y-auto border-r border-slate-200/80 bg-slate-50/80 p-2 space-y-1.5" aria-label="Datas">
    <% grupos.each do |data, eventos_do_dia| %>
      <button type="button" data-agenda-nav-target="data" data-data="<%= data.iso8601 %>" data-action="agenda-nav#ir"
              class="w-full flex flex-col items-center rounded-xl border border-slate-200 bg-white text-slate-700 px-1 py-2 shadow-sm hover:border-sky-300 transition-colors cursor-pointer">
        <span class="text-[10px] font-bold uppercase tracking-widest opacity-80"><%= I18n.t("date.abbr_day_names")[data.wday] %></span>
        <span class="text-xl font-extrabold tabular-nums leading-tight"><%= l(data, format: "%d") %></span>
        <span class="text-[10px] uppercase opacity-70"><%= I18n.t("date.abbr_month_names")[data.month] %></span>
        <span class="mt-1 text-[10px] font-semibold px-1.5 rounded-full bg-slate-200/70 text-slate-600"><%= eventos_do_dia.size %></span>
      </button>
    <% end %>
  </nav>
  <div data-agenda-nav-target="lista" data-action="scroll->agenda-nav#marcar" class="flex-1 min-w-0 overflow-y-auto p-3 sm:p-4 space-y-5">
    <% grupos.each do |data, eventos_do_dia| %>
      <section data-agenda-nav-target="secao" data-data="<%= data.iso8601 %>">
        <div class="sticky top-0 z-10 py-1.5 mb-2 flex items-center gap-3 bg-slate-50">
          <div class="flex items-baseline gap-2">
            <span class="text-base font-extrabold text-sky-900 capitalize"><%= l(data, format: "%A") %></span>
            <span class="text-sm font-semibold text-sky-700 tabular-nums"><%= l(data, format: "%d/%m") %></span>
            <% if data == Date.current %><span class="px-2 py-0.5 rounded-full text-[10px] font-bold uppercase bg-sky-600 text-white">Hoje</span><% end %>
          </div>
          <span class="h-px flex-1 bg-sky-200"></span>
          <span class="text-xs font-semibold text-sky-700"><%= eventos_do_dia.size %> <%= eventos_do_dia.size == 1 ? "evento" : "eventos" %></span>
        </div>
        <% if eventos_do_dia.any? %>
          <ul class="space-y-2.5">
            <% eventos_do_dia.sort_by(&:horario).each do |ev| %>
              <%= render "admin/competencia_mensal/evento_lista_card_item", ev: ev, filtros: filtros, extra: local_assigns[:extra] %>
            <% end %>
          </ul>
        <% else %>
          <p class="text-sm text-stone-500 py-4 px-1">Nenhum evento neste dia.</p>
        <% end %>
      </section>
    <% end %>
  </div>
</div>
