<% volta_igmr = admin_liturgia_dia_path(liturgia_dia, aba: "igmr") %>
<% igmr = igmr_paragrafo %>
<% numero = igmr_numero %>

<div class="rounded-xl border border-sky-200 bg-gradient-to-br from-sky-50/80 to-white p-4 sm:p-5 space-y-4">
  <div class="flex flex-wrap items-start justify-between gap-3">
    <div class="min-w-0 flex-1">
      <p class="text-xs font-semibold uppercase tracking-wider text-sky-800">Formação MESC · cartaz do dia</p>
      <h2 class="text-xl font-semibold text-stone-900 mt-1">IGMR n.º <%= numero %></h2>
      <p class="text-sm text-stone-600 mt-1">
        Sequência automática pela data (âncora 31/10/2026 = n.º 51). Este texto entra no briefing ChatGPT.
      </p>
    </div>
    <div class="flex flex-wrap items-center gap-2">
      <%= render "admin/igmr_paragrafos/toolbar_acoes", igmr: igmr, numero: numero, return_to: volta_igmr %>
      <% if igmr %>
        <% if igmr.texto_conferido? %>
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-emerald-100 text-emerald-800 text-xs font-semibold">Conferido com o livro</span>
        <% else %>
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-amber-100 text-amber-900 text-xs font-semibold">Aguardando conferência</span>
        <% end %>
      <% else %>
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-amber-100 text-amber-900 text-xs font-semibold">Não cadastrado</span>
      <% end %>
    </div>
  </div>

  <% if igmr %>
    <div class="rounded-lg border border-stone-200 bg-white p-4 space-y-4">
      <p class="text-xs text-stone-500">Edição: <%= igmr.rotulo_edicao %><% if igmr.fonte.present? %> · Conferência: <%= igmr.fonte %><% end %></p>
      <% if igmr.trecho_cartaz.present? %>
        <div>
          <p class="text-xs font-semibold uppercase tracking-wider text-sky-800 mb-1">Trecho do cartaz / briefing</p>
          <p class="text-sm font-serif leading-relaxed text-stone-800 whitespace-pre-line"><%= igmr.trecho_cartaz %></p>
        </div>
        <div>
          <p class="text-xs font-semibold uppercase tracking-wider text-stone-500 mb-1">Parágrafo integral</p>
          <p class="text-sm font-serif leading-relaxed text-stone-600 whitespace-pre-line"><%= igmr.texto %></p>
        </div>
      <% else %>
        <p class="text-sm font-serif leading-relaxed text-stone-800 whitespace-pre-line"><%= igmr.texto %></p>
        <p class="text-xs text-stone-500">Dica: cadastre um trecho curto em “Trecho para o cartaz” se o parágrafo for longo.</p>
      <% end %>
    </div>
  <% else %>
    <div class="rounded-lg border border-dashed border-amber-300 bg-amber-50/50 px-4 py-6 text-center text-sm text-amber-950">
      <p class="font-medium">Ainda não há texto cadastrado para o parágrafo <strong><%= numero %></strong>.</p>
      <p class="text-amber-900/90 mt-1">Cadastre manualmente ou sincronize os textos CNBB pelos ícones acima.</p>
    </div>
  <% end %>
</div>
