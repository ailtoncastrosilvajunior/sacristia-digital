<% tab_btn = "inline-flex items-center gap-2 px-4 py-2.5 rounded-xl text-sm font-medium transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-sky-500/40" %>
<% aba_ativa = @aba %>
<% briefing_checklist = @liturgia_dia.validada? ? Liturgia::BriefingChecklist.new(@liturgia_dia) : nil %>

<div class="space-y-6 max-w-5xl">
  <div class="flex flex-wrap items-start justify-between gap-3">
    <div>
      <%= link_to "← Liturgia do mês", admin_liturgia_dias_path(mes: @liturgia_dia.data.strftime("%Y-%m")), class: "text-sm text-slate-500 hover:text-slate-800" %>
      <h1 class="text-2xl font-semibold text-stone-800 mt-1"><%= l(@liturgia_dia.data, format: "%A, %d de %B de %Y").capitalize %></h1>
      <p class="text-stone-600 mt-1">
        <span class="inline-block w-3 h-3 rounded-full border border-stone-300 align-middle" style="background-color: <%= @liturgia_dia.cor_css %>"></span>
        <%= @liturgia_dia.titulo %> · Cor: <%= @liturgia_dia.cor.presence || "—" %>
      </p>
    </div>
    <div class="flex flex-wrap items-center gap-2">
      <%= link_to "Editar", edit_admin_liturgia_dia_path(@liturgia_dia), class: "px-3 py-2 rounded-lg border border-stone-300 text-sm text-stone-700 hover:bg-stone-50" %>
        <%= button_to "Buscar novamente", sincronizar_admin_liturgia_dia_path(@liturgia_dia), method: :post,
            data: { turbo_confirm: "Substituir leituras, nome do santo e imagem pelos dados da Canção Nova? Edições manuais serão perdidas." },
            class: "px-3 py-2 rounded-lg border border-stone-300 text-sm text-stone-700 hover:bg-stone-50 cursor-pointer" %>
      <% if @liturgia_dia.validada? %>
        <%= button_to "Retirar dos ministros", reabrir_admin_liturgia_dia_path(@liturgia_dia), method: :post,
              class: "px-3 py-2 rounded-lg bg-amber-100 text-amber-900 text-sm hover:bg-amber-200 cursor-pointer" %>
      <% elsif @liturgia_dia.pode_validar? %>
        <%= button_to "Validar e liberar", validar_admin_liturgia_dia_path(@liturgia_dia), method: :post,
              data: { turbo_confirm: "Confirma que conferiu as leituras e o nome do santo do dia? Tudo ficará visível para os ministros." },
              class: "px-4 py-2 rounded-lg bg-emerald-600 text-white text-sm font-medium hover:bg-emerald-700 cursor-pointer" %>
      <% else %>
        <% bloqueio_validar = @liturgia_dia.leituras.blank? ? "Não há leituras para validar" : "Informe o nome do santo do dia" %>
        <span class="px-4 py-2 rounded-lg bg-stone-200 text-stone-500 text-sm font-medium cursor-not-allowed" title="<%= bloqueio_validar %>">Validar e liberar</span>
      <% end %>
    </div>
  </div>

  <div data-controller="tabs" data-tabs-active-value="<%= aba_ativa %>" class="rounded-2xl border border-stone-200 bg-white shadow-sm overflow-hidden">
    <div class="border-b border-stone-100 bg-stone-50/80 px-3 py-3 sm:px-4">
      <div role="tablist" aria-label="Revisão do dia" class="flex flex-wrap gap-2">
        <button type="button" role="tab" id="tab-liturgia-show" data-tabs-target="tab" data-tabs-tab-value="liturgia" data-action="tabs#select"
                aria-controls="panel-liturgia-show" class="<%= tab_btn %> bg-slate-800 text-white shadow-sm">
          Liturgia
        </button>
        <button type="button" role="tab" id="tab-santo-show" data-tabs-target="tab" data-tabs-tab-value="santo" data-action="tabs#select"
                aria-controls="panel-santo-show" class="<%= tab_btn %> bg-white text-stone-700 border border-stone-200 hover:bg-stone-50">
          Santo
          <% if @liturgia_dia.santo_nome.blank? %>
            <span class="inline-block h-2 w-2 rounded-full bg-amber-500" title="Nome pendente"></span>
          <% end %>
        </button>
        <button type="button" role="tab" id="tab-igmr-show" data-tabs-target="tab" data-tabs-tab-value="igmr" data-action="tabs#select"
                aria-controls="panel-igmr-show" class="<%= tab_btn %> bg-white text-stone-700 border border-stone-200 hover:bg-stone-50">
          IGMR
          <% if @igmr_paragrafo.nil? %>
            <span class="inline-block h-2 w-2 rounded-full bg-amber-500" title="Parágrafo pendente"></span>
          <% end %>
        </button>
        <button type="button" role="tab" id="tab-briefing-show" data-tabs-target="tab" data-tabs-tab-value="briefing" data-action="tabs#select"
                aria-controls="panel-briefing-show" class="<%= tab_btn %> bg-white text-stone-700 border border-stone-200 hover:bg-stone-50">
          Briefing
          <% if @liturgia_dia.validada? && briefing_checklist && !briefing_checklist.briefing_liberado? %>
            <span class="inline-block h-2 w-2 rounded-full bg-amber-500" title="IGMR pendente para o briefing"></span>
          <% elsif !@liturgia_dia.validada? %>
            <span class="inline-block h-2 w-2 rounded-full bg-stone-400" title="Valide a liturgia"></span>
          <% end %>
        </button>
      </div>
    </div>

    <div class="p-4 sm:p-5 space-y-4 bg-stone-50/40 min-h-[12rem]">
      <div role="tabpanel" id="panel-liturgia-show" data-tabs-target="panel" data-tabs-panel-value="liturgia" aria-labelledby="tab-liturgia-show" class="space-y-4" <%= "hidden" unless aba_ativa == "liturgia" %>>
        <%= render "admin/liturgia_dias/show_tab_liturgia", liturgia_dia: @liturgia_dia %>
      </div>
      <div role="tabpanel" id="panel-santo-show" data-tabs-target="panel" data-tabs-panel-value="santo" aria-labelledby="tab-santo-show" class="space-y-4" <%= "hidden" unless aba_ativa == "santo" %>>
        <%= render "admin/liturgia_dias/show_tab_santo", liturgia_dia: @liturgia_dia %>
      </div>
      <div role="tabpanel" id="panel-igmr-show" data-tabs-target="panel" data-tabs-panel-value="igmr" aria-labelledby="tab-igmr-show" class="space-y-4" <%= "hidden" unless aba_ativa == "igmr" %>>
        <%= render "admin/liturgia_dias/show_tab_igmr", liturgia_dia: @liturgia_dia, igmr_paragrafo: @igmr_paragrafo, igmr_numero: @igmr_numero %>
      </div>
      <div role="tabpanel" id="panel-briefing-show" data-tabs-target="panel" data-tabs-panel-value="briefing" aria-labelledby="tab-briefing-show" class="space-y-4" <%= "hidden" unless aba_ativa == "briefing" %>>
        <%= render "admin/liturgia_dias/show_tab_briefing", liturgia_dia: @liturgia_dia %>
      </div>
    </div>
  </div>
</div>
