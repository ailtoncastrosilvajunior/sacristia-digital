    padding: 3px 2px;
    vertical-align: middle;
    font-weight: 700;
    color: #0b2d5c;
    text-align: center;
    height: 21px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .lm-escala .lm-col-hora { width: 14%; font-weight: 800; }
  .lm-escala .lm-col-pres { width: 26%; font-size: 6px; }
  .lm-escala .lm-col-min { width: 15%; font-size: 6px; }
</style>
