    font-size: 6.8px;
    color: #0b2d5c;
    line-height: 1.2;
    margin-bottom: 1px;
  }
  .lm-trecho {
    font-family: "Source Sans 3", system-ui, sans-serif;
    font-size: 6.6px;
    font-weight: 600;
    color: #1e3a5f;
    line-height: 1.22;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .lm-igmr {
    left: 116px;
    top: 666px;
    width: 444px;
    height: 88px;
