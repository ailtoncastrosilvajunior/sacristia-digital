<style>
  .lm-canvas {
    position: relative;
    width: 576px;
    height: 1024px;
    margin: 0 auto;
    background: url("<%= liturgia_cartaz_moldura_data_uri %>") no-repeat 0 0 / 576px 1024px;
    overflow: hidden;
    font-family: "Source Sans 3", system-ui, sans-serif;
    color: #0b2d5c;
    -webkit-font-smoothing: antialiased;
  }
  .lm-layer {
