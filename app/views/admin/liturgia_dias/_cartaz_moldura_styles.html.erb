    overflow: hidden;
    z-index: 2;
  }
  /* Caixa superior (celebração) — y ~255–308 */
  .lm-caixa-festa {
    left: 38px;
    top: 256px;
    width: 262px;
    height: 50px;
    display: flex;
    align-items: center;
  }
  .lm-festa-principal {
    font-size: 7.2px;
    font-weight: 800;
    letter-spacing: 0.025em;
    line-height: 1.28;
    text-transform: uppercase;
    color: #1b6b3a;
    display: -webkit-box;
    -webkit-line-clamp: 4;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  /* Caixa inferior (dia + data) — y ~312–324 */
  .lm-caixa-dia {
    left: 38px;
    top: 312px;
    width: 262px;
    height: 28px;
    display: flex;
    align-items: center;
  }
