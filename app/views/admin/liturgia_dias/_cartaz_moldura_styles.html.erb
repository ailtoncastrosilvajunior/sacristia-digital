    top: 256px;
    width: 198px;
    height: 132px;
    clip-path: polygon(8% 6%, 92% 6%, 100% 22%, 100% 100%, 0 100%, 0 22%);
    overflow: hidden;
  }
  .lm-foto img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    display: block;
  }
