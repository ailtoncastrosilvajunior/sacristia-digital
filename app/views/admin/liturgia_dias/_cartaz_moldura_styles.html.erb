<% cartaz_scale = local_assigns.fetch(:cartaz_scale, 1).to_i %>
<style>
  .lm-canvas {
    --lm-scale: <%= cartaz_scale %>;
    position: relative;
    width: calc(576px * var(--lm-scale));
    height: calc(1024px * var(--lm-scale));
    margin: 0 auto;
    background: url("<%= liturgia_cartaz_moldura_data_uri(scale: cartaz_scale) %>") no-repeat 0 0 / calc(576px * var(--lm-scale)) calc(1024px * var(--lm-scale));
    overflow: hidden;
    font-family: "Source Sans 3", system-ui, sans-serif;
    color: #0b2d5c;
    -webkit-font-smoothing: antialiased;
    text-rendering: geometricPrecision;
  }
  .lm-layer {
    position: absolute;
    overflow: hidden;
    z-index: 2;
  }
  .lm-caixa-festa {
    left: calc(38px * var(--lm-scale));
    top: calc(256px * var(--lm-scale));
    width: calc(262px * var(--lm-scale));
    height: calc(50px * var(--lm-scale));
    display: flex;
    align-items: center;
  }
  .lm-festa-principal {
    font-size: calc(9px * var(--lm-scale));
    font-weight: 800;
    letter-spacing: 0.02em;
    line-height: 1.25;
    text-transform: uppercase;
    color: #1b6b3a;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .lm-caixa-dia {
    left: calc(38px * var(--lm-scale));
    top: calc(312px * var(--lm-scale));
    width: calc(262px * var(--lm-scale));
    height: calc(28px * var(--lm-scale));
    display: flex;
    align-items: center;
  }
  .lm-dia-linha {
    font-size: calc(8.5px * var(--lm-scale));
    font-weight: 800;
    letter-spacing: 0.025em;
    text-transform: uppercase;
    line-height: 1.2;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .lm-dia-semana { color: #0b2d5c; }
  .lm-dia-sep { margin: 0 calc(3px * var(--lm-scale)); opacity: 0.65; }
  .lm-data-extenso { color: #1b6b3a; }
  .lm-cor-dot {
    left: calc(51px * var(--lm-scale));
    top: calc(357px * var(--lm-scale));
    width: calc(15px * var(--lm-scale));
    height: calc(15px * var(--lm-scale));
    border-radius: 50%;
    z-index: 3;
    box-shadow: 0 0 0 1px rgba(0, 0, 0, 0.12);
  }
  .lm-cor-nome {
    left: calc(72px * var(--lm-scale));
    top: calc(358px * var(--lm-scale));
    width: calc(236px * var(--lm-scale));
    height: calc(16px * var(--lm-scale));
    font-size: calc(7.5px * var(--lm-scale));
    font-weight: 800;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    color: #14532d;
    line-height: calc(16px * var(--lm-scale));
    z-index: 3;
    white-space: nowrap;
    text-overflow: ellipsis;
  }
  .lm-santo {
    left: calc(38px * var(--lm-scale));
    top: calc(378px * var(--lm-scale));
    width: calc(292px * var(--lm-scale));
    height: calc(68px * var(--lm-scale));
    line-height: 1.22;
  }
  .lm-santo-nome {
    font-size: calc(9px * var(--lm-scale));
    font-weight: 800;
    color: #b91c1c;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .lm-santo-desc {
    margin-top: calc(2px * var(--lm-scale));
    font-size: calc(7.8px * var(--lm-scale));
    font-weight: 600;
    color: #334155;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .lm-foto {
    z-index: 1;
    left: calc(346px * var(--lm-scale));
    top: calc(256px * var(--lm-scale));
    width: calc(198px * var(--lm-scale));
    height: calc(132px * var(--lm-scale));
    clip-path: polygon(8% 6%, 92% 6%, 100% 22%, 100% 100%, 0 100%, 0 22%);
    overflow: hidden;
  }
  .lm-foto img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    display: block;
  }
  .lm-leituras {
    left: calc(116px * var(--lm-scale));
    top: calc(456px * var(--lm-scale));
    width: calc(444px * var(--lm-scale));
    height: calc(172px * var(--lm-scale));
    display: flex;
    flex-direction: column;
    gap: calc(5px * var(--lm-scale));
  }
  .lm-leitura-linha {
    flex: 1 1 0;
    min-height: 0;
    overflow: hidden;
  }
  .lm-ref {
    font-weight: 800;
    font-size: calc(8.2px * var(--lm-scale));
    color: #0b2d5c;
    line-height: 1.2;
    margin-bottom: calc(1px * var(--lm-scale));
  }
  .lm-trecho {
    font-family: "Source Sans 3", system-ui, sans-serif;
    font-size: calc(8px * var(--lm-scale));
    font-weight: 600;
    color: #1e3a5f;
    line-height: 1.22;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .lm-igmr {
    left: calc(116px * var(--lm-scale));
    top: calc(666px * var(--lm-scale));
    width: calc(444px * var(--lm-scale));
    height: calc(88px * var(--lm-scale));
    font-family: "Cormorant Garamond", Georgia, serif;
    font-size: calc(8.6px * var(--lm-scale));
    color: #1e3a5f;
    line-height: 1.38;
  }
  .lm-igmr-label {
    font-family: "Source Sans 3", sans-serif;
    font-size: calc(7px * var(--lm-scale));
    font-weight: 800;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: #0b2d5c;
    margin: 0 0 calc(2px * var(--lm-scale));
  }
  .lm-igmr-texto {
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 5;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .lm-igmr-pendente {
    font-family: "Source Sans 3", sans-serif;
    font-size: calc(7px * var(--lm-scale));
    color: #9a3412;
    background: rgba(254, 243, 199, 0.85);
    padding: calc(4px * var(--lm-scale));
    border-radius: calc(4px * var(--lm-scale));
    margin: 0;
  }
  .lm-escala {
    left: calc(40px * var(--lm-scale));
    top: calc(850px * var(--lm-scale));
    width: calc(508px * var(--lm-scale));
    border-collapse: collapse;
    table-layout: fixed;
    font-size: calc(7.8px * var(--lm-scale));
  }
  .lm-escala td {
    padding: calc(3px * var(--lm-scale)) calc(2px * var(--lm-scale));
    vertical-align: middle;
    font-weight: 700;
    color: #0b2d5c;
    text-align: center;
    height: calc(21px * var(--lm-scale));
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .lm-escala .lm-col-hora { width: 14%; font-weight: 800; }
  .lm-escala .lm-col-pres { width: 26%; font-size: calc(7.2px * var(--lm-scale)); }
  .lm-escala .lm-col-min { width: 15%; font-size: calc(7.2px * var(--lm-scale)); }
</style>
