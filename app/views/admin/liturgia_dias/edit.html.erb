<div class="space-y-6 max-w-4xl">
  <div>
    <%= link_to "← Voltar", admin_liturgia_dia_path(@liturgia_dia), class: "text-sm text-slate-500 hover:text-slate-800" %>
    <h1 class="text-2xl font-semibold text-stone-800 mt-1">Editar liturgia de <%= l(@liturgia_dia.data) %></h1>
    <p class="text-stone-500 text-sm mt-1">Ao salvar, a liturgia volta para <strong>rascunho</strong> e precisa ser validada de novo.</p>
  </div>

  <%= form_with model: @liturgia_dia, url: admin_liturgia_dia_path(@liturgia_dia), method: :patch, class: "space-y-6" do |f| %>
    <% if @liturgia_dia.errors.any? %>
      <div class="rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800">
        <ul class="list-disc pl-5"><% @liturgia_dia.errors.full_messages.each do |m| %><li><%= m %></li><% end %></ul>
      </div>
    <% end %>

    <section class="bg-white rounded-xl border border-stone-200 p-4 grid sm:grid-cols-2 gap-4">
      <div class="sm:col-span-2">
        <%= f.label :titulo, "Título da celebração", class: "block text-sm font-medium text-stone-700 mb-1" %>
        <%= f.text_field :titulo, class: "w-full rounded-lg border-stone-300" %>
      </div>
      <div>
        <%= f.label :cor, "Cor litúrgica", class: "block text-sm font-medium text-stone-700 mb-1" %>
        <%= f.select :cor, LiturgiaDia::CORES, { include_blank: true }, class: "w-full rounded-lg border-stone-300" %>
      </div>
    </section>

    <section class="bg-white rounded-xl border border-stone-200 p-4 space-y-4">
      <h2 class="font-semibold text-stone-800">Santo do dia</h2>
      <div>
        <%= f.label :santo_nome, "Nome (ex.: São Daniel Comboni, bispo — memória)", class: "block text-sm font-medium text-stone-700 mb-1" %>
        <%= f.text_field :santo_nome, class: "w-full rounded-lg border-stone-300" %>
      </div>
      <div>
        <%= f.label :santo_descricao, "Breve descrição (opcional)", class: "block text-sm font-medium text-stone-700 mb-1" %>
        <%= f.text_area :santo_descricao, rows: 3, class: "w-full rounded-lg border-stone-300" %>
      </div>
      <div>
        <%= f.label :imagem_santo, "Imagem (opcional — se não houver, não é exibida)", class: "block text-sm font-medium text-stone-700 mb-1" %>
        <% if @liturgia_dia.imagem_santo.attached? && @liturgia_dia.imagem_santo.persisted? %>
          <div class="flex items-center gap-3 mb-2">
            <%= image_tag url_for(@liturgia_dia.imagem_santo), class: "w-20 h-20 rounded-lg object-cover border border-stone-200" %>
            <%= link_to "Remover imagem", remover_imagem_admin_liturgia_dia_path(@liturgia_dia), data: { turbo_method: :delete, turbo_confirm: "Remover a imagem?" }, class: "text-sm text-red-600 hover:underline" %>
          </div>
        <% end %>
        <%= f.file_field :imagem_santo, accept: "image/*", class: "block text-sm" %>
        <p class="text-xs text-stone-400 mt-1">JPG, PNG ou WebP, até 5 MB.</p>
      </div>
    </section>

    <section class="space-y-4">
      <h2 class="font-semibold text-stone-800">Leituras</h2>
      <% @liturgia_dia.leituras_ordenadas.each_with_index do |l, i| %>
        <div class="bg-white rounded-xl border border-stone-200 p-4 space-y-3">
          <%= hidden_field_tag "leituras[#{i}][tipo]", l["tipo"] %>
          <%= hidden_field_tag "leituras[#{i}][rotulo]", l["rotulo"] %>
          <div class="grid sm:grid-cols-3 gap-3">
            <div>
              <label class="block text-xs font-medium text-stone-500 mb-1">Tipo</label>
              <p class="text-sm font-semibold text-stone-800 py-2"><%= @liturgia_dia.rotulo_leitura(l) %></p>
            </div>
            <div class="sm:col-span-2">
              <label class="block text-xs font-medium text-stone-500 mb-1">Referência</label>
              <%= text_field_tag "leituras[#{i}][referencia]", l["referencia"], class: "w-full rounded-lg border-stone-300" %>
            </div>
          </div>
          <div>
            <label class="block text-xs font-medium text-stone-500 mb-1">Texto</label>
            <%= text_area_tag "leituras[#{i}][texto]", l["texto"], rows: 10, class: "w-full rounded-lg border-stone-300 text-sm leading-relaxed" %>
          </div>
        </div>
      <% end %>
    </section>

    <section class="bg-white rounded-xl border border-stone-200 p-4">
      <%= f.label :observacoes, "Observações internas (não aparecem ao ministro)", class: "block text-sm font-medium text-stone-700 mb-1" %>
      <%= f.text_area :observacoes, rows: 2, class: "w-full rounded-lg border-stone-300" %>
    </section>

    <div class="flex items-center gap-3">
      <%= f.submit "Salvar", class: "px-5 py-2 rounded-lg bg-slate-700 text-white font-medium hover:bg-slate-800 cursor-pointer" %>
      <%= link_to "Cancelar", admin_liturgia_dia_path(@liturgia_dia), class: "text-sm text-stone-600 hover:underline" %>
    </div>
  <% end %>
</div>
