<% unless liturgia_dia.validada? %>
  <div class="rounded-xl border border-amber-200 bg-amber-50 px-4 py-4 text-sm text-amber-900">
    <p class="font-semibold">Briefing indisponível</p>
    <p class="mt-1">Valide a liturgia do dia para montar o texto do cartaz WhatsApp (ChatGPT).</p>
  </div>
<% else %>
  <% checklist = Liturgia::BriefingChecklist.new(liturgia_dia) %>
  <% briefing = checklist.briefing_liberado? ? Liturgia::CartazBriefing.text(liturgia_dia) : nil %>
  <div data-controller="liturgia-briefing" class="rounded-xl border border-sky-200 bg-gradient-to-br from-sky-50 to-blue-50/60 overflow-hidden">
    <div class="px-4 py-3 border-b border-sky-100/80">
      <p class="text-sm font-semibold text-sky-950">Cartaz WhatsApp (ChatGPT)</p>
      <p class="text-xs text-sky-800/90 mt-0.5 leading-snug">
        Confira o checklist. O texto abaixo só aparece quando a IGMR do dia estiver cadastrada.
      </p>
    </div>

    <ul class="px-4 py-3 space-y-2" aria-label="Checklist do briefing">
      <% checklist.items.each do |item| %>
        <li class="flex items-start gap-3 text-sm">
          <% if item.ok %>
            <span class="shrink-0 mt-0.5 flex h-5 w-5 items-center justify-center rounded-full bg-emerald-100 text-emerald-700" aria-hidden="true">
              <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
            </span>
          <% else %>
            <span class="shrink-0 mt-0.5 flex h-5 w-5 items-center justify-center rounded-full <%= item.bloqueia ? 'bg-amber-100 text-amber-800' : 'bg-sky-100 text-sky-600' %>" aria-hidden="true">
              <% if item.bloqueia %>
                <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
              <% else %>
                <span class="text-[10px] font-bold leading-none">—</span>
              <% end %>
            </span>
          <% end %>
          <div class="min-w-0 flex-1">
            <p class="font-medium text-stone-800">
              <%= item.label %>
              <% if item.bloqueia && !item.ok %>
                <span class="text-amber-800 font-semibold text-xs ml-1">(obrigatório)</span>
              <% end %>
            </p>
            <p class="text-xs text-stone-600 mt-0.5 leading-snug"><%= item.detail %></p>
            <% if item.action_path.present? && (!item.ok || item.id == :igmr) %>
              <%= link_to item.action_label, item.action_path, class: "inline-block mt-1 text-xs font-semibold text-sky-700 hover:text-sky-900 hover:underline" %>
            <% end %>
          </div>
        </li>
      <% end %>
    </ul>

    <% if checklist.briefing_liberado? %>
      <div class="px-4 pb-4 space-y-3 border-t border-sky-100 pt-4 bg-white/50">
        <p class="text-xs text-emerald-800 font-medium">Copie o bloco e cole no ChatGPT com o seu template.</p>
        <textarea data-liturgia-briefing-target="textarea" readonly rows="18" class="w-full text-xs font-mono text-stone-800 bg-white border border-sky-200 rounded-lg p-3 leading-relaxed focus:outline-none focus:ring-2 focus:ring-sky-400 focus:border-sky-400"><%= briefing %></textarea>
        <div class="flex flex-wrap gap-2">
          <button type="button" data-liturgia-briefing-target="copyButton" data-action="click->liturgia-briefing#copy" class="px-4 py-2.5 rounded-lg bg-sky-600 text-white text-sm font-medium hover:bg-sky-700 cursor-pointer">
            Copiar para o ChatGPT
          </button>
          <% if liturgia_dia.imagem_santo.attached? %>
            <%= link_to "Baixar foto do santo", rails_blob_path(liturgia_dia.imagem_santo, disposition: "attachment"),
                  class: "px-4 py-2.5 rounded-lg border border-sky-300 text-sky-900 text-sm font-medium hover:bg-sky-50" %>
          <% end %>
        </div>
      </div>
    <% else %>
      <div class="px-4 py-3 border-t border-sky-100 bg-amber-50/80 text-xs text-amber-900">
        Cadastre a <strong>IGMR n.º <%= checklist.igmr_numero %></strong> na
        <%= link_to "aba IGMR", admin_liturgia_dia_path(liturgia_dia, aba: "igmr"), class: "font-semibold underline hover:no-underline" %>
        para liberar o texto.
      </div>
    <% end %>
  </div>
<% end %>
