<div class="space-y-6 max-w-xl">
  <%= link_to "← Destinatários", admin_destinatarios_esportula_index_path, class: "text-sm text-stone-500 hover:text-stone-700" %>
  <h1 class="text-2xl font-semibold text-stone-800">Editar destinatário</h1>
  <div class="bg-white rounded-xl border border-stone-200 p-6">
    <%= form_with model: @destinatario, url: admin_destinatarios_esportula_path(@destinatario), method: :patch, scope: :destinatario_esportula, local: true, class: "space-y-4" do |f| %>
      <%= render "form", f: f %>
      <%= f.submit "Salvar", class: "px-4 py-2.5 bg-slate-600 text-white rounded-lg cursor-pointer" %>
    <% end %>
  </div>
</div>
