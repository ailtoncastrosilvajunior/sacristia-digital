<%# locals: f %>
<div>
  <%= f.label :nome, class: "block text-sm font-medium text-stone-700 mb-1" %>
  <%= f.text_field :nome, class: "w-full px-4 py-2.5 rounded-lg border border-stone-300" %>
</div>
<div>
  <%= f.label :observacoes, "Observações", class: "block text-sm font-medium text-stone-700 mb-1" %>
  <%= f.text_area :observacoes, rows: 3, class: "w-full px-4 py-2.5 rounded-lg border border-stone-300" %>
</div>
<div class="flex items-center gap-2">
  <%= f.check_box :ativo, class: "rounded border-stone-300" %>
  <%= f.label :ativo, "Ativo", class: "text-sm text-stone-700" %>
</div>
