<% campo = "w-full px-4 py-2.5 rounded-lg border border-stone-300 bg-white text-stone-800 shadow-sm focus:outline-none focus:ring-2 focus:ring-sky-500/25 focus:border-sky-600" %>
<% area = "#{campo} resize-y min-h-[12rem] font-serif text-[15px] leading-relaxed" %>
<% area_trecho = "#{campo} resize-y min-h-[6rem] font-serif text-[15px] leading-relaxed" %>
<% cancel_path = local_assigns[:return_to].presence || admin_igmr_paragrafos_path %>

<%= form_with model: [:admin, paragrafo], class: "space-y-4 rounded-xl border border-stone-200 bg-white p-6" do |f| %>
  <%= render "admin/shared/return_to_hidden", return_to: local_assigns[:return_to] %>
  <% if paragrafo.errors.any? %>
    <ul class="text-sm text-red-700 list-disc pl-5">
      <% paragrafo.errors.full_messages.each do |m| %><li><%= m %></li><% end %>
    </ul>
  <% end %>

  <p class="text-sm text-stone-600 rounded-lg bg-sky-50 border border-sky-100 px-3 py-2">
    Transcreva do <strong>livro físico</strong> ou da tradução CNBB. O briefing e o cartaz usam o <strong>trecho do card</strong> (se preenchido); a IA não deve reescrever a IGMR.
    <%= link_to "Referências oficiais", referencia_admin_igmr_paragrafos_path, class: "text-sky-700 font-semibold hover:underline" %>
  </p>

  <div class="max-w-[8rem]">
    <%= f.label :numero, "Número", class: "block text-sm font-medium text-stone-700 mb-1" %>
    <%= f.number_field :numero, min: 1, class: campo, required: true %>
  </div>

  <div>
    <%= f.label :edicao, "Edição de referência", class: "block text-sm font-medium text-stone-700 mb-1" %>
    <%= f.text_field :edicao, class: campo, placeholder: IgmrParagrafo::EDICAO_REFERENCIA %>
  </div>

  <div>
    <%= f.label :fonte, "Onde conferiu (opcional)", class: "block text-sm font-medium text-stone-700 mb-1" %>
    <%= f.text_field :fonte, class: campo, placeholder: "Ex.: Livro físico IGMR, págs. 42–43" %>
  </div>

  <div>
    <%= f.label :texto, "Texto integral do parágrafo", class: "block text-sm font-medium text-stone-700 mb-1" %>
    <%= f.text_area :texto, rows: 14, class: area, required: true, placeholder: "Parágrafo completo, sem adaptações." %>
  </div>

  <div>
    <%= f.label :trecho_cartaz, "Trecho para o cartaz / briefing", class: "block text-sm font-medium text-stone-700 mb-1" %>
    <p class="text-xs text-stone-500 mb-1">Recorte que cabe no card. Se vazio, usa o parágrafo integral.</p>
    <%= f.text_area :trecho_cartaz, rows: 5, class: area_trecho, placeholder: "Opcional — só o trecho que aparece no WhatsApp." %>
  </div>

  <label class="flex items-center gap-2 text-sm text-stone-700">
    <%= f.check_box :texto_conferido, class: "rounded border-stone-300" %>
    Conferido com o livro físico
  </label>

  <div class="flex gap-2 pt-2">
    <%= f.submit "Salvar", class: "px-4 py-2 rounded-lg bg-slate-700 text-white text-sm font-semibold hover:bg-slate-800 cursor-pointer" %>
    <%= link_to "Cancelar", cancel_path, class: "px-4 py-2 text-sm text-stone-600 hover:text-stone-900" %>
  </div>
<% end %>
