<div class="space-y-6 max-w-2xl">
  <%= link_to "← Textos IGMR", admin_igmr_paragrafos_path, class: "text-sm text-slate-500 hover:text-slate-800" %>
  <div>
    <h1 class="text-2xl font-semibold text-stone-800">Importar parágrafos IGMR</h1>
    <p class="text-sm text-stone-500 mt-1">
      CSV com cabeçalho <code class="text-xs bg-stone-100 px-1 rounded">numero;texto;fonte;texto_conferido</code>
      (vírgula também funciona). Transcreva do livro oficial; marque <code class="text-xs bg-stone-100 px-1 rounded">texto_conferido</code> como
      <code class="text-xs bg-stone-100 px-1 rounded">true</code> ou <code class="text-xs bg-stone-100 px-1 rounded">sim</code> após conferência.
    </p>
  </div>

  <% if @resultado&.erros&.any? %>
    <div class="rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-900">
      <p class="font-semibold mb-1">Erros</p>
      <ul class="list-disc pl-5 space-y-0.5"><% @resultado.erros.each do |e| %><li><%= e %></li><% end %></ul>
    </div>
  <% end %>

  <%= form_with url: importar_admin_igmr_paragrafos_path, method: :post, multipart: true,
        class: "space-y-4 rounded-xl border border-stone-200 bg-white p-6" do %>
    <div>
      <label class="block text-sm font-medium text-stone-700 mb-1.5" for="arquivo">Arquivo CSV</label>
      <input type="file" name="arquivo" id="arquivo" accept=".csv,text/csv" required
             class="block w-full text-sm text-stone-600 file:mr-3 file:rounded-lg file:border-0 file:bg-slate-700 file:px-4 file:py-2 file:text-white file:font-medium">
    </div>
    <label class="flex items-center gap-2 text-sm text-stone-700">
      <input type="checkbox" name="atualizar_existentes" value="1" checked class="rounded border-stone-300">
      Atualizar parágrafos que já existem (mesmo número)
    </label>
    <%= submit_tag "Importar", class: "px-4 py-2 rounded-lg bg-slate-700 text-white text-sm font-semibold hover:bg-slate-800 cursor-pointer" %>
  <% end %>

  <p class="text-xs text-stone-500">
    Modelo: <%= link_to "igmr_paragrafos.exemplo.csv", "/fixtures/igmr_paragrafos.exemplo.csv", class: "text-sky-700 hover:underline" %>
    ou linha de comando: <code class="bg-stone-100 px-1 rounded">bin/rails igmr:import[caminho/arquivo.csv]</code>
  </p>
</div>
