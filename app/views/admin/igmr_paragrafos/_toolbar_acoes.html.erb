<%# locals: numero (required), igmr (optional), return_to (optional), show_novo: true %>
<% btn_icone = "inline-flex p-1.5 rounded-lg text-stone-400 transition-colors" %>
<% return_to = local_assigns[:return_to] %>
<% show_novo = local_assigns.fetch(:show_novo, true) %>
<div class="flex items-center gap-1 shrink-0">
  <%= button_to sincronizar_cnbb_admin_igmr_paragrafos_path,
        method: :post,
        params: { return_to: return_to },
        form: { class: "inline" },
        title: "Sincronizar textos CNBB",
        aria: { label: "Sincronizar textos CNBB" },
        data: { turbo_confirm: "Atualiza parágrafos a partir do fixture oficial CNBB. Textos já marcados como conferidos no livro não serão alterados." },
        class: "#{btn_icone} hover:text-slate-600 hover:bg-stone-100 border-0 bg-transparent cursor-pointer" do %>
    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h5M20 20v-5h-5M5.5 15A7 7 0 0018.4 9M18.5 9A7 7 0 005.6 15"/></svg>
  <% end %>
  <% if igmr %>
    <%= link_to edit_admin_igmr_paragrafo_path(igmr, return_to: return_to),
          title: "Editar parágrafo",
          aria: { label: "Editar parágrafo" },
          class: "#{btn_icone} hover:text-sky-600 hover:bg-sky-50" do %>
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
    <% end %>
  <% elsif show_novo %>
    <%= link_to new_admin_igmr_paragrafo_path(numero: numero, return_to: return_to),
          title: "Cadastrar parágrafo",
          aria: { label: "Cadastrar parágrafo" },
          class: "#{btn_icone} hover:text-sky-600 hover:bg-sky-50" do %>
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
    <% end %>
  <% end %>
  <%= link_to admin_igmr_paragrafos_path,
        title: "Ver todos os parágrafos",
        aria: { label: "Ver todos os parágrafos" },
        class: "#{btn_icone} hover:text-sky-600 hover:bg-sky-50" do %>
    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 10h16M4 14h16M4 18h16"/></svg>
  <% end %>
  <%= link_to referencia_admin_igmr_paragrafos_path,
        title: "Referências para conferência",
        aria: { label: "Referências para conferência" },
        class: "#{btn_icone} hover:text-sky-600 hover:bg-sky-50" do %>
    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/></svg>
  <% end %>
</div>
