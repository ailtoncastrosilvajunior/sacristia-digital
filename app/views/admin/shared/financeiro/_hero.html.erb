<%# locals: eyebrow, title, subtitle: nil %>
<div class="relative overflow-hidden rounded-3xl border border-sky-200/25 bg-gradient-to-br from-slate-900 via-slate-900 to-sky-950 text-white shadow-xl shadow-slate-900/20">
  <div class="absolute inset-0 opacity-[0.06]" style="background-image: url('data:image/svg+xml,%3Csvg width=\'60\' height=\'60\' viewBox=\'0 0 60 60\' xmlns=\'http://www.w3.org/2000/svg\'%3E%3Cg fill=\'none\' fill-rule=\'evenodd\'%3E%3Cg fill=\'%23ffffff\' fill-opacity=\'1\'%3E%3Cpath d=\'M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z\'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E');" aria-hidden="true"></div>
  <div class="absolute -right-16 -top-16 h-48 w-48 rounded-full bg-sky-500/20 blur-3xl pointer-events-none" aria-hidden="true"></div>
  <div class="relative px-4 py-4 sm:px-6 sm:py-5 flex flex-col gap-4">
    <div class="flex flex-col lg:flex-row lg:items-start lg:justify-between gap-4">
      <div class="min-w-0">
        <p class="text-sky-300/90 text-[10px] font-semibold tracking-[0.2em] uppercase leading-none"><%= eyebrow %></p>
        <h1 class="mt-1.5 text-xl sm:text-2xl font-bold tracking-tight leading-tight"><%= title %></h1>
        <% if subtitle.present? %>
          <p class="mt-1 text-sm text-slate-300/95"><%= subtitle %></p>
        <% end %>
      </div>
      <% if local_assigns[:toolbar] %>
        <div class="shrink-0"><%= toolbar %></div>
      <% end %>
    </div>
    <% if local_assigns[:actions] %>
      <div class="flex flex-wrap items-center gap-2 pt-0.5 border-t border-white/10"><%= actions %></div>
    <% end %>
  </div>
</div>
