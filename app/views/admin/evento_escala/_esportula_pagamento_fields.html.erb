<%# locals: f — modo e destinatário do pagamento %>
<% destinatarios = DestinatarioEsportula.ativos.ordenados %>
<div class="rounded-xl border border-emerald-200/80 bg-emerald-50/40 p-4 space-y-3">
  <h3 class="text-sm font-semibold text-stone-800">Espórtula — pagamento</h3>
  <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
    <div>
      <%= f.label :esportula_modo, "Modo", class: "block text-xs font-medium text-stone-600 mb-1" %>
      <%= f.select :esportula_modo,
            esportula_modo_select_options,
            {}, class: "w-full px-3 py-2 rounded-lg border border-stone-300 text-sm bg-white" %>
    </div>
    <div>
      <%= f.label :esportula_destinatario_tipo, "Tipo de destinatário", class: "block text-xs font-medium text-stone-600 mb-1" %>
      <%= f.select :esportula_destinatario_tipo,
            [["Sacerdote", "sacerdote"], ["Instituição", "instituicao"]],
            {}, class: "w-full px-3 py-2 rounded-lg border border-stone-300 text-sm bg-white" %>
    </div>
  </div>
  <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
    <div>
      <%= f.label :esportula_destinatario_sacerdote_id, "Sacerdote destinatário", class: "block text-xs font-medium text-stone-600 mb-1" %>
      <%= f.collection_select :esportula_destinatario_sacerdote_id, Sacerdote.ativos.ordenados_por_nome, :id, :nome,
            { include_blank: "Celebrante (padrão)" },
            class: "w-full px-3 py-2 rounded-lg border border-stone-300 text-sm bg-white" %>
    </div>
    <div>
      <%= f.label :destinatario_esportula_id, "Instituição", class: "block text-xs font-medium text-stone-600 mb-1" %>
      <%= f.collection_select :destinatario_esportula_id, destinatarios, :id, :nome,
            { include_blank: "—" },
            class: "w-full px-3 py-2 rounded-lg border border-stone-300 text-sm bg-white" %>
    </div>
  </div>
  <% if f.object.persisted? %>
    <div class="flex flex-wrap items-center gap-3 pt-1">
      <label class="inline-flex items-center gap-2 text-xs text-stone-600">
        <%= check_box_tag :recalcular_esportula_regra, "1", false, class: "rounded border-stone-300" %>
        Aplicar regra automática ao salvar (ignora ajuste manual)
      </label>
      <% if f.object.esportula_destinatario_manual? %>
        <span class="text-[10px] font-medium text-amber-800 bg-amber-100 px-2 py-0.5 rounded">Manual</span>
      <% end %>
    </div>
  <% end %>
  <p class="text-[11px] text-stone-500 leading-snug">
    Acumulado: quitado via card «Destinatários» na tela de espórtulas. Substituto no horário fixo recebe de forma imediata (regra automática).
  </p>
</div>
