<%# Drawer com os dados do evento. Espera @evento carregado com includes (sem N+1). %>
<turbo-frame id="evento_drawer" data-action="turbo:frame-load->drawer#open" class="flex flex-col h-full min-h-0">
  <% ev = @evento %>
  <% ts = ev.tipo_servico %>
  <% cor = ts.cor_etiqueta.presence || "#64748b" %>
  <% ems = ev.escala_ministros.select { |em| em.ministro.present? } %>
  <% requer = ev.requer_ministros? %>
  <% drawer_filtros = params.permit(:tipo_servico_id, :sacerdote_id, :ministro_id, :dia_semana, :vista, :aba, :vista_calendario, :data_ref).to_unsafe_h.compact_blank %>
  <% status_estilo = {
       "pendente" => "bg-amber-50 text-amber-800 border-amber-200",
       "confirmado" => "bg-emerald-100 text-emerald-800 border-emerald-200",
       "concluido" => "bg-sky-100 text-sky-800 border-sky-200",
       "cancelado" => "bg-red-100 text-red-800 border-red-200"
     }.fetch(ev.status, "bg-stone-100 text-stone-700 border-stone-200") %>

  <div class="px-5 py-4 border-b border-stone-200 border-t-4" style="border-top-color: <%= cor %>;">
    <div class="flex items-start justify-between gap-3">
      <div class="min-w-0">
        <p class="text-[10px] font-semibold tracking-[0.18em] uppercase text-stone-400">Evento</p>
        <div class="mt-1 flex flex-wrap items-center gap-2">
          <span class="inline-flex px-3 py-1 text-sm font-bold rounded-lg border-2 text-slate-900" style="background-color: <%= cor %>33; border-color: <%= cor %>;"><%= ts.nome %></span>
          <span class="inline-flex px-2 py-0.5 rounded-full border text-[10px] font-bold uppercase tracking-wide <%= status_estilo %>"><%= I18n.t("activerecord.attributes.evento_escala.status_values.#{ev.status}", default: ev.status.humanize) %></span>
        </div>
        <p class="mt-2 text-sm font-semibold text-stone-800 tabular-nums">
          <%= I18n.t("date.day_names")[ev.data.wday].capitalize %>, <%= l(ev.data) %> às <%= l(ev.horario, format: :time) %>
        </p>
      </div>
      <button type="button" data-action="click->drawer#close" class="shrink-0 p-1.5 rounded-lg text-stone-400 hover:text-stone-600 hover:bg-stone-100 transition-colors" aria-label="Fechar">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
      </button>
    </div>
  </div>

  <div class="flex-1 overflow-y-auto px-5 py-4 space-y-5">
    <dl class="grid grid-cols-2 gap-x-4 gap-y-3 text-sm">
      <div class="col-span-2">
        <dt class="text-[10px] font-bold uppercase tracking-wider text-stone-400">Sacerdote</dt>
        <dd class="mt-0.5 text-stone-800 font-medium"><%= ev.sacerdote&.nome || tag.span("Não definido", class: "text-red-500 italic font-normal") %></dd>
      </div>
      <% if mostrar_esportula? %>
      <div>
        <dt class="text-[10px] font-bold uppercase tracking-wider text-stone-400">Espórtula</dt>
        <dd class="mt-0.5 text-stone-800 tabular-nums"><%= ev.valor_esportula.present? ? number_to_currency(ev.valor_esportula, unit: "R$ ", separator: ",", delimiter: ".") : "—" %></dd>
      </div>
      <% end %>
      <div>
        <dt class="text-[10px] font-bold uppercase tracking-wider text-stone-400">Local</dt>
        <dd class="mt-0.5 text-stone-800"><%= ev.local.presence || "—" %></dd>
      </div>
      <% if ev.plantao_periodo.present? %>
      <div class="col-span-2">
        <dt class="text-[10px] font-bold uppercase tracking-wider text-stone-400">Plantão</dt>
        <dd class="mt-0.5 text-stone-800"><%= ev.plantao_periodo.rotulo %></dd>
      </div>
      <% end %>
    </dl>

    <section>
      <div class="flex items-center justify-between mb-2">
        <h3 class="text-[10px] font-bold uppercase tracking-wider text-stone-400">Ministros</h3>
        <% if requer %>
        <span class="text-xs font-semibold tabular-nums <%= ems.size >= ev.quantidade_ministros.to_i && ems.any? ? 'text-emerald-700' : (ems.empty? ? 'text-red-600' : 'text-amber-700') %>">
          <%= ems.size %> de <%= ev.quantidade_ministros %>
        </span>
        <% end %>
      </div>
      <% if requer %>
        <% if ems.any? %>
        <ul class="divide-y divide-stone-100 rounded-lg border border-stone-200">
          <% ems.sort_by { |em| [em.coordenador? ? 0 : 1, I18n.transliterate(em.ministro.nome.to_s).downcase] }.each do |em| %>
          <li class="flex items-center justify-between gap-2 px-3 py-2 text-sm">
            <span class="text-stone-800 truncate"><%= em.ministro.nome %></span>
            <span class="flex items-center gap-1 shrink-0">
              <% if em.coordenador? %><span class="px-1.5 py-0.5 rounded bg-amber-100 text-amber-900 text-[10px] font-bold uppercase">Coord.</span><% end %>
              <% if em.adoracao? %><span class="px-1.5 py-0.5 rounded bg-fuchsia-100 text-fuchsia-900 text-[10px] font-bold uppercase">Ador.</span><% end %>
            </span>
          </li>
          <% end %>
        </ul>
        <% else %>
        <p class="rounded-lg border border-dashed border-stone-300 px-3 py-4 text-center text-sm text-stone-400 italic">Ninguém escalado ainda</p>
        <% end %>
      <% else %>
        <p class="rounded-lg bg-stone-50 border border-stone-200 px-3 py-3 text-sm text-stone-500">Este evento não requer ministros.</p>
      <% end %>
    </section>

    <% if ev.descricao.present? %>
    <section>
      <h3 class="text-[10px] font-bold uppercase tracking-wider text-stone-400 mb-1">Descrição</h3>
      <p class="text-sm text-stone-700 whitespace-pre-line"><%= ev.descricao %></p>
    </section>
    <% end %>
    <% if ev.observacoes.present? %>
    <section>
      <h3 class="text-[10px] font-bold uppercase tracking-wider text-stone-400 mb-1">Observações</h3>
      <p class="text-sm text-stone-700 whitespace-pre-line"><%= ev.observacoes %></p>
    </section>
    <% end %>
  </div>

  <div class="flex flex-wrap gap-2 px-5 py-3 border-t border-stone-200 bg-stone-50/70">
    <% if escala_extra_context? %>
      <%= link_to edit_evento_extra_path(ev), data: { turbo_frame: "_top" }, class: "inline-flex items-center gap-1.5 px-3 py-2 rounded-lg border border-stone-300 text-stone-700 hover:bg-white text-sm font-semibold transition-colors" do %>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
        Editar
      <% end %>
    <% else %>
      <%= link_to escalar_ministros_admin_evento_escala_path(ev, drawer_filtros), data: { turbo_frame: "evento_modal", action: "click->drawer#close" }, class: "inline-flex items-center gap-1.5 px-3 py-2 rounded-lg border border-sky-500 text-sky-700 hover:bg-sky-50 text-sm font-semibold transition-colors" do %>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
        <%= requer ? "Escalar" : "Escalar sacerdote" %>
      <% end %>
      <%= link_to edit_admin_evento_escala_path(ev, drawer_filtros), data: { turbo_frame: "evento_modal", action: "click->drawer#close" }, class: "inline-flex items-center gap-1.5 px-3 py-2 rounded-lg border border-stone-300 text-stone-700 hover:bg-white text-sm font-semibold transition-colors" do %>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
        Editar
      <% end %>
    <% end %>
    <% if ev.extra? %>
      <%= button_to evento_extra_path(ev), method: :delete, form: { data: { turbo_frame: "_top", turbo_confirm: "Tem certeza que deseja excluir este evento extra?" }, class: "ml-auto" },
          class: "inline-flex items-center gap-1.5 px-3 py-2 rounded-lg border border-red-200 text-red-700 hover:bg-red-50 bg-white text-sm font-semibold transition-colors cursor-pointer" do %>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
        Excluir
      <% end %>
    <% end %>
  </div>
</turbo-frame>
