<%# locals: evento, variant (aceito por compatibilidade), compacto — usa o badge padrão de ministro: coordenador primeiro, depois ordem alfabética; adoração com o ícone da custódia. %>
<% ministros = escala_ministros_do_evento(evento) %>
<% if ministros.empty? %>
  <% if local_assigns[:variant].to_s == "chips" %>
    <span class="text-stone-400 italic text-sm">Ninguém escalado ainda</span>
  <% else %>
    —
  <% end %>
<% else %>
  <div class="flex flex-wrap gap-1">
    <% ministros.each do |m| %>
      <%= render "painel_ministro/escala_mensal/ministro_badge", nome: m[:nome], adoracao: m[:adoracao] %>
    <% end %>
  </div>
<% end %>
