<%= turbo_frame_tag "esportula_conferencia_caixa" do %>
  <% c = @conferencia %>
  <% comp = c[:competencia] %>
  <% t = c[:totais] %>
  <div class="flex max-h-[min(90vh,720px)] w-full max-w-[min(96vw,72rem)] flex-col overflow-hidden rounded-2xl border border-stone-200 bg-white shadow-2xl">
    <div class="flex shrink-0 items-start justify-between gap-3 border-b border-stone-100 bg-gradient-to-b from-white to-stone-50 px-4 py-3 sm:px-5">
      <div class="min-w-0">
        <p class="text-[10px] font-bold uppercase tracking-widest text-sky-700">Conferência</p>
        <h2 class="text-lg font-semibold text-stone-900 truncate">Espórtulas × plano 2.1 · <%= comp.label %></h2>
        <p class="text-[11px] text-stone-500 mt-0.5 leading-snug max-w-2xl">
          <strong>Imediato</strong> por dia (previsto na data do evento; 2.1 = extrato 2.1 do dia, exceto lotes acumulados).
          <strong>Acumulado</strong> só totais do mês. <strong>Δ</strong> = 2.1 − previsto.
          Totais: previsto <%= number_to_currency(t[:previsto], precision: 0) %>,
          pago <%= number_to_currency(t[:pago_escala], precision: 0) %>,
          2.1 <%= number_to_currency(t[:caixa_21], precision: 0) %>,
          Δ <%= number_to_currency(t[:delta_mes], precision: 0) %>.
        </p>
      </div>
      <button type="button"
              class="shrink-0 rounded-lg border border-stone-200 bg-white p-2 text-stone-500 hover:bg-stone-50 hover:text-stone-800"
              data-action="click->modal#close"
              aria-label="Fechar">
        <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
      </button>
    </div>

    <div class="flex-1 min-h-0 overflow-auto overscroll-contain px-3 py-3 sm:px-4 space-y-4">
      <div>
        <p class="text-[10px] font-bold uppercase tracking-widest text-emerald-800 mb-1.5 px-0.5">Pagamento imediato</p>
        <%= render "admin/registros_esportula/competencia/conferencia_matriz",
              dias: c[:imediato][:dias],
              linhas: c[:imediato][:linhas] %>
      </div>
      <div>
        <p class="text-[10px] font-bold uppercase tracking-widest text-violet-800 mb-1.5 px-0.5">Pagamento acumulado</p>
        <%= render "admin/registros_esportula/competencia/conferencia_acumulado",
              resumo: c[:acumulado] %>
      </div>
    </div>

    <div class="shrink-0 border-t border-stone-100 bg-stone-50 px-4 py-2.5 flex flex-wrap items-center justify-between gap-2 text-[10px] text-stone-500">
      <span>Células <span class="font-semibold text-amber-800 bg-amber-100 px-1 rounded">destacadas</span> = Δ imediato no dia ≠ 0</span>
      <%= link_to admin_financeiro_resumo_path(mes: comp.mes, ano: comp.ano, aba: "plano_contas"),
            class: "font-semibold text-sky-700 hover:text-sky-900",
            target: "_blank",
            rel: "noopener" do %>
        Abrir resumo gerencial ↗
      <% end %>
    </div>
  </div>
<% end %>
