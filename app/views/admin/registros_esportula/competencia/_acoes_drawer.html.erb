<%# locals: competencia, mostrar_recibos: %>
<div class="flex flex-col h-full min-h-0 bg-white">
  <div class="shrink-0 flex items-center justify-between px-4 py-4 border-b border-stone-200">
    <div class="min-w-0">
      <p class="text-[10px] font-semibold uppercase tracking-wider text-stone-500">Espórtulas</p>
      <h4 class="text-base font-semibold text-stone-900 truncate"><%= competencia.label %></h4>
    </div>
    <button type="button" data-action="drawer#close" class="shrink-0 p-1.5 rounded-lg text-stone-400 hover:text-stone-600 hover:bg-stone-100 transition-colors" aria-label="Fechar">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
    </button>
  </div>
  <div class="flex-1 overflow-y-auto p-4 space-y-2">
    <%= link_to admin_destinatarios_esportula_index_path,
          class: "flex items-center gap-3 w-full rounded-xl border border-stone-200 bg-white px-4 py-3 text-sm font-semibold text-stone-800 hover:bg-stone-50 transition-colors" do %>
      <svg class="w-5 h-5 text-stone-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/></svg>
      Instituições destinatárias
    <% end %>

    <%= link_to new_admin_registros_esportula_path(competencia_ano: competencia.ano, competencia_mes: competencia.mes),
          class: "flex items-center gap-3 w-full rounded-xl border border-stone-200 bg-white px-4 py-3 text-sm font-semibold text-stone-800 hover:bg-stone-50 transition-colors" do %>
      <svg class="w-5 h-5 text-stone-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
      Lançamento avulso
    <% end %>

    <%= link_to admin_registros_esportula_index_path,
          class: "flex items-center gap-3 w-full rounded-xl border border-stone-800 bg-stone-800 px-4 py-3 text-sm font-semibold text-white hover:bg-stone-700 transition-colors" do %>
      <svg class="w-5 h-5 shrink-0 opacity-90" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 10h16M4 14h16M4 18h16"/></svg>
      Todos os registros
    <% end %>

    <%= link_to conferencia_caixa_admin_registros_esportula_index_path(competencia_mensal_id: competencia.id),
          data: {
            turbo_frame: "esportula_conferencia_caixa",
            action: "click->drawer#close"
          },
          class: "flex items-center gap-3 w-full rounded-xl border border-sky-200 bg-sky-50 px-4 py-3 text-sm font-semibold text-sky-900 hover:bg-sky-100 transition-colors" do %>
      <svg class="w-5 h-5 text-sky-700 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
      Conferir caixa
    <% end %>

    <% if mostrar_recibos %>
      <%= link_to recibo_esportula_form_admin_path(competencia_mensal_id: competencia.id),
            data: {
              turbo_frame: "esportula_recibo_drawer",
              action: "click->drawer#close"
            },
            class: "flex items-center gap-3 w-full rounded-xl border border-violet-200 bg-violet-50 px-4 py-3 text-sm font-semibold text-violet-900 hover:bg-violet-100 transition-colors" do %>
        <svg class="w-5 h-5 text-violet-700 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z"/></svg>
        Gerar recibos (PDF)
        <span class="ml-auto text-[10px] font-normal text-violet-700/80">escolher espórtulas</span>
      <% end %>
    <% end %>
  </div>
</div>
