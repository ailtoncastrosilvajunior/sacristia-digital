<%# locals: competencia %>
<div class="flex flex-col h-full min-h-0 bg-white">
  <div class="shrink-0 px-4 py-3 border-b border-stone-200 bg-gradient-to-b from-stone-50 to-white flex items-start justify-between gap-3">
    <div>
      <p class="text-[10px] font-semibold uppercase tracking-wider text-stone-500">Pagamento acumulado</p>
      <h3 class="text-base font-semibold text-stone-900" data-esportula-acumulado-pagar-target="destinatarioNome">—</h3>
      <p class="text-sm text-stone-600 mt-0.5">
        Saldo: <span class="font-bold tabular-nums text-indigo-800" data-esportula-acumulado-pagar-target="saldo">—</span>
      </p>
    </div>
    <button type="button" data-action="drawer#close" class="shrink-0 p-1.5 rounded-lg text-stone-400 hover:text-stone-600 hover:bg-stone-100" aria-label="Fechar">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
    </button>
  </div>
  <div class="flex-1 overflow-y-auto p-4">
    <%= form_with url: pagar_lote_acumulado_admin_registros_esportula_index_path, method: :post, local: true, class: "space-y-4" do %>
      <%= hidden_field_tag :competencia_mensal_id, competencia.id %>
      <input type="hidden" name="destinatario_tipo" value="" data-esportula-acumulado-pagar-target="destinatarioTipo" />
      <input type="hidden" name="destinatario_esportula_id" value="" data-esportula-acumulado-pagar-target="destinatarioEsportulaId" />
      <input type="hidden" name="destinatario_sacerdote_id" value="" data-esportula-acumulado-pagar-target="destinatarioSacerdoteId" />
      <div>
        <label for="acumulado_data_pagamento" class="block text-sm font-medium text-stone-700 mb-1">Data do pagamento</label>
        <%= date_field_tag :data_pagamento, Date.current, id: "acumulado_data_pagamento",
              class: "w-full px-3 py-2.5 rounded-lg border border-stone-300",
              data: { esportula_acumulado_pagar_target: "dataPagamento" } %>
      </div>
      <div>
        <label for="acumulado_forma_pagamento" class="block text-sm font-medium text-stone-700 mb-1">Forma (opcional)</label>
        <%= text_field_tag :forma_pagamento, nil, id: "acumulado_forma_pagamento", placeholder: "PIX, dinheiro…",
              class: "w-full px-3 py-2.5 rounded-lg border border-stone-300" %>
      </div>
      <p class="text-xs text-stone-500 leading-snug">
        Confirma o pagamento de todas as espórtulas acumuladas pendentes deste destinatário na competência <%= competencia.label_curto %>.
      </p>
      <div class="flex gap-2 pt-2">
        <%= submit_tag "Confirmar pagamento", class: "flex-1 px-4 py-2.5 rounded-xl bg-slate-600 hover:bg-slate-700 text-white text-sm font-semibold cursor-pointer" %>
        <button type="button" data-action="drawer#close" class="px-4 py-2.5 rounded-xl border border-stone-300 text-stone-700 text-sm font-medium hover:bg-stone-50">
          Cancelar
        </button>
      </div>
    <% end %>
  </div>
</div>
