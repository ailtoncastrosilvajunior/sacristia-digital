<%# locals: linha, resumo_eventos_map, competencia %>
<% s = linha[:sacerdote] %>
<% quitado = linha[:saldo].to_d.zero? && linha[:previsto].to_d.positive? %>
<% zebra = s.id.even? %>
<% eventos = (resumo_eventos_map || {})[s.id] || [] %>
<tr id="<%= dom_id(s, :esportula_resumo) %>"
    data-esportula-resumo-filter-target="row"
    data-nome="<%= s.nome %>"
    data-eventos="<%= h(eventos.to_json) %>"
    class="group border-b border-slate-100/90 transition-colors <%= zebra ? 'bg-slate-50/35' : 'bg-white' %> hover:bg-sky-50/60">
  <td class="px-2.5 py-2 align-middle">
    <%= link_to s.nome, admin_sacerdote_path(s), class: "font-semibold text-slate-800 group-hover:text-sky-800 leading-snug block truncate max-w-[9rem]", title: s.nome %>
  </td>
  <td class="px-1 py-2 text-center align-middle" data-esportula-resumo-missas>
    <% if linha[:missas].positive? %>
      <span class="inline-flex min-w-[1.25rem] justify-center rounded-md bg-sky-100 px-1 py-0.5 text-[10px] font-bold tabular-nums text-sky-800 ring-1 ring-sky-200/80"><%= linha[:missas] %></span>
    <% else %>
      <span class="text-slate-300 tabular-nums">·</span>
    <% end %>
  </td>
  <td class="px-1 py-2 text-center align-middle" data-esportula-resumo-confissoes>
    <% if linha[:confissoes].positive? %>
      <span class="inline-flex min-w-[1.25rem] justify-center rounded-md bg-amber-100 px-1 py-0.5 text-[10px] font-bold tabular-nums text-amber-900 ring-1 ring-amber-200/80"><%= linha[:confissoes] %></span>
    <% else %>
      <span class="text-slate-300 tabular-nums">·</span>
    <% end %>
  </td>
  <td class="px-1 py-2 text-center align-middle">
    <span data-esportula-resumo-total class="inline-flex min-w-[1.35rem] justify-center rounded-md bg-slate-200/80 px-1 py-0.5 text-[10px] font-black tabular-nums text-slate-800"><%= linha[:total_servicos] %></span>
  </td>
  <td class="px-2 py-2 text-right align-middle tabular-nums font-semibold text-emerald-900 whitespace-nowrap" data-esportula-resumo-previsto>
    <%= number_to_currency(linha[:previsto], precision: 0) %>
  </td>
  <td class="px-2 py-2 text-right align-middle tabular-nums font-semibold text-sky-800 whitespace-nowrap" data-esportula-resumo-realizado>
    <%= number_to_currency(linha[:realizado], precision: 0) %>
  </td>
  <td class="px-2.5 py-2 text-right align-middle tabular-nums font-bold whitespace-nowrap <%= quitado ? 'text-emerald-700' : 'text-indigo-800' %>" data-esportula-resumo-saldo>
    <%= number_to_currency(linha[:saldo], precision: 0) %>
  </td>
  <td class="px-1 py-2 text-center align-middle">
    <%= link_to recibo_esportula_form_admin_path(competencia_mensal_id: competencia.id, sacerdote_id: s.id),
          data: { turbo_frame: "esportula_recibo_drawer" },
          class: "inline-flex items-center justify-center min-w-[2.5rem] rounded-md border border-violet-200 bg-violet-50 px-1.5 py-0.5 text-[9px] font-bold uppercase tracking-wide text-violet-900 hover:bg-violet-100 transition-colors",
          title: "Escolher espórtulas e gerar recibo (A5) — #{s.nome}",
          aria: { label: "Recibo de #{s.nome}" } do %>
      Recibo
    <% end %>
  </td>
</tr>
