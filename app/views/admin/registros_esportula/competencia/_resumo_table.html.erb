<%# locals: resumo_por_sacerdote, resumo_totais %>
<div id="esportulas_competencia_resumo" class="bg-gradient-to-b from-slate-50/50 to-white">
  <table class="w-full text-xs">
    <thead class="sticky top-0 z-10 bg-slate-800 text-[9px] font-bold uppercase tracking-wide text-slate-300 border-b border-slate-700">
      <tr>
        <th class="px-2.5 py-2 text-left font-semibold min-w-[6.5rem]">Sacerdote</th>
        <th class="px-1 py-2 text-center w-8" title="Missas">M</th>
        <th class="px-1 py-2 text-center w-8" title="Confissões">C</th>
        <th class="px-1 py-2 text-center w-8" title="Serviços">Σ</th>
        <th class="px-2 py-2 text-right text-emerald-200/90 whitespace-nowrap">Previsto</th>
        <th class="px-2 py-2 text-right text-sky-200/90 whitespace-nowrap">Pago</th>
        <th class="px-2.5 py-2 text-right text-indigo-200/90 whitespace-nowrap">Saldo</th>
      </tr>
    </thead>
    <tbody>
      <% resumo_por_sacerdote.each do |linha| %>
        <%= render "admin/registros_esportula/competencia/resumo_row", linha: linha %>
      <% end %>
    </tbody>
    <%= render "admin/registros_esportula/competencia/resumo_foot", resumo_totais: resumo_totais %>
  </table>
</div>
