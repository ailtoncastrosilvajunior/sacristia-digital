<%# locals: competencia, linhas %>
<div class="rounded-2xl border border-slate-200/90 bg-white shadow-md shadow-slate-900/5 overflow-hidden ring-1 ring-slate-100 min-w-0 w-full">
  <div class="px-3 py-2 border-b border-slate-700/50 bg-gradient-to-br from-slate-800 via-slate-800 to-sky-900 text-white flex flex-wrap items-center justify-between gap-2">
    <div class="min-w-0">
      <p class="text-[9px] font-semibold uppercase tracking-widest text-sky-300/90">Pagamentos acumulados</p>
      <h2 class="text-sm font-semibold tracking-tight truncate">Destinatários · <%= competencia.label_curto %></h2>
      <p class="text-[11px] text-slate-400 mt-0.5">Pagamento mensal por destinatário</p>
    </div>
    <%= link_to admin_destinatarios_esportula_index_path,
          class: "inline-flex shrink-0 items-center gap-1 rounded-md border border-white/15 bg-white/10 px-2 py-1 text-[10px] font-semibold text-white hover:bg-white/20 transition-colors" do %>
      <svg class="w-3 h-3 opacity-90" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
      Instituição
    <% end %>
  </div>
  <% if linhas.any? %>
    <div class="overflow-x-auto bg-gradient-to-b from-slate-50/50 to-white max-h-[min(28vh,240px)] overflow-y-auto">
      <table class="w-full text-xs">
        <thead class="sticky top-0 z-10 bg-slate-800 text-[9px] font-bold uppercase tracking-wide text-slate-300 border-b border-slate-700">
          <tr>
            <th class="px-2 py-1.5 text-left">Destinatário</th>
            <th class="px-1 py-1.5 text-center w-8">M</th>
            <th class="px-1.5 py-1.5 text-right text-emerald-200/90">Prev.</th>
            <th class="px-1.5 py-1.5 text-right text-indigo-200/90">Saldo</th>
            <th class="px-1 py-1.5 w-[3.25rem] text-center"></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100/90">
          <% linhas.each do |linha| %>
            <tr class="hover:bg-sky-50/60">
              <td class="px-2 py-1.5 font-semibold text-slate-800 truncate max-w-[8rem]" title="<%= linha.nome %>"><%= linha.nome %></td>
              <td class="px-1 py-1.5 text-center tabular-nums text-stone-600"><%= linha.missas %></td>
              <td class="px-1.5 py-1.5 text-right tabular-nums font-medium text-emerald-900 whitespace-nowrap"><%= number_to_currency(linha.previsto, precision: 0) %></td>
              <td class="px-1.5 py-1.5 text-right tabular-nums font-bold whitespace-nowrap <%= linha.saldo.zero? && linha.previsto.positive? ? 'text-emerald-700' : 'text-indigo-800' %>">
                <%= number_to_currency(linha.saldo, precision: 0) %>
              </td>
              <td class="px-1 py-1.5 text-center">
                <% if linha.saldo.positive? %>
                  <button type="button"
                          class="inline-flex items-center justify-center min-w-[2.75rem] rounded-md bg-slate-600 px-1.5 py-0.5 text-[9px] font-bold uppercase tracking-wide text-white shadow-sm hover:bg-slate-700 active:scale-[0.98] transition-colors"
                          data-action="esportula-acumulado-pagar#open"
                          data-nome="<%= linha.nome %>"
                          data-saldo="<%= number_to_currency(linha.saldo, precision: 0) %>"
                          data-destinatario-tipo="<%= linha.destinatario_tipo %>"
                          <% if linha.destinatario_tipo == "instituicao" %>
                          data-destinatario-esportula-id="<%= linha.destinatario_esportula.id %>"
                          <% else %>
                          data-destinatario-sacerdote-id="<%= linha.destinatario_sacerdote.id %>"
                          <% end %>>
                    Pagar
                  </button>
                <% elsif linha.lancamento_caixa %>
                  <%= esportula_link_lancamento_caixa(
                        linha.lancamento_caixa,
                        competencia_mensal_id: competencia.id,
                        label: "Extrato"
                      ) %>
                <% else %>
                  <span class="inline-flex min-w-[2.75rem] justify-center rounded-md bg-emerald-100 px-1.5 py-0.5 text-[9px] font-bold uppercase tracking-wide text-emerald-800 ring-1 ring-emerald-200/80" title="Quitado">OK</span>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <p class="px-3 py-6 text-center text-xs text-stone-500">Nenhuma acumulada nesta competência.</p>
  <% end %>
</div>
