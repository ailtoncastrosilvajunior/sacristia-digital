<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <title>Recibo de espórtulas — <%= competencia.label %></title>
  <style>
    *, *::before, *::after { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: "Segoe UI", system-ui, -apple-system, BlinkMacSystemFont, sans-serif;
      font-size: 8pt;
      line-height: 1.35;
      color: #1e293b;
      -webkit-print-color-adjust: exact;
      print-color-adjust: exact;
    }
    .recibo {
      page-break-after: always;
      break-after: page;
      width: 148mm;
      max-width: 148mm;
      margin: 0 auto;
    }
    .recibo:last-child {
      page-break-after: auto;
      break-after: auto;
    }
    .sheet {
      border: 1px solid #e2e8f0;
      border-radius: 8px;
      overflow: hidden;
    }
    .head {
      background: linear-gradient(135deg, #0f172a 0%, #1e3a5f 55%, #0c4a6e 100%);
      color: #f8fafc;
      padding: 10px 12px 9px;
      position: relative;
    }
    .head::after {
      content: "";
      position: absolute;
      right: -12px;
      top: -18px;
      width: 64px;
      height: 64px;
      border-radius: 50%;
      background: rgba(56, 189, 248, 0.12);
    }
    .head-kicker {
      font-size: 6pt;
      font-weight: 600;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: #7dd3fc;
      margin: 0 0 2px;
    }
    .head-title {
      margin: 0;
      font-size: 11pt;
      font-weight: 700;
      letter-spacing: -0.02em;
      line-height: 1.2;
    }
    .head-sacerdote {
      margin: 4px 0 0;
      font-size: 9pt;
      font-weight: 600;
      color: #e2e8f0;
    }
    .head-sub {
      margin: 2px 0 0;
      font-size: 7pt;
      color: #94a3b8;
    }
    .meta {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 6px 12px;
      padding: 7px 12px;
      background: #f8fafc;
      border-bottom: 1px solid #e2e8f0;
      font-size: 7pt;
    }
    .meta dt {
      font-weight: 600;
      color: #64748b;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      font-size: 5.5pt;
      margin: 0 0 1px;
    }
    .meta dd { margin: 0; font-weight: 600; color: #0f172a; }
    .body { padding: 8px 12px 10px; }
    .destaque {
      background: linear-gradient(90deg, #ecfdf5 0%, #f0f9ff 100%);
      border: 1px solid #bae6fd;
      border-radius: 6px;
      padding: 7px 9px;
      margin-bottom: 8px;
    }
    .destaque p { margin: 0; font-size: 7pt; color: #334155; }
    .destaque strong { color: #0f172a; }
    .valor-destaque {
      display: inline-block;
      margin-top: 4px;
      font-size: 11pt;
      font-weight: 800;
      color: #0369a1;
      letter-spacing: -0.02em;
    }
    .destaque .saldo-nota {
      margin: 4px 0 0;
      font-size: 6.5pt;
      color: #64748b;
    }
    table.servicos {
      width: 100%;
      border-collapse: collapse;
      font-size: 6.5pt;
      margin-bottom: 8px;
      table-layout: fixed;
    }
    table.servicos thead th {
      text-align: left;
      padding: 4px 5px;
      background: #f1f5f9;
      color: #475569;
      font-size: 5.5pt;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.04em;
      border-bottom: 1px solid #e2e8f0;
    }
    table.servicos tbody td {
      padding: 3px 5px;
      border-bottom: 1px solid #f1f5f9;
      vertical-align: top;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    table.servicos tbody tr:nth-child(even) td { background: #fafafa; }
    .num { text-align: right; font-variant-numeric: tabular-nums; white-space: nowrap; }
    .badge {
      display: inline-block;
      padding: 1px 4px;
      border-radius: 999px;
      font-size: 5pt;
      font-weight: 700;
      text-transform: uppercase;
    }
    .badge-pago { background: #d1fae5; color: #065f46; }
    .badge-pend { background: #fef3c7; color: #92400e; }
    .totais {
      display: flex;
      justify-content: flex-end;
      gap: 12px;
      margin-bottom: 8px;
    }
    .totais dl { margin: 0; text-align: right; }
    .totais dt { font-size: 5.5pt; text-transform: uppercase; letter-spacing: 0.05em; color: #64748b; font-weight: 600; }
    .totais dd { margin: 1px 0 0; font-size: 8.5pt; font-weight: 800; font-variant-numeric: tabular-nums; }
    .totais .saldo dd { color: #4338ca; }
    .totais .pago dd { color: #0284c7; }
    .totais .prev dd { color: #059669; }
    .assinatura {
      margin-top: 6px;
      padding-top: 8px;
      border-top: 1px dashed #cbd5e1;
    }
    .assinatura-local {
      margin: 0 0 4px;
      font-size: 6.5pt;
      color: #64748b;
    }
    .assinatura-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 14px;
      margin-top: 14px;
    }
    .linha-assinatura {
      border-top: 1px solid #334155;
      padding-top: 4px;
      text-align: center;
      font-size: 6.5pt;
      color: #475569;
    }
    .linha-assinatura strong {
      display: block;
      color: #0f172a;
      font-size: 7pt;
      margin-bottom: 1px;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .rodape {
      margin-top: 6px;
      font-size: 5.5pt;
      color: #94a3b8;
      text-align: center;
    }
    @page { size: A5 portrait; margin: 6mm 7mm; }
  </style>
</head>
<body>
  <% recibos.each do |recibo| %>
    <% s = recibo.sacerdote %>
    <% linha = recibo.linha %>
    <% ev = recibo.eventos.first %>
    <% ref = "REC-#{competencia.ano}#{format('%02d', competencia.mes)}-EV#{ev.id}" %>
    <% valor_recibo = ev.esportula_paga? ? linha[:realizado] : linha[:previsto] %>
    <article class="recibo">
      <div class="sheet">
        <header class="head">
          <p class="head-kicker"><%= paroquia_nome %></p>
          <h1 class="head-title">Recibo de espórtula</h1>
          <p class="head-sacerdote"><%= s.nome %></p>
          <p class="head-sub"><%= l(ev.data) %> · <%= ev.horario.strftime("%H:%M") %> · <%= ev.tipo_servico.nome %></p>
        </header>
        <dl class="meta">
          <div>
            <dt>Referência</dt>
            <dd><%= ref %></dd>
          </div>
          <div>
            <dt>Emitido em</dt>
            <dd><%= l(emitido_em.to_date) %></dd>
          </div>
          <div>
            <dt>Competência</dt>
            <dd><%= competencia.label_curto %></dd>
          </div>
          <div>
            <dt>Situação</dt>
            <dd><%= ev.esportula_paga? ? "Pago" : "Pendente" %></dd>
          </div>
        </dl>
        <div class="body">
          <div class="destaque">
            <p>
              Declaro ter recebido de <strong><%= paroquia_nome %></strong> a quantia abaixo,
              referente à espórtula do culto/serviço indicado neste recibo.
            </p>
            <span class="valor-destaque"><%= number_to_currency(valor_recibo, precision: 2) %></span>
            <% unless ev.esportula_paga? %>
              <p class="saldo-nota">Pagamento ainda pendente no controle da paróquia.</p>
            <% end %>
          </div>

          <table class="servicos">
            <thead>
              <tr>
                <th style="width: 22%">Data</th>
                <th style="width: 11%">Hora</th>
                <th>Serviço</th>
                <th class="num" style="width: 18%">Valor</th>
                <th style="width: 14%">St.</th>
              </tr>
            </thead>
            <tbody>
              <% recibo.eventos.each do |ev| %>
                <tr>
                  <td><%= l(ev.data, format: :short) %></td>
                  <td><%= ev.horario.strftime("%H:%M") %></td>
                  <td><%= ev.tipo_servico.nome %></td>
                  <td class="num"><%= number_to_currency(ev.valor_esportula, precision: 2) %></td>
                  <td>
                    <% if ev.esportula_paga? %>
                      <span class="badge badge-pago">Ok</span>
                    <% else %>
                      <span class="badge badge-pend">Pend.</span>
                    <% end %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>

          <div class="totais">
            <dl class="prev">
              <dt>Previsto</dt>
              <dd><%= number_to_currency(linha[:previsto], precision: 2) %></dd>
            </dl>
            <dl class="pago">
              <dt>Recebido</dt>
              <dd><%= number_to_currency(linha[:realizado], precision: 2) %></dd>
            </dl>
            <dl class="saldo">
              <dt>Saldo</dt>
              <dd><%= number_to_currency(linha[:saldo], precision: 2) %></dd>
            </dl>
          </div>

          <section class="assinatura">
            <p class="assinatura-local">
              Local e data: _________________________ , <%= l(emitido_em.to_date, format: :long) %>
            </p>
            <div class="assinatura-grid">
              <div class="linha-assinatura">
                <strong><%= s.nome %></strong>
                Assinatura do sacerdote
              </div>
              <div class="linha-assinatura">
                <strong>Administração</strong>
                Carimbo / assinatura
              </div>
            </div>
          </section>
          <p class="rodape">Sacristia Digital · <%= ref %></p>
        </div>
      </div>
    </article>
  <% end %>
</body>
</html>
