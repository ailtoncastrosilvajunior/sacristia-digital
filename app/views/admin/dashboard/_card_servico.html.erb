<% cor = ev.tipo_servico.cor_etiqueta.presence || "#64748b" %>
<% ministros = escala_ministros_do_evento(ev) %>
<% passado = local_assigns.fetch(:passado, false) %>
<li>
  <div class="flex items-stretch rounded-xl border border-stone-200/80 <%= passado ? "bg-stone-50/70 opacity-80 hover:opacity-100" : "bg-white" %> shadow-sm overflow-hidden hover:border-sky-300 hover:shadow-md transition-all">
    <div class="w-16 shrink-0 flex flex-col items-center justify-center py-2 bg-gradient-to-b from-sky-50 to-white border-r border-stone-100">
      <span class="text-[10px] font-bold uppercase tracking-wider text-sky-600"><%= I18n.t("date.abbr_day_names")[ev.data.wday] %></span>
      <span class="text-xl font-extrabold tabular-nums text-stone-900 leading-tight"><%= ev.data.day %></span>
      <span class="mt-0.5 inline-flex items-center gap-0.5 text-[11px] font-semibold text-sky-800 tabular-nums">
        <svg class="w-2.5 h-2.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
        <%= l(ev.horario, format: :time) %>
      </span>
    </div>

    <div class="flex-1 min-w-0 px-3 py-2.5">
      <div class="flex items-center gap-1.5 flex-wrap">
        <span class="inline-flex px-2 py-0.5 text-xs font-semibold rounded-md border" style="background-color: <%= cor %>22; border-color: <%= cor %>55; color: #1e293b;"><%= ev.tipo_servico.nome %></span>
        <% if ev.sacerdote %>
          <span class="text-sm font-bold text-stone-800 truncate"><%= ev.sacerdote.nome %></span>
        <% else %>
          <span class="text-sm text-stone-400 italic">Sacerdote a definir</span>
        <% end %>
        <% case ev.status
           when "confirmado" %>
          <span class="h-2 w-2 rounded-full bg-emerald-500 shrink-0" title="Confirmado"></span>
        <% when "concluido" %>
          <span class="h-2 w-2 rounded-full bg-sky-500 shrink-0" title="Concluído"></span>
        <% when "pendente" %>
          <span class="h-2 w-2 rounded-full bg-amber-400 shrink-0" title="Pendente"></span>
        <% end %>
      </div>

      <% if ministros.any? %>
        <div class="mt-2 flex flex-wrap gap-1">
          <% ministros.each do |m| %>
            <%= render "painel_ministro/escala_mensal/ministro_badge", nome: m[:nome], meu: m[:meu], adoracao: m[:adoracao] %>
          <% end %>
        </div>
      <% else %>
        <p class="mt-2 inline-flex items-center gap-1.5 text-[11px] font-semibold uppercase tracking-wide text-amber-800 bg-amber-50 px-2 py-1 rounded-lg ring-1 ring-amber-200/70 w-fit">
          <svg class="w-3.5 h-3.5 shrink-0 opacity-80" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
          </svg>
          Sem ministros escalados
        </p>
      <% end %>
    </div>

  </div>
</li>
