<% content_for :title, "Dashboard — Sacristia Digital" %>
<div class="min-h-full">
  <%# Hero + seletor %>
  <div class="relative overflow-hidden rounded-2xl border border-slate-200/80 bg-gradient-to-br from-slate-900 via-slate-800 to-sky-900 text-white shadow-md mb-5">
    <div class="absolute inset-0 opacity-[0.07]" style="background-image: url('data:image/svg+xml,%3Csvg width=\'60\' height=\'60\' viewBox=\'0 0 60 60\' xmlns=\'http://www.w3.org/2000/svg\'%3E%3Cg fill=\'none\' fill-rule=\'evenodd\'%3E%3Cg fill=\'%23ffffff\' fill-opacity=\'1\'%3E%3Cpath d=\'M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z\'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E');"></div>
    <%# Mobile: texto + competência. lg+: 2 colunas (imagem removida). %>
    <div class="relative grid grid-cols-[minmax(0,1fr)] grid-rows-[auto_auto] gap-x-3 gap-y-2 px-4 py-3 sm:px-5 sm:gap-x-4
                lg:grid-cols-[auto_minmax(0,1fr)_10.5rem] lg:grid-rows-1 lg:items-center lg:gap-4 lg:py-3 lg:px-6
                xl:grid-cols-[auto_minmax(0,1fr)_11.25rem] xl:gap-7 xl:pr-8">
      <div class="col-start-1 row-start-1 min-w-0 text-left">
        <p class="text-sky-300/90 text-[10px] sm:text-xs font-medium tracking-wide uppercase">Painel</p>
        <h1 class="text-lg sm:text-xl lg:text-2xl font-bold tracking-tight mt-0.5">Escala de serviços do período</h1>
        <p class="mt-1 text-slate-300 text-xs sm:text-sm leading-snug hidden sm:block">Escolha o período para ver estatísticas, próximos serviços e o mapa de intensidade do mês.</p>
      </div>
      <div class="col-start-2 row-start-2 min-w-0 w-full lg:col-start-3 lg:row-start-1 flex flex-col justify-center">
        <%= form_with url: admin_root_path, method: :get, local: true, class: "space-y-1" do %>
          <label for="dash_competencia" class="block text-[10px] font-medium text-slate-400 uppercase tracking-wider">Competência</label>
          <%= select_tag :competencia_mensal_id,
                options_from_collection_for_select(@competencias, :id, :label, @competencia&.id),
                { id: "dash_competencia", class: "w-full rounded-xl border-0 bg-white/10 text-white placeholder-slate-400 ring-1 ring-white/20 px-3 py-1.5 text-sm font-medium focus:ring-2 focus:ring-sky-400 focus:outline-none [&>option]:text-slate-900",
                  onchange: "this.form.requestSubmit()" } %>
          <noscript>
            <%= submit_tag "Atualizar", class: "w-full rounded-xl bg-sky-500 hover:bg-sky-400 px-3 py-2 text-sm font-semibold text-white" %>
          </noscript>
        <% end %>
      </div>
    </div>
  </div>

  <% if @competencias.empty? %>
    <div class="rounded-2xl border border-dashed border-stone-300 bg-white p-12 text-center">
      <p class="text-stone-600 mb-4">Ainda não há competências cadastradas.</p>
      <%= link_to "Criar primeira competência", new_admin_competencia_mensal_path, class: "inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-slate-800 text-white font-medium hover:bg-slate-700 transition-colors" %>
    </div>
  <% elsif @competencia.nil? %>
    <div class="rounded-2xl border border-amber-200 bg-amber-50 p-8 text-center text-amber-900">
      <p class="font-medium">Competência não encontrada.</p>
      <p class="text-sm mt-1 opacity-90">Selecione outra no menu acima.</p>
    </div>
  <% else %>
    <% s = @stats %>
    <% comp = @competencia %>
    <%= render "admin/shared/aviso_competencia_futura", competencia: comp %>
    <div class="flex flex-wrap items-center justify-between gap-4 mb-6">
      <div>
        <h2 class="text-xl font-semibold text-stone-900"><%= comp.label %></h2>
        <div class="flex flex-wrap items-center gap-2 mt-2">
          <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-semibold <%= comp.escala_gerada? ? "bg-emerald-100 text-emerald-800" : "bg-amber-100 text-amber-800" %>">
            <%= comp.escala_gerada? ? "Escala gerada" : "Escala pendente" %>
          </span>
          <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-semibold border <%= comp.escala_liberada? ? "bg-sky-50 text-sky-800 border-sky-200" : "bg-stone-100 text-stone-600 border-stone-200" %>">
            <%= comp.escala_liberada? ? (comp.futura? ? "Liberada — prévia, ainda não vale" : "Liberada aos ministros") : "Restrita" %>
          </span>
        </div>
      </div>
      <div class="flex flex-wrap gap-2">
        <%= link_to admin_competencia_mensal_path(comp, aba: "calendario"), class: "inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-slate-900 text-white text-sm font-medium hover:bg-slate-800 transition-colors shadow-sm" do %>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
          Calendário
        <% end %>
        <%= link_to admin_competencia_mensal_path(comp, aba: "lista"), class: "inline-flex items-center gap-2 px-4 py-2.5 rounded-xl border border-stone-200 bg-white text-stone-800 text-sm font-medium hover:bg-stone-50 transition-colors" do %>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 10h16M4 14h16M4 18h16"/></svg>
          Lista completa
        <% end %>
        <%= link_to admin_escala_mensal_imprimir_path(competencia_mensal_id: comp.id), target: "_blank", rel: "noopener", class: "inline-flex items-center gap-2 px-4 py-2.5 rounded-xl border border-stone-200 bg-white text-stone-800 text-sm font-medium hover:bg-stone-50 transition-colors" do %>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z"/></svg>
          Imprimir escala
        <% end %>
      </div>
    </div>

    <%# KPIs %>
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-2 sm:gap-3 mb-5">
      <div class="group relative overflow-hidden rounded-xl bg-white px-3 py-2.5 shadow-sm ring-1 ring-stone-200/80 hover:ring-sky-200/60 transition-all">
        <div class="absolute -right-4 -top-4 h-16 w-16 rounded-full bg-sky-500/10 blur-2xl group-hover:bg-sky-500/15 transition-colors"></div>
        <p class="text-[10px] font-semibold uppercase tracking-wider text-stone-500">Serviços no mês</p>
        <p class="mt-0.5 text-2xl font-bold tabular-nums text-stone-900"><%= s[:total] %></p>
        <p class="text-[11px] text-stone-500"><%= s[:dias_com_servico] %> dias com celebração</p>
      </div>
      <div class="group relative overflow-hidden rounded-xl bg-white px-3 py-2.5 shadow-sm ring-1 ring-stone-200/80 hover:ring-sky-200/60 transition-all">
        <div class="absolute -right-4 -top-4 h-16 w-16 rounded-full bg-sky-500/10 blur-2xl"></div>
        <p class="text-[10px] font-semibold uppercase tracking-wider text-stone-500">Com ministros</p>
        <p class="mt-0.5 text-2xl font-bold tabular-nums text-sky-700"><%= s[:com_ministros] %></p>
        <p class="text-[11px] text-stone-500"><%= s[:pct_equipe] %>% da escala preenchida</p>
      </div>
      <div class="group relative overflow-hidden rounded-xl bg-white px-3 py-2.5 shadow-sm ring-1 ring-stone-200/80 hover:ring-amber-200/60 transition-all">
        <div class="absolute -right-4 -top-4 h-16 w-16 rounded-full bg-amber-500/10 blur-2xl"></div>
        <p class="text-[10px] font-semibold uppercase tracking-wider text-stone-500">Coordenação</p>
        <p class="mt-0.5 text-2xl font-bold tabular-nums text-amber-700"><%= s[:com_coord] %></p>
        <p class="text-[11px] text-stone-500"><%= s[:com_adoracao] %> com adoração marcada</p>
      </div>
      <div class="group relative overflow-hidden rounded-xl bg-white px-3 py-2.5 shadow-sm ring-1 ring-stone-200/80 hover:ring-emerald-200/60 transition-all">
        <div class="absolute -right-4 -top-4 h-16 w-16 rounded-full bg-emerald-500/10 blur-2xl"></div>
        <p class="text-[10px] font-semibold uppercase tracking-wider text-stone-500">Status</p>
        <div class="mt-1 flex flex-wrap gap-x-3 gap-y-1 text-sm font-semibold tabular-nums">
          <span class="text-amber-600"><%= s[:pendentes] %> pend.</span>
          <span class="text-emerald-600"><%= s[:confirmados] %> conf.</span>
          <span class="text-sky-600"><%= s[:concluidos] %> conc.</span>
        </div>
        <p class="text-[11px] text-stone-500"><%= s[:com_sacerdote] %> com sacerdote</p>
      </div>
    </div>

    <div class="grid grid-cols-1 xl:grid-cols-12 gap-6 lg:gap-8">
      <%# Próximos %>
      <div class="xl:col-span-7 space-y-4">
       <div class="rounded-2xl border border-stone-200 bg-white shadow-sm overflow-hidden">
        <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-3 px-4 py-3 border-b border-stone-100 bg-gradient-to-b from-sky-50/60 to-white">
          <div class="flex items-start gap-3 min-w-0">
            <span class="hidden sm:flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-sky-100 text-sky-700 ring-1 ring-sky-200/80 shadow-sm">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            </span>
            <div class="min-w-0">
              <div class="flex flex-wrap items-center gap-2">
                <h3 class="text-lg font-semibold text-stone-900 tracking-tight">Próximos serviços</h3>
                <% if @proximos.any? %>
                  <span class="text-xs font-semibold tabular-nums text-stone-500 bg-stone-100 px-2 py-0.5 rounded-full"><%= @proximos.size %></span>
                <% end %>
              </div>
              <% if @lista_desde %>
                <p class="text-xs text-sky-700 font-medium mt-1.5 leading-relaxed">Mostrando a partir de <span class="tabular-nums"><%= l(@lista_desde, format: :long) %></span> — clique em outro dia no calendário para mudar.</p>
              <% else %>
                <p class="text-xs text-stone-500 mt-1.5 leading-relaxed">A partir de <span class="font-medium text-stone-700">hoje</span> (<span class="tabular-nums"><%= l(Date.current, format: :short) %></span>). Use o mapa ao lado para começar em outra data.</p>
              <% end %>
            </div>
          </div>
          <% if params[:lista_desde].present? %>
            <%= link_to admin_root_path(competencia_mensal_id: comp.id), class: "inline-flex shrink-0 items-center gap-1.5 px-3 py-2 rounded-xl text-xs font-semibold bg-stone-100 text-stone-800 hover:bg-stone-200 border border-stone-200 transition-colors" do %>
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>
              Voltar a partir de hoje
            <% end %>
          <% end %>
        </div>

        <div class="p-3">
        <% if @proximos.empty? %>
          <div class="rounded-2xl border border-dashed border-stone-200/90 bg-gradient-to-b from-sky-50/50 via-white to-white px-6 py-12 text-center shadow-sm">
            <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-2xl bg-sky-100 text-sky-700 ring-1 ring-sky-200/70 mb-4">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
            </div>
            <% if @lista_desde %>
              <p class="text-stone-700 font-medium text-sm">Nada a partir desta data</p>
              <p class="text-stone-500 text-sm mt-2 max-w-sm mx-auto">Não há serviços a partir de <span class="font-medium text-stone-700 tabular-nums"><%= l(@lista_desde) %></span> nesta competência.</p>
            <% else %>
              <p class="text-stone-700 font-medium text-sm">Sem eventos futuros</p>
              <p class="text-stone-500 text-sm mt-2 max-w-sm mx-auto">Não há celebrações agendadas adiante nesta competência, ou todas já ocorreram.</p>
            <% end %>
          </div>
        <% else %>
          <ul class="space-y-3 max-h-[28rem] overflow-y-auto pr-1">
            <% @proximos.each do |ev| %>
              <%= render "admin/dashboard/card_servico", ev: ev, comp: comp %>
            <% end %>
          </ul>
        <% end %>
        </div>
       </div>

        <% if @recentes_passados.any? %>
          <details class="group rounded-2xl border border-stone-200 bg-white shadow-sm overflow-hidden">
            <summary class="cursor-pointer list-none px-4 py-3 flex items-center justify-between text-sm font-medium text-stone-700 hover:bg-stone-50">
              <span>Serviços recentes (já realizados)</span>
              <svg class="w-4 h-4 text-stone-400 group-open:rotate-180 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
            </summary>
            <ul class="border-t border-stone-100 space-y-2 p-3 max-h-80 overflow-y-auto">
              <% @recentes_passados.each do |ev| %>
                <%= render "admin/dashboard/card_servico", ev: ev, comp: comp, passado: true %>
              <% end %>
            </ul>
          </details>
        <% end %>
      </div>

      <%# Heatmap — legenda integrada; ajuda extra no botão ? %>
      <div class="xl:col-span-5">
        <div class="rounded-2xl border border-stone-200/80 bg-white shadow-sm overflow-visible">
          <div class="relative flex flex-wrap items-start justify-between gap-2 px-4 py-3 border-b border-stone-100 bg-gradient-to-b from-slate-50/80 to-white rounded-t-2xl">
            <div class="min-w-0">
              <div class="flex flex-wrap items-center gap-2">
                <h3 class="text-lg font-semibold text-stone-900">Intensidade no mês</h3>
                <details>
                  <summary class="list-none cursor-pointer inline-flex h-6 w-6 items-center justify-center rounded-full bg-stone-100 text-[11px] font-bold text-stone-500 ring-1 ring-stone-200/80 hover:bg-stone-200 hover:text-stone-800 [&::-webkit-details-marker]:hidden" aria-label="Ajuda sobre o mapa do mês">?</summary>
                  <div class="absolute left-0 right-0 top-full z-30 mt-2 overflow-hidden rounded-2xl border border-stone-200/90 bg-white text-stone-600 shadow-xl shadow-stone-900/10 ring-1 ring-black/5">
                    <div class="border-b border-stone-100 bg-gradient-to-br from-slate-50 via-white to-sky-50/70 px-4 py-2.5 sm:px-5">
                      <p class="text-sm font-semibold text-stone-900">Como ler o mapa</p>
                    </div>

                    <div class="space-y-4 px-4 py-4 sm:px-5">
                      <div>
                        <p class="text-[10px] font-bold uppercase tracking-wider text-stone-500">Intensidade no dia</p>
                        <div class="mt-2 grid grid-cols-5 gap-2" role="list" aria-label="Escala de cores por quantidade de serviços">
                          <div class="flex flex-col items-center gap-1 text-center" role="listitem" title="Nenhum serviço">
                            <span class="h-9 w-full max-w-[3rem] rounded-lg bg-stone-100 shadow-sm ring-1 ring-stone-200/80"></span>
                            <span class="text-[11px] font-bold tabular-nums text-stone-600">0</span>
                          </div>
                          <div class="flex flex-col items-center gap-1 text-center" role="listitem" title="1 serviço">
                            <span class="h-9 w-full max-w-[3rem] rounded-lg bg-sky-200 shadow-sm ring-1 ring-black/5"></span>
                            <span class="text-[11px] font-bold tabular-nums text-stone-600">1</span>
                          </div>
                          <div class="flex flex-col items-center gap-1 text-center" role="listitem" title="2 serviços">
                            <span class="h-9 w-full max-w-[3rem] rounded-lg bg-sky-400 shadow-sm ring-1 ring-black/5"></span>
                            <span class="text-[11px] font-bold tabular-nums text-stone-600">2</span>
                          </div>
                          <div class="flex flex-col items-center gap-1 text-center" role="listitem" title="3 serviços">
                            <span class="h-9 w-full max-w-[3rem] rounded-lg bg-sky-600 shadow-sm ring-1 ring-black/5"></span>
                            <span class="text-[11px] font-bold tabular-nums text-stone-600">3</span>
                          </div>
                          <div class="flex flex-col items-center gap-1 text-center" role="listitem" title="4 ou mais serviços">
                            <span class="h-9 w-full max-w-[3rem] rounded-lg bg-sky-800 shadow-sm ring-1 ring-black/5"></span>
                            <span class="text-[11px] font-bold tabular-nums text-stone-600">4+</span>
                          </div>
                        </div>
                        <p class="mt-2.5 text-xs leading-relaxed text-stone-500">A cor de fundo de cada dia no mapa segue esta escala.</p>
                      </div>

                      <div class="rounded-xl border border-stone-200/80 bg-gradient-to-b from-stone-50 to-white p-4">
                        <p class="text-[10px] font-bold uppercase tracking-wider text-stone-500">Exemplo de um dia</p>
                        <div class="mt-3 grid grid-cols-[auto_minmax(0,1fr)] items-center gap-3 sm:gap-4">
                          <span class="inline-flex h-[4.25rem] w-[4.25rem] shrink-0 flex-col overflow-hidden rounded-xl bg-sky-600 text-white shadow-md ring-1 ring-sky-900/10" aria-hidden="true">
                            <span class="border-b border-white/35 py-1 text-center text-[11px] font-bold tabular-nums">31/10</span>
                            <span class="flex flex-1 items-center justify-center text-lg font-extrabold tabular-nums leading-none">
                              3<span class="mx-0.5 opacity-60">/</span><span class="text-amber-300">1</span>
                            </span>
                          </span>
                          <div class="min-w-0 space-y-1.5 text-sm leading-snug">
                            <p>
                              <span class="font-bold tabular-nums text-sky-700">3</span>
                              <span class="text-stone-600"> na escala </span><span class="font-medium text-stone-800">padrão</span>
                            </p>
                            <p>
                              <span class="font-bold tabular-nums text-amber-600">1</span>
                              <span class="text-stone-600"> na escala </span><span class="font-medium text-stone-800">extra</span>
                            </p>
                          </div>
                        </div>
                      </div>
                    </div>

                    <div class="border-t border-stone-100 bg-sky-50/40 px-4 py-3 sm:px-5">
                      <p class="text-[10px] font-bold uppercase tracking-wider text-sky-900/80 mb-2">Como usar</p>
                      <ol class="space-y-2 text-xs sm:text-sm leading-relaxed text-stone-700 list-none m-0 p-0">
                        <li class="flex gap-2"><span class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-sky-600 text-[10px] font-bold text-white">1</span><span>Clique em um dia para a lista à esquerda começar naquela data.</span></li>
                        <li class="flex gap-2"><span class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-sky-600 text-[10px] font-bold text-white">2</span><span>Abaixo do mapa aparecem os horários da data escolhida.</span></li>
                        <li class="flex gap-2"><span class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-sky-600 text-[10px] font-bold text-white">3</span><span>Dia cinza sem números = nenhuma celebração na escala.</span></li>
                      </ol>
                    </div>
                  </div>
                </details>
              </div>
            </div>
            <% if @lista_desde %>
              <%= link_to admin_root_path(competencia_mensal_id: comp.id),
                    class: "inline-flex shrink-0 items-center gap-1 rounded-lg bg-sky-100 px-2 py-1 text-[11px] font-semibold text-sky-900 ring-1 ring-sky-200/80 hover:bg-sky-200/80 transition-colors",
                    title: "Limpar filtro por dia" do %>
                <span class="tabular-nums"><%= l(@lista_desde, format: :short) %></span>
                <span aria-hidden="true">×</span>
              <% end %>
            <% end %>
          </div>

          <div class="p-4 sm:p-5 space-y-4">
            <div class="grid grid-cols-7 gap-1 text-center text-[10px] font-semibold text-stone-400">
              <% I18n.t("date.abbr_day_names").each do |nome| %><span class="truncate"><%= nome.first(3) %></span><% end %>
            </div>
            <% lead = comp.periodo.wday %>
            <div class="grid grid-cols-7 gap-1">
              <% lead.times do %>
                <div class="aspect-square rounded-lg bg-transparent min-h-[2.25rem]" aria-hidden="true"></div>
              <% end %>
              <% @heatmap.each do |cell| %>
                <% c = cell[:count] %>
                <% d = cell[:data] %>
                <% intensity = c.zero? ? 0 : [c, 4].min %>
                <% bg = case intensity
                        when 0 then "bg-stone-100"
                        when 1 then "bg-sky-200"
                        when 2 then "bg-sky-400"
                        when 3 then "bg-sky-600"
                        else "bg-sky-800"
                        end %>
                <% txt = intensity >= 2 ? "text-white" : "text-stone-700" %>
                <% extra_num_cls = intensity >= 2 ? "text-amber-300" : "text-amber-600" %>
                <% selected = @lista_desde == d %>
                <% aria = c.zero? ? "#{l(d)}: sem serviços" : "#{l(d)}: #{c} serviços (#{cell[:padrao]} padrão, #{cell[:extra]} extra)" %>
                <%= link_to admin_root_path(competencia_mensal_id: comp.id, lista_desde: d.strftime("%Y-%m-%d")),
                      class: "aspect-square rounded-lg #{bg} overflow-hidden flex flex-col items-center justify-start text-[10px] font-bold #{txt} shadow-sm ring-1 ring-black/5 min-h-[2.25rem] transition-transform hover:scale-[1.04] focus:outline-none focus-visible:ring-2 focus-visible:ring-sky-500 focus-visible:ring-offset-2 #{selected ? "ring-2 ring-sky-600 ring-offset-2 z-[1] scale-[1.02]" : ""}",
                      title: "#{aria} — filtrar lista",
                      aria: { label: "#{aria}. Filtrar próximos serviços a partir desta data." } do %>
                  <span class="w-full text-center tabular-nums text-[10px] font-bold leading-none py-0.5 border-b <%= intensity >= 2 ? "border-white/40 text-white" : "border-stone-400/40 text-stone-700" %>"><%= l(d, format: :short) %></span>
                  <% if c > 0 %>
                    <span class="flex-1 flex items-center tabular-nums text-sm font-extrabold leading-none">
                      <%= cell[:padrao] %><span class="opacity-70 font-bold">/</span><span class="<%= extra_num_cls %>"><%= cell[:extra] %></span>
                    </span>
                  <% end %>
                <% end %>
              <% end %>
            </div>

            <% if @lista_desde && @eventos_dia_filtro.any? %>
              <div class="rounded-xl bg-sky-50/80 border border-sky-100 p-3">
                <p class="text-[10px] font-bold uppercase tracking-wider text-sky-800 mb-2">Neste dia · <span class="tabular-nums"><%= l(@lista_desde, format: :short) %></span> <span class="normal-case tracking-normal font-semibold">(<%= l(@lista_desde, format: "%A") %>)</span></p>
                <ul class="space-y-2 max-h-48 overflow-y-auto">
                  <% @eventos_dia_filtro.each do |ev| %>
                    <% cor = ev.tipo_servico.cor_etiqueta.presence || "#64748b" %>
                    <li class="flex items-start gap-2 text-xs">
                      <span class="tabular-nums font-semibold text-stone-600 shrink-0 w-12"><%= l(ev.horario, format: :time) %></span>
                      <span class="inline-flex px-1.5 py-0.5 rounded text-[10px] font-semibold border leading-tight" style="background-color: <%= cor %>22; border-color: <%= cor %>55; color: #1e293b;"><%= ev.tipo_servico.nome %></span>
                    </li>
                  <% end %>
                </ul>
              </div>
            <% elsif @lista_desde %>
              <p class="text-xs text-stone-500 italic px-0.5">Nenhum serviço agendado exatamente neste dia — a lista à esquerda começa a partir desta data.</p>
            <% else %>
              <p class="text-[11px] text-stone-500 px-0.5">Selecione um dia no mapa para ver horários daquela data e reordenar os próximos serviços.</p>
            <% end %>
          </div>
        </div>
      </div>
    </div>

    <%# Espórtulas da competência %>
    <% es = @esportulas_stats %>
    <div class="mt-6 rounded-2xl border border-sky-200/80 bg-gradient-to-br from-sky-50 via-white to-blue-50/60 shadow-sm overflow-hidden ring-1 ring-sky-100/60">
      <div class="px-4 py-2.5 sm:px-5 border-b border-sky-100/80 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2">
        <div class="flex items-start gap-3">
          <div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-sky-600 text-white shadow-sm shadow-sky-600/25">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          </div>
          <div>
            <h3 class="text-base font-semibold text-stone-900">Espórtulas</h3>
            <p class="text-xs text-stone-600">Registros vinculados a <span class="font-medium text-stone-800"><%= comp.label %></span> (competência do registro).</p>
          </div>
        </div>
        <div class="flex flex-wrap gap-2 shrink-0">
          <%= link_to competencia_admin_registros_esportula_index_path(competencia_mensal_id: comp.id), class: "inline-flex items-center gap-2 px-3 py-1.5 rounded-lg bg-sky-700 text-white text-sm font-semibold hover:bg-sky-800 transition-colors shadow-sm" do %>
            Ver todas
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
          <% end %>
          <%= link_to new_admin_registros_esportula_path(competencia_ano: comp.ano, competencia_mes: comp.mes), class: "inline-flex items-center gap-2 px-3 py-1.5 rounded-lg border border-sky-300 bg-white text-sky-900 text-sm font-semibold hover:bg-sky-50 transition-colors" do %>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
            Novo registro
          <% end %>
        </div>
      </div>
      <div class="px-4 py-2 sm:px-5 grid grid-cols-2 sm:grid-cols-3 md:grid-cols-5 gap-1.5 sm:gap-2">
        <div class="rounded-xl bg-white/90 border border-emerald-100 px-2.5 py-1.5 shadow-sm">
          <p class="text-[10px] font-bold uppercase tracking-wider truncate text-emerald-800/90">Previsto nos eventos</p>
          <p class="text-base font-bold leading-tight tabular-nums text-emerald-900"><%= number_to_currency(es[:valor_previsto]) %></p>
          <p class="text-[10px] text-stone-500 truncate">Soma de <%= es[:eventos_com_valor] %> <%= es[:eventos_com_valor] == 1 ? "evento" : "eventos" %> com valor</p>
        </div>
        <div class="rounded-xl bg-white/90 border border-sky-100 px-2.5 py-1.5 shadow-sm">
          <p class="text-[10px] font-bold uppercase tracking-wider truncate text-sky-700/80">Registros</p>
          <p class="text-base font-bold leading-tight tabular-nums text-stone-900"><%= es[:total] %></p>
          <p class="text-[10px] text-stone-500 truncate"><%= es[:pendentes] %> pend. · <%= es[:pagos] %> pagos</p>
        </div>
        <div class="rounded-xl bg-white/90 border border-indigo-100 px-2.5 py-1.5 shadow-sm">
          <p class="text-[10px] font-bold uppercase tracking-wider truncate text-indigo-800/90">A pagar</p>
          <p class="text-base font-bold leading-tight tabular-nums text-indigo-900"><%= number_to_currency(es[:valor_pendente]) %></p>
          <p class="text-[10px] text-stone-500 truncate">Soma status pendente</p>
        </div>
        <div class="rounded-xl bg-white/90 border border-sky-100 px-2.5 py-1.5 shadow-sm">
          <p class="text-[10px] font-bold uppercase tracking-wider truncate text-sky-800/90">Quitado</p>
          <p class="text-base font-bold leading-tight tabular-nums text-sky-800"><%= number_to_currency(es[:valor_pago]) %></p>
          <p class="text-[10px] text-stone-500 truncate">Soma status pago</p>
        </div>
        <div class="rounded-xl bg-white/90 border border-stone-200 px-2.5 py-1.5 shadow-sm">
          <p class="text-[10px] font-bold uppercase tracking-wider truncate text-stone-500">No mês</p>
          <p class="text-base font-bold leading-tight tabular-nums text-stone-900"><%= number_to_currency(es[:valor_pendente] + es[:valor_pago]) %></p>
          <p class="text-[10px] text-stone-500 truncate">Total movimentado</p>
        </div>
      </div>
      <% if @esportulas_recentes.any? %>
        <div class="px-4 pb-3 sm:px-5">
          <p class="text-[11px] font-bold uppercase tracking-wider text-stone-500 mb-2">Últimos lançamentos</p>
          <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5 gap-2">
            <% @esportulas_recentes.each do |reg| %>
              <%= link_to admin_registros_esportula_path(reg),
                    class: "flex min-h-0 flex-col rounded-xl border border-sky-100 bg-white/90 px-2.5 py-2 shadow-sm hover:border-sky-200 hover:bg-sky-50/70 transition-colors group" do %>
                <div class="flex items-start justify-between gap-1.5 min-w-0">
                  <p class="text-sm font-medium text-stone-900 group-hover:text-sky-900 truncate leading-snug"><%= reg.sacerdote.nome %></p>
                  <span class="inline-flex shrink-0 px-1.5 py-0.5 text-[9px] font-bold uppercase rounded-full <%= reg.status == "pago" ? "bg-sky-100 text-sky-800" : "bg-indigo-100 text-indigo-800" %>">
                    <%= reg.status %>
                  </span>
                </div>
                <% horario_missa = reg.evento_escala&.horario %>
                <div class="mt-0.5 flex items-baseline justify-between gap-2 min-w-0">
                  <p class="text-[11px] text-stone-500 tabular-nums min-w-0 truncate">
                    <%= l(reg.data) %>
                    <% if horario_missa.present? %>
                      <span class="text-stone-400">·</span>
                      <span class="font-semibold text-stone-600"><%= horario_missa.strftime("%H:%M") %></span>
                    <% end %>
                  </p>
                  <p class="text-sm font-semibold tabular-nums text-stone-800 shrink-0 text-right"><%= number_to_currency(reg.valor) %></p>
                </div>
              <% end %>
            <% end %>
          </div>
        </div>
      <% else %>
        <div class="px-4 pb-3 sm:px-5 text-center">
          <p class="text-xs text-stone-600 mb-1">Nenhuma espórtula registrada para esta competência ainda.</p>
          <%= link_to "Cadastrar primeira espórtula", new_admin_registros_esportula_path(competencia_ano: comp.ano, competencia_mes: comp.mes), class: "inline-flex items-center gap-2 text-sm font-semibold text-sky-700 hover:text-sky-900" %>
        </div>
      <% end %>
    </div>

    <%# Cadastros rápidos (rodapé) %>
    <div class="mt-10 pt-8 border-t border-stone-200">
      <p class="text-xs font-semibold uppercase tracking-wider text-stone-500 mb-4">Cadastros</p>
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
        <div class="rounded-xl border border-stone-200 bg-white p-4 text-center">
          <p class="text-2xl font-bold tabular-nums text-stone-900"><%= Ministro.ativos.count %></p>
          <p class="text-xs text-stone-500 mt-1">Ministros ativos</p>
        </div>
        <div class="rounded-xl border border-stone-200 bg-white p-4 text-center">
          <p class="text-2xl font-bold tabular-nums text-stone-900"><%= Sacerdote.ativos.count %></p>
          <p class="text-xs text-stone-500 mt-1">Sacerdotes</p>
        </div>
        <div class="rounded-xl border border-stone-200 bg-white p-4 text-center">
          <p class="text-2xl font-bold tabular-nums text-stone-900"><%= TipoServico.ativos.count %></p>
          <p class="text-xs text-stone-500 mt-1">Tipos de serviço</p>
        </div>
        <div class="rounded-xl border border-stone-200 bg-white p-4 text-center">
          <p class="text-2xl font-bold tabular-nums text-stone-900"><%= CompetenciaMensal.count %></p>
          <p class="text-xs text-stone-500 mt-1">Competências totais</p>
        </div>
      </div>
    </div>
  <% end %>
</div>
