<%# locals: colunas, linhas, mes, ano %>
<% col_ref = colunas.find(&:referencia) %>
<% kpis = resumo_kpis_mes_referencia(linhas, col_ref) %>
<% grupos = resumo_grupos_plano_contas(linhas) %>
<% saldos_finais = resumo_saldos_finais_por_coluna(linhas, colunas) %>
<div class="space-y-4 sm:space-y-5 w-full">
<%= render "admin/financeiro_resumo/kpi_mes_ref", kpis: kpis, col_ref: col_ref %>

<%= render "admin/financeiro_resumo/matriz_plano_contas",
      colunas: colunas,
      col_ref: col_ref,
      grupos: grupos,
      saldos_finais: saldos_finais %>
<div class="pb-2"></div>
</div>
