<%# locals: colunas, linhas, mes, ano %>
<div class="space-y-4 sm:space-y-5 w-full">
<% col_ref = colunas.find(&:referencia) %>
<% kpis = resumo_kpis_mes_referencia(linhas, col_ref) %>
<% btn_hero = "inline-flex h-8 items-center gap-1.5 rounded-lg border border-white/20 bg-white/10 px-2.5 text-xs font-semibold text-white hover:bg-white/15 transition-colors" %>
<% mes_w = "7.25rem" %>
<% table_min_w = "#{15 + (colunas.size * 7.25)}rem" %>

<% toolbar = capture do %>
  <%= render "admin/shared/financeiro/periodo_filter", form_url: admin_financeiro_resumo_path, mes: mes, ano: ano, aba: "plano_contas", variant: :hero, id_prefix: "resumo" %>
<% end %>
<% actions = capture do %>
  <%= link_to admin_extrato_financeiro_path(mes: mes, ano: ano), class: btn_hero do %>
    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"/></svg>
    Ver extrato
  <% end %>
<% end %>
<%= render "admin/shared/financeiro/hero",
      eyebrow: "Resumo gerencial",
      title: "Demonstração analítica",
      subtitle: "Plano de contas · #{colunas.size} meses · ref. #{col_ref.label}",
      toolbar: toolbar,
      actions: actions %>

<%= render "admin/shared/financeiro/metric_strip", items: [
      { label: "Saldo anterior", value: formatar_moeda(kpis[:saldo_anterior]), tone: :slate, sublabel: col_ref.label, value_class: moeda_resumo_classe(kpis[:saldo_anterior]) },
      { label: "Entradas", value: formatar_moeda(kpis[:entradas]), tone: :emerald },
      { label: "Despesas", value: formatar_moeda(kpis[:saidas]), tone: :red },
      { label: "Saldo do mês", value: formatar_moeda(kpis[:saldo_final]), tone: :indigo, sublabel: "Fechamento", value_class: moeda_resumo_classe(kpis[:saldo_final]) }
    ] %>

<div class="rounded-2xl border border-slate-200/90 bg-white shadow-md shadow-slate-900/5 overflow-hidden ring-1 ring-slate-100 flex flex-col min-h-[20rem] max-h-[48rem] h-[calc(100dvh-22rem)]">
  <div class="shrink-0 flex items-center justify-between gap-3 px-4 py-2.5 border-b border-slate-100 bg-gradient-to-b from-white to-slate-50/90">
    <p class="text-xs font-semibold text-slate-600">Detalhamento analítico · mais recente à esquerda</p>
    <span class="inline-flex items-center gap-1.5 rounded-full bg-sky-100 px-2.5 py-1 text-[10px] font-bold uppercase tracking-wide text-sky-900 ring-1 ring-sky-200/80">
      Ref. <%= col_ref.label %>
    </span>
  </div>

  <div class="flex-1 min-h-0 overflow-auto overscroll-contain financeiro-resumo-scroll">
    <table class="w-full table-fixed border-collapse text-sm financeiro-resumo-matrix" style="min-width: <%= table_min_w %>;">
      <colgroup>
        <col style="width: 15rem" />
        <% colunas.size.times do %>
          <col style="width: <%= mes_w %>" />
        <% end %>
      </colgroup>
      <thead class="sticky top-0 z-30">
        <tr class="text-[10px] font-bold uppercase tracking-wider text-slate-500 bg-slate-50/95 backdrop-blur-sm border-b border-slate-200">
          <th scope="col" class="sticky left-0 z-40 px-4 py-2.5 text-left bg-slate-50/95 border-r border-slate-200/90 shadow-[4px_0_12px_-4px_rgba(15,23,42,0.08)]">Conta</th>
          <% colunas.each do |col| %>
            <th scope="col" class="px-2 py-2.5 text-right tabular-nums <%= col.referencia ? 'bg-sky-50/95 text-sky-950 ring-1 ring-inset ring-sky-200/70' : '' %>"><%= col.label %></th>
          <% end %>
        </tr>
      </thead>
      <tbody>
        <%= render "admin/financeiro_resumo/tbody", linhas: linhas, colunas: colunas %>
      </tbody>
    </table>
  </div>
</div>
</div>
