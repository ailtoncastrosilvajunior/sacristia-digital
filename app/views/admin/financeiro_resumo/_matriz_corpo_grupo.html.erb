<%# locals: title, accent, header_linha, linhas, colunas, empty_message: nil %>
<% accent_key = accent.to_s %>
<% theme = resumo_grupo_theme(accent_key) %>
<% col_maxes = resumo_col_maxes(linhas, colunas) %>
<% total_periodo = header_linha ? resumo_soma_periodo(header_linha, colunas) : 0.to_d %>
<% icon_path = accent_key == "emerald" ? "M4.5 15.75l7.5-7.5 7.5 7.5" : "M19.5 8.25l-7.5 7.5-7.5-7.5" %>

<% if linhas.blank? %>
  <tr class="border-b border-slate-100">
    <td colspan="<%= 5 + colunas.size %>" class="px-4 py-6 text-center text-xs text-slate-500"><%= empty_message || "Nenhuma conta no período." %></td>
  </tr>
<% else %>
  <tr class="border-y-2 border-slate-200/90 <%= theme[:header] %>">
    <td class="sticky left-0 z-20 px-2 py-2.5 shadow-[4px_0_12px_-4px_rgba(15,23,42,0.06)] sm:px-3 <%= theme[:header] %>">
      <div class="flex items-center gap-2">
        <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-lg <%= theme[:icon_wrap] %>">
          <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="<%= icon_path %>"/></svg>
        </span>
        <div>
          <p class="text-xs font-bold uppercase tracking-wide <%= theme[:title] %>"><%= title %></p>
          <p class="text-[9px] font-normal normal-case tracking-normal text-slate-500"><%= linhas.count { |l| l.tipo == :conta && !l.plano_conta&.sintetica? } %> conta(s) analítica(s)</p>
        </div>
      </div>
    </td>
    <td class="px-1 py-2.5 <%= theme[:header] %>"></td>
    <td class="hidden px-1 py-2.5 sm:table-cell <%= theme[:header] %>"></td>
    <td class="px-2 py-2.5 text-right tabular-nums text-[11px] font-black text-slate-900 <%= theme[:header] %>"><%= formatar_moeda(total_periodo) %></td>
    <td class="px-2 py-2.5 text-right text-[10px] font-bold text-slate-500 <%= theme[:header] %>">100%</td>
    <% colunas.each do |col| %>
      <% v = header_linha&.valores&.dig(col.key).to_d %>
      <td class="px-2 py-2.5 text-right tabular-nums text-[11px] font-bold text-slate-900 <%= theme[:header] %> <%= col.referencia ? theme[:col_ref] : '' %>">
        <%= v.zero? ? tag.span("—", class: "font-normal text-slate-400") : formatar_moeda(v) %>
      </td>
    <% end %>
  </tr>

  <% linhas.each_with_index do |linha, row_idx| %>
    <% next unless linha.tipo == :conta %>
    <% sum_periodo = resumo_soma_periodo(linha, colunas) %>
    <% part_pct = resumo_participacao_pct(sum_periodo, total_periodo) %>
    <% sintetica = linha.plano_conta&.sintetica? %>
    <tr class="border-b border-slate-100/90 transition-colors hover:bg-slate-50/90 <%= sintetica ? 'bg-slate-50/70 font-semibold' : (row_idx.even? ? 'bg-white' : 'bg-slate-50/35') %>">
      <td class="sticky left-0 z-10 px-2 py-2 shadow-[2px_0_8px_-2px_rgba(15,23,42,0.08)] sm:px-3 <%= sintetica ? 'bg-slate-50/90' : (row_idx.even? ? 'bg-white' : 'bg-slate-50/80') %>">
        <div class="flex items-start gap-2" style="padding-left: <%= linha.nivel * 0.65 %>rem">
          <% if linha.plano_conta %>
            <span class="mt-0.5 shrink-0 rounded-md bg-slate-100 px-1.5 py-0.5 font-mono text-[10px] font-semibold text-slate-600 ring-1 ring-slate-200/80"><%= linha.plano_conta.codigo %></span>
          <% end %>
          <span class="min-w-0 font-medium leading-snug text-slate-800"><%= linha.nome %></span>
        </div>
      </td>
      <td class="px-1 py-2 text-center align-middle">
        <%= sintetica ? "" : resumo_tendencia_mark(resumo_tendencia_linha(linha, colunas)) %>
      </td>
      <td class="hidden px-1 py-2 text-center align-middle sm:table-cell">
        <%= sintetica ? "" : resumo_sparkline_bars(linha, colunas, accent_key) %>
      </td>
      <td class="relative px-2 py-2 text-right tabular-nums">
        <% if sum_periodo.zero? %>
          <span class="text-slate-300">—</span>
        <% else %>
          <%= resumo_intensidade_bar(sum_periodo, col_maxes[:periodo], accent_key) %>
          <span class="relative z-[1] font-semibold text-slate-900"><%= formatar_moeda(sum_periodo) %></span>
        <% end %>
      </td>
      <td class="px-2 py-2 text-right">
        <% if part_pct && !sintetica %>
          <span class="inline-flex min-w-[2.75rem] justify-end rounded-full bg-slate-100 px-2 py-0.5 text-[10px] font-bold tabular-nums text-slate-600 ring-1 ring-slate-200/70"><%= number_with_precision(part_pct, precision: 1, separator: ",") %>%</span>
        <% else %>
          <span class="text-slate-300">—</span>
        <% end %>
      </td>
      <% colunas.each do |col| %>
        <%= resumo_celula_valor(linha.valores[col.key], col_maxes[col.key], accent_key, ref_column: col.referencia) %>
      <% end %>
    </tr>
  <% end %>
<% end %>
