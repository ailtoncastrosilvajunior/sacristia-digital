<%# locals: ano_foco, periodos, totais_ano, chart_config, periodo_ref, anos_disponiveis, mes, ano %>
<% ref = periodo_ref %>

<div class="space-y-4 sm:space-y-5 w-full">
  <div class="rounded-2xl border border-slate-200/90 bg-white shadow-sm ring-1 ring-slate-100 px-4 py-4 sm:px-5 flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4">
    <div class="min-w-0">
      <p class="text-[10px] font-bold uppercase tracking-[0.18em] text-sky-700">Visão mensal</p>
      <h2 class="text-xl sm:text-2xl font-bold text-slate-900 tracking-tight mt-0.5">Demonstrativo <%= ano_foco %></h2>
      <p class="text-sm text-slate-500 mt-1">Saldo anterior, entradas, saídas e saldo final — conferência via extrato</p>
    </div>
    <%= form_with url: admin_financeiro_resumo_path, method: :get, local: true, class: "flex flex-wrap items-end gap-2 shrink-0" do %>
      <%= hidden_field_tag :aba, "periodos" %>
      <%= hidden_field_tag :mes, mes %>
      <%= hidden_field_tag :ano, ano %>
      <div>
        <label for="ano_foco_select" class="block text-[10px] font-bold uppercase tracking-wider text-slate-500 mb-1">Ano</label>
        <%= select_tag :ano_foco,
              options_for_select(anos_disponiveis.map { |a| [a, a] }, ano_foco),
              id: "ano_foco_select",
              class: "rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm font-semibold text-slate-800 shadow-sm focus:outline-none focus:ring-2 focus:ring-sky-500/30 min-w-[6.75rem] tabular-nums" %>
      </div>
      <button type="submit" class="inline-flex items-center gap-1.5 px-3 py-2 text-sm font-semibold rounded-lg bg-slate-800 text-white hover:bg-slate-900 transition-colors">
        Aplicar
      </button>
      <% if ref %>
        <%= link_to admin_extrato_financeiro_path(mes: ref.mes, ano: ref.ano),
              class: "inline-flex items-center gap-1.5 px-3 py-2 text-sm font-semibold rounded-lg border border-sky-200 bg-sky-50 text-sky-900 hover:bg-sky-100 transition-colors" do %>
          Extrato · <%= ref.label %>
        <% end %>
      <% end %>
    <% end %>
  </div>

  <% if ref %>
    <%= render "admin/shared/financeiro/metric_strip", items: [
          { label: "Saldo anterior", value: formatar_moeda(ref.saldo_anterior), tone: :slate, sublabel: ref.label, value_class: moeda_resumo_classe(ref.saldo_anterior) },
          { label: "Entradas", value: formatar_moeda(ref.entradas), tone: :emerald, sublabel: "Mês ref." },
          { label: "Saídas", value: formatar_moeda(ref.saidas), tone: :red, sublabel: "Mês ref." },
          { label: "Saldo final", value: formatar_moeda(ref.saldo_final), tone: :indigo, sublabel: ref.label, value_class: moeda_resumo_classe(ref.saldo_final) }
        ] %>
  <% end %>

  <div class="grid grid-cols-1 xl:grid-cols-3 gap-4 sm:gap-5">
    <div class="xl:col-span-2 rounded-2xl border border-slate-200/90 bg-white shadow-md shadow-slate-900/5 ring-1 ring-slate-100 overflow-hidden">
      <div class="px-4 sm:px-5 py-3 border-b border-slate-100 bg-gradient-to-r from-slate-900 via-slate-800 to-slate-900 text-white">
        <p class="text-[10px] font-bold uppercase tracking-wider text-sky-300/90">Evolução no ano</p>
        <h3 class="text-base font-bold mt-0.5">Entradas, saídas e saldo mensal</h3>
      </div>
      <div class="p-3 sm:p-4">
        <%= tag.div class: "relative w-full h-64 sm:h-72",
              data: {
                controller: "financeiro-evolucao-chart",
                financeiro_evolucao_chart_config_value: chart_config
              } do %>
          <canvas data-financeiro-evolucao-chart-target="canvas" class="absolute inset-0 w-full h-full" role="img" aria-label="Gráfico de evolução financeira"></canvas>
        <% end %>
      </div>
    </div>

    <div class="rounded-2xl border border-slate-200/90 bg-white p-4 sm:p-5 shadow-md shadow-slate-900/5 ring-1 ring-slate-100 h-fit">
      <p class="text-[10px] font-bold uppercase tracking-wider text-slate-500">Consolidado <%= ano_foco %></p>
      <dl class="mt-3 space-y-3 text-sm">
        <div class="flex justify-between gap-3 py-2 border-b border-slate-100">
          <dt class="text-slate-600">Entradas</dt>
          <dd class="font-bold tabular-nums text-emerald-700"><%= formatar_moeda(totais_ano[:entradas]) %></dd>
        </div>
        <div class="flex justify-between gap-3 py-2 border-b border-slate-100">
          <dt class="text-slate-600">Saídas</dt>
          <dd class="font-bold tabular-nums text-red-700"><%= formatar_moeda(totais_ano[:saidas]) %></dd>
        </div>
        <div class="flex justify-between gap-3 pt-1">
          <dt class="font-semibold text-slate-800">Saldo final</dt>
          <dd class="font-black tabular-nums text-base <%= moeda_resumo_classe(totais_ano[:saldo_final]) %>"><%= formatar_moeda(totais_ano[:saldo_final]) %></dd>
        </div>
      </dl>
    </div>
  </div>

  <div class="rounded-2xl border border-slate-200/90 bg-white shadow-md shadow-slate-900/5 overflow-hidden ring-1 ring-slate-100">
    <div class="px-4 py-3 border-b border-slate-100 bg-slate-50/80">
      <h3 class="text-sm font-bold text-slate-800">Meses do ano</h3>
    </div>
    <div class="overflow-x-auto">
      <table class="w-full min-w-[40rem] text-sm">
        <thead>
          <tr class="text-[10px] font-bold uppercase tracking-wider border-b border-slate-200">
            <th class="px-4 py-2.5 text-left bg-slate-100 text-slate-600">Período</th>
            <th class="px-4 py-2.5 text-right bg-slate-50 text-slate-600">Saldo ant.</th>
            <th class="px-4 py-2.5 text-right bg-emerald-50/80 text-emerald-900">Entradas</th>
            <th class="px-4 py-2.5 text-right bg-rose-50/80 text-rose-900">Saídas</th>
            <th class="px-4 py-2.5 text-right bg-indigo-50/80 text-indigo-950">Saldo final</th>
            <th class="px-3 py-2.5 w-28 bg-white"></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          <% periodos.each do |p| %>
            <% destaque = p.ano == ano && p.mes == mes && !p.futuro %>
            <tr class="<%= destaque ? 'bg-sky-50/80' : 'hover:bg-slate-50/70' %> <%= p.futuro ? 'opacity-45' : '' %>">
              <td class="px-4 py-2 font-semibold tabular-nums text-slate-800">
                <%= p.label %>
                <% if destaque %><span class="ml-1.5 text-[10px] font-bold text-sky-700 uppercase">Ref.</span><% end %>
              </td>
              <td class="px-4 py-2 text-right tabular-nums text-sm <%= moeda_resumo_classe(p.saldo_anterior) %>"><%= formatar_moeda(p.saldo_anterior) %></td>
              <td class="px-4 py-2 text-right tabular-nums text-sm font-medium text-emerald-800"><%= p.futuro && p.entradas.zero? ? "—" : formatar_moeda(p.entradas) %></td>
              <td class="px-4 py-2 text-right tabular-nums text-sm font-medium text-red-800"><%= p.futuro && p.saidas.zero? ? "—" : formatar_moeda(p.saidas) %></td>
              <td class="px-4 py-2 text-right tabular-nums text-sm font-bold <%= moeda_resumo_classe(p.saldo_final) %>"><%= formatar_moeda(p.saldo_final) %></td>
              <td class="px-3 py-2 text-center">
                <% unless p.futuro %>
                  <%= link_to "Extrato", admin_extrato_financeiro_path(mes: p.mes, ano: p.ano),
                        class: "inline-flex items-center justify-center px-2.5 py-1 rounded-lg text-xs font-semibold text-sky-800 bg-sky-50 ring-1 ring-sky-200/80 hover:bg-sky-100" %>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
        <tfoot>
          <tr class="bg-slate-800 text-white text-sm font-bold">
            <td class="px-4 py-2.5">Total</td>
            <td class="px-4 py-2.5 text-right text-slate-400">—</td>
            <td class="px-4 py-2.5 text-right tabular-nums text-emerald-300"><%= formatar_moeda(totais_ano[:entradas]) %></td>
            <td class="px-4 py-2.5 text-right tabular-nums text-rose-300"><%= formatar_moeda(totais_ano[:saidas]) %></td>
            <td class="px-4 py-2.5 text-right tabular-nums text-sky-200"><%= formatar_moeda(totais_ano[:saldo_final]) %></td>
            <td></td>
          </tr>
        </tfoot>
      </table>
    </div>
  </div>
</div>
