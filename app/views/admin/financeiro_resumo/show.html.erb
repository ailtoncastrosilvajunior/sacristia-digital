<% content_for :title, "Resumo gerencial" %>
<%
  extrato_label =
    if @aba == "plano_contas" && @colunas
      @colunas.find(&:referencia)&.label || format("%d/%02d", @ano, @mes)
    elsif @periodo_ref
      @periodo_ref.label
    else
      format("%d/%02d", @ano, @mes)
    end
%>

<div class="space-y-4 sm:space-y-5 w-full">
  <%= render "admin/financeiro_resumo/hero_resumo", aba: @aba, mes: @mes, ano: @ano, extrato_label: extrato_label %>

  <%= render "admin/financeiro_resumo/nav_abas", aba: @aba, mes: @mes, ano: @ano %>

  <% if @aba == "periodos" %>
    <%= render "admin/financeiro_resumo/aba_periodos",
          periodos: @periodos,
          totais_ano: @totais_ano,
          chart_config: @chart_config,
          periodo_ref: @periodo_ref,
          mes: @mes,
          ano: @ano %>
  <% else %>
    <%= render "admin/financeiro_resumo/aba_plano_contas", colunas: @colunas, linhas: @linhas, mes: @mes, ano: @ano %>
  <% end %>
</div>
