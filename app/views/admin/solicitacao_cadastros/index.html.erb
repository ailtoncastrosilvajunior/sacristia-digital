<% content_for :title, "Solicitações de cadastro — Admin" %>

<div class="space-y-6">
  <div>
    <h1 class="text-2xl font-semibold text-stone-800">Solicitações de cadastro</h1>
    <p class="text-stone-500 mt-1">Pré-cadastros enviados pelos ministros, aguardando validação</p>
    <p class="text-xs text-stone-400 mt-1">
      Link para divulgar: <span class="font-mono select-all"><%= novo_pre_cadastro_url %></span>
    </p>
  </div>

  <%= render layout: "admin/shared/list_toolbar", locals: { placeholder: "Buscar por nome, email ou telefone..." } do %>
    <%= filtro_select :status, "Status", [["Pendentes", "pendente"], ["Aprovadas", "aprovada"], ["Rejeitadas", "rejeitada"], ["Todas", "todas"]] %>
  <% end %>

  <%= render layout: "admin/shared/list_frame", locals: { collection: @solicitacoes } do %>
    <% if @solicitacoes.any? %>
      <div class="flex flex-col gap-2 p-3 bg-stone-50">
        <% @solicitacoes.each do |s| %>
          <% badge = { "pendente" => "bg-amber-100 text-amber-800", "aprovada" => "bg-emerald-100 text-emerald-800", "rejeitada" => "bg-stone-100 text-stone-600" }[s.status] %>
          <%= link_to admin_solicitacao_cadastro_path(s), class: "bg-white rounded-lg border border-stone-200 shadow-sm hover:border-slate-300 transition px-3 py-2 flex flex-wrap items-center gap-x-4 gap-y-1" do %>
            <div class="min-w-0 flex-1 sm:w-56">
              <p class="truncate text-sm text-slate-700 font-semibold"><%= s.nome %></p>
              <p class="truncate text-xs text-stone-500"><%= s.nome_completo.presence || s.created_at.strftime("%d/%m/%Y %H:%M") %></p>
            </div>
            <span class="truncate text-xs text-stone-600 sm:w-56"><%= s.email %></span>
            <span class="truncate text-xs text-stone-600"><%= s.telefone.presence || "—" %></span>
            <span class="inline-flex px-2 py-0.5 text-xs font-medium rounded-full <%= badge %>"><%= s.status.capitalize %></span>
          <% end %>
        <% end %>
      </div>
    <% else %>
      <div class="px-6 py-12 text-center text-stone-500">Nenhuma solicitação encontrada.</div>
    <% end %>
  <% end %>
</div>
