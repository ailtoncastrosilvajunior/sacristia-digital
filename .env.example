# Copie para .env (local). Em produção, defina as mesmas chaves no painel do host (ex.: DigitalOcean App Platform).

# Obrigatório em produção — senão o Rails aborta ao subir.
# Gere um valor: bin/rails secret   ou   openssl rand -hex 64
SECRET_KEY_BASE=

RAILS_ENV=development

# Banco: em produção na DigitalOcean, prefira colar a connection string inteira:
# DATABASE_URL=postgresql://doadmin:...@host:25060/defaultdb?sslmode=require
DATABASE_URL=

# Ou variáveis separadas (sem DATABASE_URL):
DATABASE_HOST=
DATABASE_PORT=5432
DATABASE_USERNAME=
DATABASE_PASSWORD=
# Legado (só se ainda usar esse nome no deploy):
# SACRISTIA_DIGITAL_DATABASE_PASSWORD=
# Se DATABASE_URL estiver vazio, o nome do banco em development:
DATABASE_NAME=sacristia_digital_dev

# Opcional: outra URL só para testes (senão usa host/usuário/senha do bloco default + TEST_DATABASE_NAME)
# TEST_DATABASE_URL=

# Produção: require (padrão no database.yml). Se der "dh key too small", veja README (SSL / cluster).
# DATABASE_SSLMODE=require

# URL pública do app (mailer + hosts permitidos; ver config/initializers/allowed_hosts.rb)
APP_HOST=localhost:3000

# Opcional: hosts extras separados por vírgula
# ALLOWED_HOSTS=


# --------------------------------------------
# Bucket S3 - DigitalOcean
# --------------------------------------------
ACTIVE_STORAGE_SERVICE=digitalocean_spaces
DO_SPACES_ACCESS_KEY_ID=zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz
DO_SPACES_SECRET_ACCESS_KEY=zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz
DO_SPACES_BUCKET=volumeajr
DO_SPACES_REGION=sfo3
DO_SPACES_ENDPOINT=https://sfo3.digitaloceanspaces.com
# Região de assinatura do SDK (padrão us-east-1 — não confundir com DO_SPACES_REGION)
# DO_SPACES_SIGNATURE_REGION=us-east-1
